      while ((i < 4)) {
        t <- (BArray32.get64 mac i);
        out <- (BArray32.set64 out i t);
        i <- (i + 1);
      }
      z <- (W64.of_int 0);
      inc <- (144 %/ 8);
      i <- 0;
      while ((i < inc)) {
        ctx <- (BArray144.set64d ctx (8 * i) z);
        i <- (i + 1);
