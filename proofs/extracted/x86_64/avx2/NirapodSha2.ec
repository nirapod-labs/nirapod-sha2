    msg, msglen, ms);
    (inner, buf, total, ms) <@ __hmac_sha512_outer (inner, buf, total, 
    outer, ms);
    (* Erased call to unspill *)
    (out, inner, buf, ms) <@ _sha512___sha512_finalize (out, inner, buf,
    total, ms);
    return (out, ms);
  }
  proc __Sigma0_8x (x:W256.t) : W256.t = {
    var r:W256.t;
    var s:W256.t;
    var t:W256.t;
    r <- (x \vshr32u256 (W128.of_int 2));
    s <- (x \vshl32u256 (W128.of_int 30));
    r <- (r `^` s);
    s <- (x \vshr32u256 (W128.of_int 13));
    t <- (x \vshl32u256 (W128.of_int 19));
    s <- (s `^` t);
    r <- (r `^` s);
    s <- (x \vshr32u256 (W128.of_int 22));
    t <- (x \vshl32u256 (W128.of_int 10));
    s <- (s `^` t);
    r <- (r `^` s);
    return r;
  }
  proc __Sigma1_8x (x:W256.t) : W256.t = {
    var r:W256.t;
    var s:W256.t;
    var t:W256.t;
    r <- (x \vshr32u256 (W128.of_int 6));
    s <- (x \vshl32u256 (W128.of_int 26));
    r <- (r `^` s);
    s <- (x \vshr32u256 (W128.of_int 11));
    t <- (x \vshl32u256 (W128.of_int 21));
    s <- (s `^` t);
    r <- (r `^` s);
    s <- (x \vshr32u256 (W128.of_int 25));
    t <- (x \vshl32u256 (W128.of_int 7));
    s <- (s `^` t);
    r <- (r `^` s);
    return r;
  }
  proc __sigma0_8x (x:W256.t) : W256.t = {
    var r:W256.t;
    var s:W256.t;
    var t:W256.t;
    r <- (x \vshr32u256 (W128.of_int 7));
    s <- (x \vshl32u256 (W128.of_int 25));
    r <- (r `^` s);
    s <- (x \vshr32u256 (W128.of_int 18));
    t <- (x \vshl32u256 (W128.of_int 14));
    s <- (s `^` t);
    r <- (r `^` s);
    s <- (x \vshr32u256 (W128.of_int 3));
    r <- (r `^` s);
    return r;
  }
  proc __sigma1_8x (x:W256.t) : W256.t = {
    var r:W256.t;
    var s:W256.t;
    var t:W256.t;
    r <- (x \vshr32u256 (W128.of_int 17));
    s <- (x \vshl32u256 (W128.of_int 15));
    r <- (r `^` s);
    s <- (x \vshr32u256 (W128.of_int 19));
    t <- (x \vshl32u256 (W128.of_int 13));
    s <- (s `^` t);
    r <- (r `^` s);
    s <- (x \vshr32u256 (W128.of_int 10));
    r <- (r `^` s);
    return r;
  }
  proc __sha256_x8_round (v:BArray256.t, wk:W256.t, cc:W256.t, t:int) : 
  BArray256.t * W256.t = {
    var y:W256.t;
    var a:int;
    var b:int;
    var d:int;
    var e:int;
    var f:int;
    var g:int;
    var h:int;
    var x:W256.t;
    a <- (((0 + 64) - t) %% 8);
    b <- (((1 + 64) - t) %% 8);
    d <- (((3 + 64) - t) %% 8);
    e <- (((4 + 64) - t) %% 8);
    f <- (((5 + 64) - t) %% 8);
    g <- (((6 + 64) - t) %% 8);
    h <- (((7 + 64) - t) %% 8);
    v <- (BArray256.set256 v h ((BArray256.get256 v h) \vadd32u256 wk));
    x <- ((BArray256.get256 v f) `^` (BArray256.get256 v g));
    x <- (x `&` (BArray256.get256 v e));
    x <- (x `^` (BArray256.get256 v g));
    v <- (BArray256.set256 v h ((BArray256.get256 v h) \vadd32u256 x));
    x <@ __Sigma1_8x ((BArray256.get256 v e));
    v <- (BArray256.set256 v h ((BArray256.get256 v h) \vadd32u256 x));
    v <-
    (BArray256.set256 v d
    ((BArray256.get256 v d) \vadd32u256 (BArray256.get256 v h)));
    x <@ __Sigma0_8x ((BArray256.get256 v a));
    v <- (BArray256.set256 v h ((BArray256.get256 v h) \vadd32u256 x));
    y <- ((BArray256.get256 v a) `^` (BArray256.get256 v b));
    cc <- (cc `&` y);
    cc <- (cc `^` (BArray256.get256 v b));
    v <- (BArray256.set256 v h ((BArray256.get256 v h) \vadd32u256 cc));
    return (v, y);
  }
  proc __sha256_x8_schedule (w:BArray512.t, t:int) : BArray512.t * W256.t = {
    var wt:W256.t;
    var s:W256.t;
    var x:W256.t;
    s <- (BArray512.get256 w ((t - 15) %% 16));
    x <@ __sigma0_8x (s);
    wt <- (x \vadd32u256 (BArray512.get256 w (t %% 16)));
    wt <- (wt \vadd32u256 (BArray512.get256 w ((t - 7) %% 16)));
    s <- (BArray512.get256 w ((t - 2) %% 16));
    x <@ __sigma1_8x (s);
    wt <- (wt \vadd32u256 x);
    w <- (BArray512.set256 w (t %% 16) wt);
    return (w, wt);
  }
  proc _sha256_x8_block (h8:BArray256.t, w:BArray512.t, ms:W64.t) : BArray256.t *
                                                                    BArray512.t *
                                                                    W64.t = {
    var i:int;
    var v:BArray256.t;
    var kp:BArray2048.t;
    var c0:W256.t;
    var t:int;
    var wk:W256.t;
    var c1:W256.t;
    var o:W64.t;
    var more:bool;
    var x:W256.t;
    kp <- witness;
    v <- witness;
    i <- 0;
    while ((i < 8)) {
      v <- (BArray256.set256 v i (BArray256.get256 h8 i));
      i <- (i + 1);
    }
    kp <- sHA256_X8_K;
    c0 <- ((BArray256.get256 v 1) `^` (BArray256.get256 v 2));
    t <- 0;
    while ((t < 16)) {
      wk <- (BArray512.get256 w t);
      wk <- (wk \vadd32u256 (BArray2048.get256 kp t));
      if (((t %% 2) = 0)) {
        (v, c1) <@ __sha256_x8_round (v, wk, c0, t);
      } else {
        (v, c0) <@ __sha256_x8_round (v, wk, c1, t);
      }
      t <- (t + 1);
    }
    o <- (W64.of_int 512);
    more <- (o \ule (W64.of_int 1536));
    while (more) {
      ms <- (update_msf more ms);
      t <- 16;
      while ((t < 32)) {
        (w, wk) <@ __sha256_x8_schedule (w, t);
        wk <-
        (wk \vadd32u256
        (BArray2048.get256d kp
        (W64.to_uint (o + (W64.of_int (32 * (t - 16)))))));
        if (((t %% 2) = 0)) {
          (v, c1) <@ __sha256_x8_round (v, wk, c0, t);
        } else {
          (v, c0) <@ __sha256_x8_round (v, wk, c1, t);
        }
        t <- (t + 1);
      }
      o <- (o + (W64.of_int 512));
      more <- (o \ule (W64.of_int 1536));
    }
    ms <- (update_msf (! more) ms);
    i <- 0;
    while ((i < 8)) {
      x <- (BArray256.get256 h8 i);
      x <- (x \vadd32u256 (BArray256.get256 v i));
      h8 <- (BArray256.set256 h8 i x);
      i <- (i + 1);
    }
    return (h8, w, ms);
  }
  proc __sha256_x8_transpose (r:BArray256.t, mask:W256.t) : BArray256.t = {
    var c:BArray256.t;
    var k:int;
    var t:BArray256.t;
    c <- witness;
    t <- witness;
    k <- 0;
    while ((k < 4)) {
      t <-
      (BArray256.set256 t (2 * k)
      (VPUNPCKL_8u32 (BArray256.get256 r (2 * k))
      (BArray256.get256 r ((2 * k) + 1))));
      t <-
      (BArray256.set256 t ((2 * k) + 1)
      (VPUNPCKH_8u32 (BArray256.get256 r (2 * k))
      (BArray256.get256 r ((2 * k) + 1))));
      k <- (k + 1);
    }
    r <-
    (BArray256.set256 r 0
    (VPUNPCKL_4u64 (BArray256.get256 t 0) (BArray256.get256 t 2)));
    r <-
    (BArray256.set256 r 1
    (VPUNPCKH_4u64 (BArray256.get256 t 0) (BArray256.get256 t 2)));
    r <-
    (BArray256.set256 r 2
    (VPUNPCKL_4u64 (BArray256.get256 t 1) (BArray256.get256 t 3)));
    r <-
    (BArray256.set256 r 3
    (VPUNPCKH_4u64 (BArray256.get256 t 1) (BArray256.get256 t 3)));
    r <-
    (BArray256.set256 r 4
    (VPUNPCKL_4u64 (BArray256.get256 t 4) (BArray256.get256 t 6)));
    r <-
    (BArray256.set256 r 5
    (VPUNPCKH_4u64 (BArray256.get256 t 4) (BArray256.get256 t 6)));
    r <-
    (BArray256.set256 r 6
    (VPUNPCKL_4u64 (BArray256.get256 t 5) (BArray256.get256 t 7)));
    r <-
    (BArray256.set256 r 7
    (VPUNPCKH_4u64 (BArray256.get256 t 5) (BArray256.get256 t 7)));
    k <- 0;
    while ((k < 4)) {
      c <-
      (BArray256.set256 c k
      (VPERM2I128 (BArray256.get256 r k) (BArray256.get256 r (k + 4))
      (W8.of_int 32)));
      c <- (BArray256.set256 c k (VPSHUFB_256 (BArray256.get256 c k) mask));
      c <-
      (BArray256.set256 c (k + 4)
      (VPERM2I128 (BArray256.get256 r k) (BArray256.get256 r (k + 4))
      (W8.of_int 49)));
      c <-
      (BArray256.set256 c (k + 4)
      (VPSHUFB_256 (BArray256.get256 c (k + 4)) mask));
      k <- (k + 1);
    }
    return c;
  }
  proc _sha256_x8_compress (h8:BArray256.t, blocks:BArray512.t, ms:W64.t) : 
  BArray256.t * W64.t = {
    var mask_p:BArray32.t;
    var mask:W256.t;
    var q:int;
    var k:int;
    var r:BArray256.t;
    var w:BArray512.t;
    mask_p <- witness;
    r <- witness;
    w <- witness;
    mask_p <- sHA256_X8_BSWAP;
    mask <- (BArray32.get256 mask_p 0);
    q <- 0;
    while ((q < 2)) {
      k <- 0;
      while ((k < 8)) {
        r <- (BArray256.set256 r k (BArray512.get256 blocks ((2 * k) + q)));
        k <- (k + 1);
      }
      r <@ __sha256_x8_transpose (r, mask);
      k <- 0;
      while ((k < 8)) {
        w <- (BArray512.set256 w ((8 * q) + k) (BArray256.get256 r k));
        k <- (k + 1);
      }
      q <- (q + 1);
    }
    (h8, w, ms) <@ _sha256_x8_block (h8, w, ms);
    return (h8, ms);
  }
  proc _sha256_x8_compress_lanes (h8:BArray256.t, in_0:BArray64.t, off:W64.t,
                                  n:W64.t, ms:W64.t) : BArray256.t * W64.t = {
    var more:bool;
    var p0:W64.t;
    var p1:W64.t;
    var p2:W64.t;
    var p3:W64.t;
    var p4:W64.t;
    var p5:W64.t;
    var p6:W64.t;
    var p7:W64.t;
    var mask_p:BArray32.t;
    var mask:W256.t;
    var q:int;
    var r:BArray256.t;
    var k:int;
    var w:BArray512.t;
    mask_p <- witness;
    r <- witness;
    w <- witness;
    more <- (n <> (W64.of_int 0));
    while (more) {
      ms <- (update_msf more ms);
      p0 <- (BArray64.get64 in_0 0);
      p1 <- (BArray64.get64 in_0 1);
      p2 <- (BArray64.get64 in_0 2);
      p3 <- (BArray64.get64 in_0 3);
      p4 <- (BArray64.get64 in_0 4);
      p5 <- (BArray64.get64 in_0 5);
      p6 <- (BArray64.get64 in_0 6);
      p7 <- (BArray64.get64 in_0 7);
      p0 <- (protect_64 p0 ms);
      p1 <- (protect_64 p1 ms);
      p2 <- (protect_64 p2 ms);
      p3 <- (protect_64 p3 ms);
      p4 <- (protect_64 p4 ms);
      p5 <- (protect_64 p5 ms);
      p6 <- (protect_64 p6 ms);
      p7 <- (protect_64 p7 ms);
      p0 <- (p0 + off);
      p1 <- (p1 + off);
      p2 <- (p2 + off);
      p3 <- (p3 + off);
      p4 <- (p4 + off);
      p5 <- (p5 + off);
      p6 <- (p6 + off);
      p7 <- (p7 + off);
      mask_p <- sHA256_X8_BSWAP;
      mask <- (BArray32.get256 mask_p 0);
      q <- 0;
      while ((q < 2)) {
        r <-
        (BArray256.set256 r 0
        (loadW256 Glob.mem (W64.to_uint (p0 + (W64.of_int (32 * q))))));
        r <-
        (BArray256.set256 r 1
        (loadW256 Glob.mem (W64.to_uint (p1 + (W64.of_int (32 * q))))));
        r <-
        (BArray256.set256 r 2
        (loadW256 Glob.mem (W64.to_uint (p2 + (W64.of_int (32 * q))))));
        r <-
        (BArray256.set256 r 3
        (loadW256 Glob.mem (W64.to_uint (p3 + (W64.of_int (32 * q))))));
        r <-
        (BArray256.set256 r 4
        (loadW256 Glob.mem (W64.to_uint (p4 + (W64.of_int (32 * q))))));
        r <-
        (BArray256.set256 r 5
        (loadW256 Glob.mem (W64.to_uint (p5 + (W64.of_int (32 * q))))));
        r <-
        (BArray256.set256 r 6
        (loadW256 Glob.mem (W64.to_uint (p6 + (W64.of_int (32 * q))))));
        r <-
        (BArray256.set256 r 7
        (loadW256 Glob.mem (W64.to_uint (p7 + (W64.of_int (32 * q))))));
        r <@ __sha256_x8_transpose (r, mask);
        k <- 0;
        while ((k < 8)) {
          w <- (BArray512.set256 w ((8 * q) + k) (BArray256.get256 r k));
          k <- (k + 1);
        }
        q <- (q + 1);
      }
      (* Erased call to spill *)
      (h8, w, ms) <@ _sha256_x8_block (h8, w, ms);
      (* Erased call to unspill *)
      in_0 <- (protect_ptr in_0 ms);
      off <- (protect_64 off ms);
      n <- (protect_64 n ms);
      off <- (off + (W64.of_int 64));
      n <- (n - (W64.of_int 1));
      more <- (n <> (W64.of_int 0));
    }
    ms <- (update_msf (! more) ms);
    return (h8, ms);
  }
  proc __sha256_x8_init (h:BArray256.t) : BArray256.t = {
    var iv:BArray32.t;
    var j:int;
    var t:W32.t;
    var k:int;
    iv <- witness;
    iv <- sHA256_IV;
    j <- 0;
    while ((j < 8)) {
      t <- (BArray32.get32 iv j);
      k <- 0;
      while ((k < 8)) {
        h <- (BArray256.set32 h ((8 * j) + k) t);
        k <- (k + 1);
      }
      j <- (j + 1);
    }
    return h;
  }
  proc __sha256_x8_from (h:BArray256.t, buf:BArray512.t, hs:BArray32.t,
                         bs:BArray64.t) : BArray256.t * BArray512.t = {
    var j:int;
    var x:W32.t;
    var k:int;
    var i:int;
    var t:W64.t;
    j <- 0;
    while ((j < 8)) {
      x <- (BArray32.get32 hs j);
      k <- 0;
      while ((k < 8)) {
        h <- (BArray256.set32 h ((8 * j) + k) x);
        k <- (k + 1);
      }
      j <- (j + 1);
    }
    i <- 0;
    while ((i < 8)) {
      t <- (BArray64.get64 bs i);
      k <- 0;
      while ((k < 8)) {
        buf <- (BArray512.set64d buf ((64 * k) + (8 * i)) t);
        k <- (k + 1);
      }
      i <- (i + 1);
    }
    return (h, buf);
  }
  proc _sha256_x8_absorb_lanes (h:BArray256.t, buf:BArray512.t, total:W64.t,
                                in_0:BArray64.t, inlen:W64.t, ms:W64.t) : 
  BArray256.t * BArray512.t * W64.t * W64.t = {
    var aux:BArray64.t;
    var aux_0:W64.t;
    var fill:W64.t;
    var n:W64.t;
    var k:int;
    var p:W64.t;
    var off:W64.t;
    var full:bool;
    var more:bool;
    fill <- total;
    fill <- (fill `&` (W64.of_int 63));
    total <- (total + inlen);
    n <- (W64.of_int 64);
    n <- (n - fill);
    n <- ((inlen \ult n) ? inlen : n);
    n <- ((fill = (W64.of_int 0)) ? fill : n);
    k <- 0;
    while ((k < 8)) {
      p <- (BArray64.get64 in_0 k);
      p <- (protect_64 p ms);
      (aux, aux_0) <@ __fill64_mem ((SBArray512_64.get_sub8 buf (64 * k)),
      fill, p, n, ms);
      buf <- (SBArray512_64.set_sub8 buf (64 * k) aux);
      ms <- aux_0;
      k <- (k + 1);
    }
    fill <- (fill + n);
    off <- n;
    full <- (fill = (W64.of_int 64));
    if (full) {
      ms <- (update_msf full ms);
      (* Erased call to spill *)
      (h, ms) <@ _sha256_x8_compress (h, buf, ms);
      (* Erased call to unspill *)
      total <- (protect_64 total ms);
      in_0 <- (protect_ptr in_0 ms);
      inlen <- (protect_64 inlen ms);
      off <- (protect_64 off ms);
      buf <- (protect_ptr buf ms);
      fill <- (W64.of_int 0);
    } else {
      ms <- (update_msf (! full) ms);
    }
    n <- inlen;
    n <- (n - off);
    n <- (n `>>` (W8.of_int 6));
    more <- (n <> (W64.of_int 0));
    if (more) {
      ms <- (update_msf more ms);
      (* Erased call to spill *)
      (h, ms) <@ _sha256_x8_compress_lanes (h, in_0, off, n, ms);
      (* Erased call to unspill *)
      total <- (protect_64 total ms);
      in_0 <- (protect_ptr in_0 ms);
      inlen <- (protect_64 inlen ms);
      off <- (protect_64 off ms);
      buf <- (protect_ptr buf ms);
      n <- inlen;
      n <- (n - off);
      n <- (n `>>` (W8.of_int 6));
      n <- (n `<<` (W8.of_int 6));
      off <- (off + n);
      fill <- (W64.of_int 0);
    } else {
      ms <- (update_msf (! more) ms);
    }
    n <- inlen;
    n <- (n - off);
    k <- 0;
    while ((k < 8)) {
      p <- (BArray64.get64 in_0 k);
      p <- (protect_64 p ms);
      p <- (p + off);
      (aux, aux_0) <@ __fill64_mem ((SBArray512_64.get_sub8 buf (64 * k)),
      fill, p, n, ms);
      buf <- (SBArray512_64.set_sub8 buf (64 * k) aux);
      ms <- aux_0;
      k <- (k + 1);
    }
    return (h, buf, total, ms);
  }
  proc _sha256_x8_finalize (out:BArray256.t, h:BArray256.t, buf:BArray512.t,
                            total:W64.t, ms:W64.t) : BArray256.t *
                                                     BArray256.t *
                                                     BArray512.t * W64.t = {
    var aux:BArray64.t;
    var aux_0:W64.t;
    var fill:W64.t;
    var at:W64.t;
    var t:W64.t;
    var k:int;
    var two_blocks:bool;
    var hi:W64.t;
    var j:int;
    var x:W32.t;
    fill <- total;
    fill <- (fill `&` (W64.of_int 63));
    at <- fill;
    t <- (W64.of_int 128);
    k <- 0;
    while ((k < 8)) {
      buf <- (BArray512.set8 buf (W64.to_uint at) (truncateu8 t));
      at <- (at + (W64.of_int 64));
      k <- (k + 1);
    }
    fill <- (fill + (W64.of_int 1));
    two_blocks <- ((W64.of_int 56) \ult fill);
    if (two_blocks) {
      ms <- (update_msf two_blocks ms);
      hi <- (W64.of_int 64);
      k <- 0;
      while ((k < 8)) {
        (aux, aux_0) <@ __zero64 ((SBArray512_64.get_sub8 buf (64 * k)),
        fill, hi, ms);
        buf <- (SBArray512_64.set_sub8 buf (64 * k) aux);
        ms <- aux_0;
        k <- (k + 1);
      }
      (* Erased call to spill *)
      (h, ms) <@ _sha256_x8_compress (h, buf, ms);
      (* Erased call to unspill *)
      out <- (protect_ptr out ms);
      buf <- (protect_ptr buf ms);
      total <- (protect_64 total ms);
      fill <- (W64.of_int 0);
    } else {
      ms <- (update_msf (! two_blocks) ms);
    }
    hi <- (W64.of_int 56);
    k <- 0;
    while ((k < 8)) {
      (aux, aux_0) <@ __zero64 ((SBArray512_64.get_sub8 buf (64 * k)), 
      fill, hi, ms);
      buf <- (SBArray512_64.set_sub8 buf (64 * k) aux);
      ms <- aux_0;
      k <- (k + 1);
    }
    t <- total;
    t <- (t `<<` (W8.of_int 3));
    t <@ __bswap64 (t);
    k <- 0;
    while ((k < 8)) {
      buf <- (BArray512.set64d buf ((64 * k) + 56) t);
      k <- (k + 1);
    }
    (* Erased call to spill *)
    (h, ms) <@ _sha256_x8_compress (h, buf, ms);
    (* Erased call to unspill *)
    out <- (protect_ptr out ms);
    buf <- (protect_ptr buf ms);
    k <- 0;
    while ((k < 8)) {
      j <- 0;
      while ((j < 8)) {
        x <- (BArray256.get32 h ((8 * j) + k));
        x <@ __bswap32 (x);
        out <- (BArray256.set32 out ((8 * k) + j) x);
        j <- (j + 1);
      }
      k <- (k + 1);
    }
    return (out, h, buf, ms);
  }
  proc _sha256_x8_lanes (out:BArray256.t, in_0:BArray64.t, len:W64.t,
                         ms:W64.t) : BArray256.t * W64.t = {
    var h:BArray256.t;
    var buf_s:BArray512.t;
    var buf:BArray512.t;
    var total:W64.t;
    buf <- witness;
    buf_s <- witness;
    h <- witness;
    h <@ __sha256_x8_init (h);
    buf <- buf_s;
    total <- (W64.of_int 0);
    (* Erased call to spill *)
    (h, buf, total, ms) <@ _sha256_x8_absorb_lanes (h, buf, total, in_0, 
    len, ms);
    (* Erased call to unspill *)
    out <- (protect_ptr out ms);
    (out, h, buf, ms) <@ _sha256_x8_finalize (out, h, buf, total, ms);
    return (out, ms);
  }
  proc __Sigma0_4x (x:W256.t) : W256.t = {
    var r:W256.t;
    var s:W256.t;
    var t:W256.t;
    r <- (x \vshr64u256 (W128.of_int 28));
    s <- (x \vshl64u256 (W128.of_int 36));
    r <- (r `^` s);
    s <- (x \vshr64u256 (W128.of_int 34));
    t <- (x \vshl64u256 (W128.of_int 30));
    s <- (s `^` t);
    r <- (r `^` s);
    s <- (x \vshr64u256 (W128.of_int 39));
    t <- (x \vshl64u256 (W128.of_int 25));
    s <- (s `^` t);
    r <- (r `^` s);
    return r;
  }
  proc __Sigma1_4x (x:W256.t) : W256.t = {
    var r:W256.t;
    var s:W256.t;
    var t:W256.t;
    r <- (x \vshr64u256 (W128.of_int 14));
    s <- (x \vshl64u256 (W128.of_int 50));
    r <- (r `^` s);
    s <- (x \vshr64u256 (W128.of_int 18));
    t <- (x \vshl64u256 (W128.of_int 46));
    s <- (s `^` t);
    r <- (r `^` s);
    s <- (x \vshr64u256 (W128.of_int 41));
    t <- (x \vshl64u256 (W128.of_int 23));
    s <- (s `^` t);
    r <- (r `^` s);
    return r;
  }
  proc __sigma0_4x (x:W256.t, ror8:W256.t) : W256.t = {
    var r:W256.t;
    var s:W256.t;
    r <- (x \vshr64u256 (W128.of_int 1));
    s <- (x \vshl64u256 (W128.of_int 63));
    r <- (r `^` s);
    s <- (VPSHUFB_256 x ror8);
    r <- (r `^` s);
    s <- (x \vshr64u256 (W128.of_int 7));
    r <- (r `^` s);
    return r;
  }
  proc __sigma1_4x (x:W256.t) : W256.t = {
    var r:W256.t;
    var s:W256.t;
    var t:W256.t;
    r <- (x \vshr64u256 (W128.of_int 19));
    s <- (x \vshl64u256 (W128.of_int 45));
    r <- (r `^` s);
    s <- (x \vshr64u256 (W128.of_int 61));
    t <- (x \vshl64u256 (W128.of_int 3));
    s <- (s `^` t);
    r <- (r `^` s);
    s <- (x \vshr64u256 (W128.of_int 6));
    r <- (r `^` s);
    return r;
  }
  proc __sha512_x4_round (v:BArray256.t, wk:W256.t, cc:W256.t, t:int) : 
  BArray256.t * W256.t = {
    var y:W256.t;
    var a:int;
    var b:int;
    var d:int;
    var e:int;
    var f:int;
    var g:int;
    var h:int;
    var x:W256.t;
    a <- (((0 + 80) - t) %% 8);
    b <- (((1 + 80) - t) %% 8);
    d <- (((3 + 80) - t) %% 8);
    e <- (((4 + 80) - t) %% 8);
    f <- (((5 + 80) - t) %% 8);
    g <- (((6 + 80) - t) %% 8);
    h <- (((7 + 80) - t) %% 8);
    v <- (BArray256.set256 v h ((BArray256.get256 v h) \vadd64u256 wk));
    x <- ((BArray256.get256 v f) `^` (BArray256.get256 v g));
    x <- (x `&` (BArray256.get256 v e));
    x <- (x `^` (BArray256.get256 v g));
    v <- (BArray256.set256 v h ((BArray256.get256 v h) \vadd64u256 x));
    x <@ __Sigma1_4x ((BArray256.get256 v e));
    v <- (BArray256.set256 v h ((BArray256.get256 v h) \vadd64u256 x));
    v <-
    (BArray256.set256 v d
    ((BArray256.get256 v d) \vadd64u256 (BArray256.get256 v h)));
    x <@ __Sigma0_4x ((BArray256.get256 v a));
    v <- (BArray256.set256 v h ((BArray256.get256 v h) \vadd64u256 x));
    y <- ((BArray256.get256 v a) `^` (BArray256.get256 v b));
    cc <- (cc `&` y);
    cc <- (cc `^` (BArray256.get256 v b));
    v <- (BArray256.set256 v h ((BArray256.get256 v h) \vadd64u256 cc));
    return (v, y);
  }
  proc __sha512_x4_schedule (w:BArray512.t, t:int, ror8:W256.t) : BArray512.t *
                                                                  W256.t = {
    var wt:W256.t;
    var s:W256.t;
    var x:W256.t;
    s <- (BArray512.get256 w ((t - 15) %% 16));
    x <@ __sigma0_4x (s, ror8);
    wt <- (x \vadd64u256 (BArray512.get256 w (t %% 16)));
    wt <- (wt \vadd64u256 (BArray512.get256 w ((t - 7) %% 16)));
    s <- (BArray512.get256 w ((t - 2) %% 16));
    x <@ __sigma1_4x (s);
    wt <- (wt \vadd64u256 x);
    w <- (BArray512.set256 w (t %% 16) wt);
    return (w, wt);
  }
  proc _sha512_x4_block (h4:BArray256.t, w:BArray512.t, ms:W64.t) : BArray256.t *
                                                                    BArray512.t *
                                                                    W64.t = {
    var i:int;
    var v:BArray256.t;
    var kp:BArray2560.t;
    var mp:BArray32.t;
    var ror8:W256.t;
    var c0:W256.t;
    var t:int;
    var wk:W256.t;
    var c1:W256.t;
    var o:W64.t;
    var more:bool;
    var x:W256.t;
    kp <- witness;
    mp <- witness;
    v <- witness;
    i <- 0;
    while ((i < 8)) {
      v <- (BArray256.set256 v i (BArray256.get256 h4 i));
      i <- (i + 1);
    }
    kp <- sHA512_X4_K;
    mp <- sHA512_X4_ROR8;
    ror8 <- (BArray32.get256 mp 0);
    c0 <- ((BArray256.get256 v 1) `^` (BArray256.get256 v 2));
    t <- 0;
    while ((t < 16)) {
      wk <- (BArray512.get256 w t);
      wk <- (wk \vadd64u256 (BArray2560.get256 kp t));
      if (((t %% 2) = 0)) {
        (v, c1) <@ __sha512_x4_round (v, wk, c0, t);
      } else {
        (v, c0) <@ __sha512_x4_round (v, wk, c1, t);
      }
      t <- (t + 1);
    }
    o <- (W64.of_int 512);
    more <- (o \ule (W64.of_int 2048));
    while (more) {
      ms <- (update_msf more ms);
      t <- 16;
      while ((t < 32)) {
        (w, wk) <@ __sha512_x4_schedule (w, t, ror8);
        wk <-
        (wk \vadd64u256
        (BArray2560.get256d kp
        (W64.to_uint (o + (W64.of_int (32 * (t - 16)))))));
        if (((t %% 2) = 0)) {
          (v, c1) <@ __sha512_x4_round (v, wk, c0, t);
        } else {
          (v, c0) <@ __sha512_x4_round (v, wk, c1, t);
        }
        t <- (t + 1);
      }
      o <- (o + (W64.of_int 512));
      more <- (o \ule (W64.of_int 2048));
    }
    ms <- (update_msf (! more) ms);
    i <- 0;
    while ((i < 8)) {
      x <- (BArray256.get256 h4 i);
      x <- (x \vadd64u256 (BArray256.get256 v i));
      h4 <- (BArray256.set256 h4 i x);
      i <- (i + 1);
    }
    return (h4, w, ms);
  }
  proc __sha512_x4_transpose (r0:W256.t, r1:W256.t, r2:W256.t, r3:W256.t,
                              mask:W256.t) : W256.t * W256.t * W256.t *
                                             W256.t = {
    var c0:W256.t;
    var c1:W256.t;
    var c2:W256.t;
    var c3:W256.t;
    var t0:W256.t;
    var t1:W256.t;
    var t2:W256.t;
    var t3:W256.t;
    t0 <- (VPUNPCKL_4u64 r0 r1);
    t1 <- (VPUNPCKH_4u64 r0 r1);
    t2 <- (VPUNPCKL_4u64 r2 r3);
    t3 <- (VPUNPCKH_4u64 r2 r3);
    c0 <- (VPERM2I128 t0 t2 (W8.of_int 32));
    c0 <- (VPSHUFB_256 c0 mask);
    c1 <- (VPERM2I128 t1 t3 (W8.of_int 32));
    c1 <- (VPSHUFB_256 c1 mask);
    c2 <- (VPERM2I128 t0 t2 (W8.of_int 49));
    c2 <- (VPSHUFB_256 c2 mask);
    c3 <- (VPERM2I128 t1 t3 (W8.of_int 49));
    c3 <- (VPSHUFB_256 c3 mask);
    return (c0, c1, c2, c3);
  }
  proc _sha512_x4_compress (h4:BArray256.t, blocks:BArray512.t, ms:W64.t) : 
  BArray256.t * W64.t = {
    var mask_p:BArray32.t;
    var mask:W256.t;
    var q:int;
    var r0:W256.t;
    var r1:W256.t;
    var r2:W256.t;
    var r3:W256.t;
    var w:BArray512.t;
    mask_p <- witness;
    w <- witness;
    mask_p <- sHA512_X4_BSWAP;
    mask <- (BArray32.get256 mask_p 0);
    q <- 0;
    while ((q < 4)) {
      r0 <- (BArray512.get256 blocks q);
      r1 <- (BArray512.get256 blocks (4 + q));
      r2 <- (BArray512.get256 blocks (8 + q));
      r3 <- (BArray512.get256 blocks (12 + q));
      (r0, r1, r2, r3) <@ __sha512_x4_transpose (r0, r1, r2, r3, mask);
      w <- (BArray512.set256 w (4 * q) r0);
      w <- (BArray512.set256 w ((4 * q) + 1) r1);
      w <- (BArray512.set256 w ((4 * q) + 2) r2);
      w <- (BArray512.set256 w ((4 * q) + 3) r3);
      q <- (q + 1);
    }
    (h4, w, ms) <@ _sha512_x4_block (h4, w, ms);
    return (h4, ms);
  }
  proc _sha512_x4_compress_lanes (h4:BArray256.t, in_0:BArray32.t, off:W64.t,
                                  n:W64.t, ms:W64.t) : BArray256.t * W64.t = {
    var more:bool;
    var p0:W64.t;
    var p1:W64.t;
    var p2:W64.t;
    var p3:W64.t;
    var mask_p:BArray32.t;
    var mask:W256.t;
    var q:int;
    var r0:W256.t;
    var r1:W256.t;
    var r2:W256.t;
    var r3:W256.t;
    var w:BArray512.t;
    mask_p <- witness;
    w <- witness;
    more <- (n <> (W64.of_int 0));
    while (more) {
      ms <- (update_msf more ms);
      p0 <- (BArray32.get64 in_0 0);
      p1 <- (BArray32.get64 in_0 1);
      p2 <- (BArray32.get64 in_0 2);
      p3 <- (BArray32.get64 in_0 3);
      p0 <- (protect_64 p0 ms);
      p1 <- (protect_64 p1 ms);
      p2 <- (protect_64 p2 ms);
      p3 <- (protect_64 p3 ms);
      p0 <- (p0 + off);
      p1 <- (p1 + off);
      p2 <- (p2 + off);
      p3 <- (p3 + off);
      mask_p <- sHA512_X4_BSWAP;
      mask <- (BArray32.get256 mask_p 0);
      q <- 0;
      while ((q < 4)) {
        r0 <- (loadW256 Glob.mem (W64.to_uint (p0 + (W64.of_int (32 * q)))));
        r1 <- (loadW256 Glob.mem (W64.to_uint (p1 + (W64.of_int (32 * q)))));
        r2 <- (loadW256 Glob.mem (W64.to_uint (p2 + (W64.of_int (32 * q)))));
        r3 <- (loadW256 Glob.mem (W64.to_uint (p3 + (W64.of_int (32 * q)))));
        (r0, r1, r2, r3) <@ __sha512_x4_transpose (r0, r1, r2, r3, mask);
        w <- (BArray512.set256 w (4 * q) r0);
        w <- (BArray512.set256 w ((4 * q) + 1) r1);
        w <- (BArray512.set256 w ((4 * q) + 2) r2);
        w <- (BArray512.set256 w ((4 * q) + 3) r3);
        q <- (q + 1);
      }
      (* Erased call to spill *)
      (h4, w, ms) <@ _sha512_x4_block (h4, w, ms);
      (* Erased call to unspill *)
      in_0 <- (protect_ptr in_0 ms);
      off <- (protect_64 off ms);
      n <- (protect_64 n ms);
      off <- (off + (W64.of_int 128));
      n <- (n - (W64.of_int 1));
      more <- (n <> (W64.of_int 0));
    }
    ms <- (update_msf (! more) ms);
    return (h4, ms);
  }
  proc __sha512_x4_init (h:BArray256.t) : BArray256.t = {
    var iv:BArray64.t;
    var j:int;
    var t:W64.t;
    var k:int;
    iv <- witness;
    iv <- sHA512_IV;
    j <- 0;
    while ((j < 8)) {
      t <- (BArray64.get64 iv j);
      k <- 0;
      while ((k < 4)) {
        h <- (BArray256.set64 h ((4 * j) + k) t);
        k <- (k + 1);
      }
      j <- (j + 1);
    }
    return h;
  }
  proc __sha512_x4_from (h:BArray256.t, buf:BArray512.t, hs:BArray64.t,
                         bs:BArray128.t) : BArray256.t * BArray512.t = {
    var j:int;
    var x:W64.t;
    var k:int;
    var i:int;
    var t:W64.t;
    j <- 0;
    while ((j < 8)) {
      x <- (BArray64.get64 hs j);
      k <- 0;
      while ((k < 4)) {
        h <- (BArray256.set64 h ((4 * j) + k) x);
        k <- (k + 1);
      }
      j <- (j + 1);
    }
    i <- 0;
    while ((i < 16)) {
      t <- (BArray128.get64 bs i);
      k <- 0;
      while ((k < 4)) {
        buf <- (BArray512.set64d buf ((128 * k) + (8 * i)) t);
        k <- (k + 1);
      }
      i <- (i + 1);
    }
    return (h, buf);
  }
  proc _sha512_x4_absorb_lanes (h:BArray256.t, buf:BArray512.t, total:W64.t,
                                in_0:BArray32.t, inlen:W64.t, ms:W64.t) : 
  BArray256.t * BArray512.t * W64.t * W64.t = {
    var aux:BArray128.t;
    var aux_0:W64.t;
    var fill:W64.t;
    var n:W64.t;
    var k:int;
    var p:W64.t;
    var off:W64.t;
    var full:bool;
    var more:bool;
    fill <- total;
    fill <- (fill `&` (W64.of_int 127));
    total <- (total + inlen);
    n <- (W64.of_int 128);
    n <- (n - fill);
    n <- ((inlen \ult n) ? inlen : n);
    n <- ((fill = (W64.of_int 0)) ? fill : n);
    k <- 0;
    while ((k < 4)) {
      p <- (BArray32.get64 in_0 k);
      p <- (protect_64 p ms);
      (aux, aux_0) <@ __fill128_mem ((SBArray512_128.get_sub8 buf (128 * k)),
      fill, p, n, ms);
      buf <- (SBArray512_128.set_sub8 buf (128 * k) aux);
      ms <- aux_0;
      k <- (k + 1);
    }
    fill <- (fill + n);
    off <- n;
    full <- (fill = (W64.of_int 128));
    if (full) {
      ms <- (update_msf full ms);
      (* Erased call to spill *)
      (h, ms) <@ _sha512_x4_compress (h, buf, ms);
      (* Erased call to unspill *)
      total <- (protect_64 total ms);
      in_0 <- (protect_ptr in_0 ms);
      inlen <- (protect_64 inlen ms);
      off <- (protect_64 off ms);
      buf <- (protect_ptr buf ms);
      fill <- (W64.of_int 0);
    } else {
      ms <- (update_msf (! full) ms);
    }
    n <- inlen;
    n <- (n - off);
