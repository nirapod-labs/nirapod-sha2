  proc _hmac_sha256_mem (out:BArray32.t, key:W64.t, keylen:W64.t, msg:W64.t,
                         msglen:W64.t, ms:W64.t) : BArray32.t * W64.t = {
    var k0:BArray64.t;
    var inner:BArray32.t;
    var outer:BArray32.t;
    var total:W64.t;
    var buf:BArray64.t;
    buf <- witness;
    inner <- witness;
    k0 <- witness;
    outer <- witness;
