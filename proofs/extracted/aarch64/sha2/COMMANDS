# The models of unit aarch64-sha2, extracted from the repository root by
# `make extract`. The entry requires src/nirapod_sha2.jinc
# through the Hash root, with no namespace.
jasmin2ec --arch=armv8a -I Hash=src -I HashWord=src/aarch64 -I Sha256Kernel=src/aarch64/sha2 -I Sha512Kernel=src/aarch64/sha2 -I Sha256KernelX=src/aarch64/sha2 -I Sha512KernelX=src/aarch64/sha2 -o aarch64/sha2/NirapodSha2.ec build/extract/nirapod_sha2.jazz
jasmin2ec --arch=armv8a -m safety -I Hash=src -I HashWord=src/aarch64 -I Sha256Kernel=src/aarch64/sha2 -I Sha512Kernel=src/aarch64/sha2 -I Sha256KernelX=src/aarch64/sha2 -I Sha512KernelX=src/aarch64/sha2 -o aarch64/sha2/NirapodSha2Safety.ec build/extract/nirapod_sha2.jazz
