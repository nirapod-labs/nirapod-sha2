+  (* -------------------------------------------------------------------- *)
+  (* The total mode: no alignment check, and the partial mode is the total one
+     under its guard. *)
+
+  Lemma readE_total m al p sz :
+    read (sm := total) m al p sz =
+      Let l := mapM (fun k => get (sm := total) m (add p k)) (ziota 0 (wsize_size sz)) in
+      ok (LE.decode sz l).
+  Proof. by []. Qed.
+
+  Lemma writeE_total m al p sz (w : word sz) :
+    write (sm := total) m al p w =
+      foldM (fun k m => set (sm := total) m (add p k) (nth 0%w (LE.encode w) (Z.to_nat k)))
+        m (ziota 0 (wsize_size sz)).
+  Proof. by []. Qed.
+
+  Lemma read_totalE m al p sz w :
+    read (sm := partial) m al p sz = ok w -> read (sm := total) m al p sz = ok w.
+  Proof.
+    rewrite readE_total /read or_is_total_partial; t_xrbindP => _ l hl <-.
+    by rewrite (mapM_factorization (fun _ _ h => get_totalE h) hl) (mapM_ok id) map_id.
+  Qed.
+
+  Lemma validrP m al p sz :
+    reflect (exists w, read (sm := partial) m al p sz = ok w) (validr m al p sz).
+  Proof.
+    rewrite /read /validr or_is_total_partial -is_ok_mapM.
+    case: is_aligned_if; last by constructor => -[].
+    case: mapM => [l | e]; first by constructor; eexists.
+    by constructor => -[].
+  Qed.
+
+  Lemma read_partialE m al p sz w :
+    read (sm := partial) m al p sz = ok w <->
+    validr m al p sz /\ read (sm := total) m al p sz = ok w.
+  Proof.
+    split.
+    + by move=> h; split; [apply/validrP; exists w | apply: read_totalE].
+    move=> [] /validrP [w1 hw1] ht.
+    by move: ht; rewrite (read_totalE hw1) => -[<-].
+  Qed.
+
+  Lemma write_totalE m al p sz (w : word sz) m' :
+    write (sm := partial) m al p w = ok m' -> write (sm := total) m al p w = ok m'.
+  Proof.
+    rewrite writeE_total /write or_is_total_partial.
+    t_xrbindP => _; move: m; apply ziota_ind => /= [m [<-] // | i l _ hrec m].
+    t_xrbindP => m1 hs hf.
+    by rewrite (set_totalE hs) /=; apply: hrec.
+  Qed.
