index e3b28c5..200e953 100644
--- a/proofs/_CoqProject
+++ b/proofs/_CoqProject
@@ -218,6 +218,7 @@ lang/pseudo_operator.v
 lang/psem_facts.v
 lang/relational_logic.v
 lang/safety_common.v
