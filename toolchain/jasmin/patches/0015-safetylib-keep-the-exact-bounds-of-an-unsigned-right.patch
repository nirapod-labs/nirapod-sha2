diff --git a/compiler/tests/safety/success/common/shiftbound.jazz b/compiler/tests/safety/success/common/shiftbound.jazz
new file mode 100644
index 0000000..560703e
--- /dev/null
+++ b/compiler/tests/safety/success/common/shiftbound.jazz
@@ -0,0 +1,12 @@
+/* The block count is the input length shifted right by 6. The bounds of
+   the shift also give the block count a lower bound, so the end of the
+   last whole block is known to stay within the length. */
+export fn bound(reg u64 inlen) -> reg u64
+{
+  reg u64 n;
+
+  n = inlen;
+  n >>= 6;
+  assert("upper", inlen <= n * 64 + 63);
+  return n;
+}
diff --git a/compiler/tests/safety/success/common/shiftcond.jazz b/compiler/tests/safety/success/common/shiftcond.jazz
new file mode 100644
index 0000000..332a4e4
--- /dev/null
+++ b/compiler/tests/safety/success/common/shiftcond.jazz
@@ -0,0 +1,11 @@
+/* A shifted value that is a conditional expression has no single linear
+   form. The bounds of the shift cannot be stated on it, and the
+   assignment keeps the conditional abstraction instead of failing. */
+export fn cond(reg u64 inlen, reg bool b) -> reg u64
+{
+  reg u64 n y;
+
+  y = 0;
+  n = (b ? inlen : y) >> 6;
+  return n;
+}
