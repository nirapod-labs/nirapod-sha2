+Lemma op1_safe_ok (o : sop1) :
+  let t := type_of_op1 o in
+  all (safety_cond_wt [:: eval_atype t.1]) (op1_safe o).
+Proof.
+case: o => //= sg o; case: o => //= sz; case: sg => //=.
+all: by rewrite /safety_cond_wt /sc_neqi /sc_eqi /sc_toint /= cmp_le_refl.
+Qed.
