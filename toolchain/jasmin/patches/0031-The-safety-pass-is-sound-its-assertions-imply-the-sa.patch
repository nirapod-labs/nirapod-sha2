+  case: (of_val _ v1) => //= x1; case: (of_val _ v2) => //= x2.
+  by eexists; first reflexivity; apply truncate_val_to_val.
+move=> o c1 ih1 c2 ih2 c3 ih3 t.
+case heq1: (safety_cond_type tin c1) => [t1|] //; case heq2: (safety_cond_type tin c2) => [t2|] //.
