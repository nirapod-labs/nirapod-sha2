diff --git a/compiler/src/pp_arm_v8a.ml b/compiler/src/pp_arm_v8a.ml
index eb3a4ee..a4eb140 100644
--- a/compiler/src/pp_arm_v8a.ml
+++ b/compiler/src/pp_arm_v8a.ml
@@ -302,4 +302,63 @@ end
 
 module Armv8aBuilder = AsmTargetBuilder.Make(Armv8aTarget)
 
-let print_prog fmt prog = PrintASM.pp_asm fmt (Armv8aBuilder.asm_of_prog prog)
+(* A protect is assembled as [ORR d, a, msf] followed by [CSDB] (see
+   [assemble_slh_protect] in armv8a_extra.v). The CSDB keeps every
+   instruction after it in program order, other than a branch, from using
+   the results of data value or condition flag predictions made for the
+   instructions before it. In a run
+
+     ORR d1, a1, b1; CSDB; ORR d2, a2, b2; CSDB; ...; ORR dn, an, bn; CSDB
+
+   the CSDBs other than the last are dropped, provided that no ORR of the
+   run reads a register written by an earlier ORR of the run. The only
+   instructions moved before a CSDB are then register-to-register ORRs,
+   which do not access memory, branch or read a protected value. Every
+   later instruction, and so every use of d1 to dn, still comes after the
+   last CSDB. A CSDB has no architectural effect, so the printed program
+   computes what the assembly program does. The run must be adjacent in the
+   assembly code: a label, a call or any other instruction in between ends
+   it. *)
+let merge_csdb body =
+  let is_csdb i =
+    match i.asmi_i with
+    | AsmOp (ARMv8A_op (CSDB, _), []) -> true
+    | _ -> false
+  in
+  let orr_regs i =
+    match i.asmi_i with
+    | AsmOp (ARMv8A_op (ORR, { has_shift = None; _ }), [ Reg d; Reg a; Reg b ]) ->
+        Some (d, a, b)
+    | _ -> None
+  in
+  (* [written]: the registers written by the ORRs of the current run whose
+     CSDB was dropped. *)
+  let rec merge written = function
+    | o :: c :: rest when is_csdb c && Option.is_some (orr_regs o) ->
+        let d, _, _ = Option.get (orr_regs o) in
+        let written = d :: written in
+        let continues =
+          match rest with
+          | o' :: c' :: _ when is_csdb c' -> (
+              match orr_regs o' with
+              | Some (_, a', b') ->
+                  not (List.mem a' written || List.mem b' written)
+              | None -> false)
+          | _ -> false
+        in
+        if continues then o :: merge written rest
+        else o :: c :: merge [] rest
+    | i :: rest -> i :: merge [] rest
+    | [] -> []
+  in
+  merge [] body
+
+let merge_csdb_prog prog =
+  { prog with
+    asm_funcs =
+      List.map
+        (fun (fn, fd) -> (fn, { fd with asm_fd_body = merge_csdb fd.asm_fd_body }))
+        prog.asm_funcs }
+
+let print_prog fmt prog =
+  PrintASM.pp_asm fmt (Armv8aBuilder.asm_of_prog (merge_csdb_prog prog))
diff --git a/compiler/tests/armv8a_csdb.t/chain.jazz b/compiler/tests/armv8a_csdb.t/chain.jazz
new file mode 100644
index 0000000..eb1b217
--- /dev/null
+++ b/compiler/tests/armv8a_csdb.t/chain.jazz
@@ -0,0 +1,9 @@
+export
+fn chain(reg u64 p x) -> reg u64 {
+  reg u64 msf y;
+  msf = #init_msf();
+  x = #protect(x, msf);
+  y = #protect(x, msf);
+  y = [p + y];
+  return y;
+}
diff --git a/compiler/tests/armv8a_csdb.t/ptrs.jazz b/compiler/tests/armv8a_csdb.t/ptrs.jazz
new file mode 100644
index 0000000..50cedd1
--- /dev/null
+++ b/compiler/tests/armv8a_csdb.t/ptrs.jazz
@@ -0,0 +1,17 @@
+export
+fn ptrs() -> reg u64 {
+  stack u64[2] s t;
+  reg ptr u64[2] p q;
+  reg u64 v w msf;
+  v = 0;
+  s[0] = v; s[1] = v; t[0] = v; t[1] = v;
+  msf = #init_msf();
+  p = s;
+  q = t;
+  p = #protect_ptr(p, msf);
+  q = #protect_ptr(q, msf);
+  v = p[0];
+  w = q[1];
+  v += w;
+  return v;
+}
diff --git a/compiler/tests/armv8a_csdb.t/run.t b/compiler/tests/armv8a_csdb.t/run.t
new file mode 100644
index 0000000..74d594b
--- /dev/null
+++ b/compiler/tests/armv8a_csdb.t/run.t
@@ -0,0 +1,13 @@
+On ARMv8-A a protect is an ORR followed by a CSDB. A run of protects that
+do not read each other's results needs one CSDB, after the last ORR: run3
+and ptrs print one. A protect that reads the result of the previous one
+(chain), or any instruction between two protects (split), keeps both.
+
+  $ for f in run3 chain split ptrs; do
+  >   ../../jasminc -arch armv8a $f.jazz -o $f.s || echo "$f: failed"
+  >   echo "$f: $(grep -c -i -w orr $f.s) orr, $(grep -c -i -w csdb $f.s) csdb"
+  > done
+  run3: 3 orr, 1 csdb
+  chain: 2 orr, 2 csdb
+  split: 2 orr, 2 csdb
+  ptrs: 2 orr, 1 csdb
diff --git a/compiler/tests/armv8a_csdb.t/run3.jazz b/compiler/tests/armv8a_csdb.t/run3.jazz
new file mode 100644
index 0000000..988f2bc
--- /dev/null
+++ b/compiler/tests/armv8a_csdb.t/run3.jazz
@@ -0,0 +1,13 @@
+export
+fn run3(reg u64 p x y z) -> reg u64 {
+  reg u64 msf t;
+  msf = #init_msf();
+  x = #protect(x, msf);
+  y = #protect(y, msf);
+  z = #protect(z, msf);
+  t = [p + y];
+  x += t;
+  t = [p + z];
+  x += t;
+  return x;
+}
diff --git a/compiler/tests/armv8a_csdb.t/split.jazz b/compiler/tests/armv8a_csdb.t/split.jazz
new file mode 100644
index 0000000..2d7caf7
--- /dev/null
+++ b/compiler/tests/armv8a_csdb.t/split.jazz
@@ -0,0 +1,11 @@
+export
+fn split(reg u64 p x y) -> reg u64 {
+  reg u64 msf t;
+  msf = #init_msf();
+  x = #protect(x, msf);
+  y += 8;
+  y = #protect(y, msf);
+  t = [p + y];
+  x += t;
+  return x;
+}
