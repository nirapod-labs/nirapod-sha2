 compiler/tests/armv8a_csdb.t/ptrs.jazz  | 17 +++++++
 compiler/tests/armv8a_csdb.t/run.t      | 13 ++++++
 compiler/tests/armv8a_csdb.t/run3.jazz  | 13 ++++++
 compiler/tests/armv8a_csdb.t/split.jazz | 11 +++++
 6 files changed, 123 insertions(+), 1 deletion(-)
