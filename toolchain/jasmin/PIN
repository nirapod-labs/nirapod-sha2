# shellcheck shell=bash disable=SC2034
#
# toolchain/jasmin/PIN
# ====================
#
# The pinned Jasmin compiler and the environment it is built in. Shell
# syntax, read by toolchain/build.sh; it only sets variables.
#
# Git inputs are pinned by full commit id: build.sh fetches exactly that
# commit and stops if the checked-out HEAD differs. The patches listed in
# SERIES, if any, are applied on top of JASMIN_COMMIT.
#
# The environment follows the upstream CI at JASMIN_COMMIT: default.nix,
# scripts/mathcomp-word.nix, and nixpkgs b845e7606d23 (scripts/nixpkgs.nix),
# which builds Rocq 9.0 with OCaml 4.14.

# Jasmin, branch main, 2026-09-10.
JASMIN_URL=https://github.com/jasmin-lang/jasmin.git
JASMIN_COMMIT=288a569b6ed2bb50078b1882739fda6aa7873ec6

OCAML_VERSION=4.14.4

# opam package repositories. The switch sees these two and nothing else, so
# the solver's answer depends only on the pins. Released Rocq packages live
# in the `released/` directory of rocq-prover/opam.
OPAM_REPO_URL=https://github.com/ocaml/opam-repository.git
OPAM_REPO_COMMIT=518a009d5e480956e913feae3b5eb8f7f57879b8
ROCQ_OPAM_URL=https://github.com/rocq-prover/opam.git
ROCQ_OPAM_COMMIT=6f4c8bfcf7c3ed641eae4640d91b9ec8f7c754d2

# mathcomp-word at the revision upstream CI uses (scripts/mathcomp-word.nix).
COQWORD_URL=https://github.com/jasmin-lang/coqword.git
COQWORD_COMMIT=86ed49aeca65a8d32e81bb386778f49b45ee505b

# Rocq stack of default.nix: coqPackages_9_0 with coq-elpi 2.5.2 (elpi
# 2.0.7), hierarchy-builder 1.9.1 and mathcomp 2.4.0. OCaml libraries at the
# versions of the same nixpkgs, except yojson: elpi 2.0.7 requires
# atdgen < 2.16, hence yojson < 3, and the solver takes the newest yojson 2.
JASMIN_OPAM_PACKAGES="
  rocq-core.9.0.1 coq-core.9.0.1 rocq-stdlib.9.0.0 coq-stdlib.9.0.0
  elpi.2.0.7 coq-elpi.2.5.2 coq-hierarchy-builder.1.9.1
  coq-mathcomp-ssreflect.2.4.0 coq-mathcomp-algebra.2.4.0
  coq-paco.4.2.3 coq-itree.5.2.1
  menhir.20260203 menhirLib.20260203 apron.v0.9.15 zarith.1.14
  batteries.3.11.0 cmdliner.2.1.1 angstrom.0.16.1
  yojson camlidl conf-ppl ocamlfind dune
"

# opam itself: the build refuses another version, whose solver or repository
# handling could give a different switch from the same pins.
OPAM_VERSION=2.6.0
