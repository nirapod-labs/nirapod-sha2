  }

  #[ct = "secret × secret × public × public -> secret"]
  #[sct = "{ ptr: transient, val: secret } × { ptr: transient, val: secret } × transient ×
           transient → { ptr: transient, val: secret }"]
  #[safety =
     { requires = (64u) off + (64u) len <= _ASIZE && is_arr_init(a, (64u) off, (64u) len)
     , res = { out_out }
