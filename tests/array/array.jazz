    a = #protect_ptr(a, ms);
    off = #protect(off, ms);
    len = #protect(len, ms);

    h = __sha512_init(h);
    buf = buf_s;
    total = 0;
    () = #spill(out);
    h, buf, total, ms = _sha512_absorb_array(h, buf, total, a, off, len, ms);
    () = #unspill(out);
    out = #protect_ptr(out, ms);
    out, h, buf, ms = _sha512_finalize(out, h, buf, total, ms);
    return out;
  }

  #[ct = "secret × secret × public × public × public -> secret"]
  #[sct = "{ ptr: transient, val: secret } × { ptr: transient, val: secret } × transient ×
           transient × transient → { ptr: transient, val: secret }"]
  #[safety =
     { requires = (64u) off + 7 * (64u) stride + (64u) len <= _ASIZE
         && is_arr_init(a, (64u) off + 0 * (64u) stride, (64u) len)
         && is_arr_init(a, (64u) off + 1 * (64u) stride, (64u) len)
         && is_arr_init(a, (64u) off + 2 * (64u) stride, (64u) len)
         && is_arr_init(a, (64u) off + 3 * (64u) stride, (64u) len)
         && is_arr_init(a, (64u) off + 4 * (64u) stride, (64u) len)
         && is_arr_init(a, (64u) off + 5 * (64u) stride, (64u) len)
         && is_arr_init(a, (64u) off + 6 * (64u) stride, (64u) len)
         && is_arr_init(a, (64u) off + 7 * (64u) stride, (64u) len)
     , res = { out_out }
     , ensures = is_arr_init(out_out, 0, 256)
     }
   ]
  export fn sha256_x8(reg mut ptr u8[256] out, reg const ptr u8[_ASIZE] a,
                     reg u64 off stride len) -> reg ptr u8[256]
  {
    stack u32[64] h;
    stack u8[512] buf_s;
    reg ptr u8[512] buf;
    reg u64 ms total;

    ms = #init_msf();
    out = #protect_ptr(out, ms);
    a = #protect_ptr(a, ms);
    off = #protect(off, ms);
    stride = #protect(stride, ms);
    len = #protect(len, ms);

    h = __sha256_x8_init(h);
    buf = buf_s;
    total = 0;
    () = #spill(out);
    h, buf, total, ms = _sha256_x8_absorb_array(h, buf, total, a, off, stride, len, ms);
    () = #unspill(out);
