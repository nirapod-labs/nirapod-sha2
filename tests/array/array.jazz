     { requires = (64u) off + 3 * (64u) stride + (64u) len <= _ASIZE
         && is_arr_init(a, (64u) off + 0 * (64u) stride, (64u) len)
         && is_arr_init(a, (64u) off + 1 * (64u) stride, (64u) len)
         && is_arr_init(a, (64u) off + 2 * (64u) stride, (64u) len)
         && is_arr_init(a, (64u) off + 3 * (64u) stride, (64u) len)
     , res = { out_out }
     , ensures = is_arr_init(out_out, 0, 256)
     }
   ]
  export fn sha512_x4(reg mut ptr u8[256] out, reg const ptr u8[_ASIZE] a,
                     reg u64 off stride len) -> reg ptr u8[256]
  {
    stack u64[32] h;
    stack u8[512] buf_s;
    reg ptr u8[512] buf;
    reg u64 ms total;

    ms = #init_msf();
    out = #protect_ptr(out, ms);
    a = #protect_ptr(a, ms);
    off = #protect(off, ms);
    stride = #protect(stride, ms);
    len = #protect(len, ms);

    h = __sha512_x4_init(h);
