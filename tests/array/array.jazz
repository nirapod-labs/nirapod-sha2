    out, h, buf, ms = _sha512_x4_finalize(out, h, buf, total, ms);
    return out;
  }
}

namespace A333 {
  param int _ASIZE = 333;
  from Hash require "sha256_ASIZE.jinc"
  from Hash require "sha512_ASIZE.jinc"
  from Hash require "sha256_x8_ASIZE.jinc"
  from Hash require "sha512_x4_ASIZE.jinc"

  #[ct = "secret × secret × public × public -> secret"]
