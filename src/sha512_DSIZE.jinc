/*
 * SPDX-FileCopyrightText: nirapod-sha2 contributors
 * SPDX-FileCopyrightText: nirapod-sha2 contributors
 * SPDX-License-Identifier: Apache-2.0
 *
 * sha512_DSIZE.jinc
 * =================
 *
 * Padding and output of SHA-512, SHA-384, SHA-512/224 and SHA-512/256 for
 * a digest of _DSIZE bytes. Instance file: sha512.jinc requires it once
 * per function, inside a namespace that sets param int _DSIZE:
 *
 *     namespace     _DSIZE   digest               FIPS 180-4
 *     _sha512       64       H_0 .. H_7           section 6.4.2
 *     _sha384       48       H_0 .. H_5           section 6.5
 *     _sha512_224   28       H_0 .. H_2 and the   section 6.6
 *                            high half of H_3
 *     _sha512_256   32       H_0 .. H_3           section 6.7
 *
 * Each truncated function is SHA-512 with its own initial value whose final
 * hash value is truncated to its left-most 8 * _DSIZE bits (sections 6.5
 * to 6.7). Writing exactly _DSIZE bytes here means a truncated digest
 * needs no copy, and the bytes of the chaining value that those sections
 * drop never reach the caller's output.
 *
 *     _sha512_finalize     padding, last compressions, big-endian digest
 *     __sha512_mem_from    one-shot hashing from a loaded initial value
 *
 * Security: as sha512.jinc. _DSIZE is a compile-time constant, so the
 * output loops have fixed trip counts and fixed offsets.
 */

/*
 * Padding and output (FIPS 180-4 sections 5.1.2 and 6.4.2).
 *
 * The padded tail is the pending bytes, 0x80, zeros, and the 128-bit
 * big-endian bit length 8 * total, whose high half is total >> 61 and low
 * half total << 3. When the pending bytes and 0x80 leave fewer than 16
 * bytes in the block (fill > 112), the length goes into an extra block.
 *
 * out receives the left-most _DSIZE bytes of H_0 || H_1 || .. || H_7, each
 * word big-endian. h and buf keep final-state data afterwards and need
 * re-initialisation before reuse.
 *
 * out may be transient on entry. It is not used as an address until it
 * has crossed the last compression through the stack and been protected,
 * together with buf, so a caller that reloaded it need not protect it
 * first.
 */
#[sct = "{ ptr: transient, val: secret } × { ptr: public, val: secret } ×
         { ptr: public, val: secret } × public × msf →
         { ptr: public, val: secret } × { ptr: public, val: secret } ×
         { ptr: public, val: secret } × msf"]
#[safety =
   { requires = is_arr_init(h, 0, 64) && is_arr_init(buf, 0, (64u) total % 128)
   , res = { out_out, h_out, buf_out, ms_out }
   , ensures = is_arr_init(out_out, 0, _DSIZE) && is_arr_init(h_out, 0, 64)
       && is_arr_init(buf_out, 0, 128)
   }
 ]
fn _sha512_finalize(
  reg mut ptr u8[_DSIZE] out,
  reg mut ptr u64[8] h,
  reg mut ptr u8[128] buf,
  reg u64 total,
  reg u64 ms
) -> reg ptr u8[_DSIZE], reg ptr u64[8], reg ptr u8[128], reg u64
{
  reg u64 fill hi t;
  reg u64 x;
  reg u32 y;
  reg bool two_blocks;
  inline int i;

  fill = total;
  fill &= 127;

  t = 0x80;
  buf[fill] = (8u)t;
  fill += 1;

  two_blocks = fill > 112;
  if (two_blocks) {
    ms = #update_msf(two_blocks, ms);
    hi = 128;
    buf, ms = __zero128(buf, fill, hi, ms);

    () = #spill(out, buf, total);
    h, ms = _sha512_compress(h, buf, ms);
    () = #unspill(out, buf, total);
    out = #protect_ptr(out, ms);
    buf = #protect_ptr(buf, ms);
    total = #protect(total, ms);
    fill = 0;
  } else {
    ms = #update_msf(!two_blocks, ms);
  }

  hi = 112;
  buf, ms = __zero128(buf, fill, hi, ms);

  t = total;
  t >>= 61;
  t = __bswap64(t);
  buf.[:u64 112] = t;
  t = total;
  t <<= 3;
  t = __bswap64(t);
  buf.[:u64 120] = t;

  () = #spill(out, buf);
  h, ms = _sha512_compress(h, buf, ms);
  () = #unspill(out, buf);
  out = #protect_ptr(out, ms);
  buf = #protect_ptr(buf, ms);

  /* The whole words: all eight for SHA-512, six, four or three. */
  for i = 0 to _DSIZE / 8 {
    x = h[i];
    x = __bswap64(x);
    out[:u64 i] = x;
  }

  /*
   * A digest that ends inside a word: SHA-512/224 keeps the four
   * high-order bytes of H_3, which come first in big-endian order. The
   * loop runs once when _DSIZE is 28 and not at all for 32, 48 or 64.
   */
  for i = _DSIZE / 8 to (_DSIZE + 7) / 8 {
    x = h[i];
    x >>= 32;
    y = (32u)x;
    y = __bswap32(y);
    out[:u32 2 * i] = y;
  }

  return out, h, buf, ms;
}

#[safety =
   { requires = is_arr_init(h, 0, 64) && is_mem_init((64u) in, (64u) inlen)
   , res = { out_out, ms_out }
   , ensures = is_arr_init(out_out, 0, _DSIZE)
   }
 ]
inline fn __sha512_mem_from(
  reg mut ptr u8[_DSIZE] out,
  reg mut ptr u64[8] h,
  reg u64 in inlen,
  reg u64 ms
) -> reg ptr u8[_DSIZE], reg u64
{
  stack u8[128] buf_s;
  reg ptr u8[128] buf;
  reg u64 total;

  buf = buf_s;
  total = 0;
  /*
   * out is live across the absorb call and crosses it through the stack.
   * It comes back transient and goes to finalize as it is: finalize
   * moves it through the stack again before its last compression and
   * protects it there, before any use as an address.
   */
  () = #spill(out);
  h, buf, total, ms = _sha512_absorb_mem(h, buf, total, in, inlen, ms);
  () = #unspill(out);
  out, h, buf, ms = _sha512_finalize(out, h, buf, total, ms);

  return out, ms;
}
