/*
 * SPDX-FileCopyrightText: nirapod-sha2 contributors
 * SPDX-License-Identifier: Apache-2.0
 *
 * context_x.jinc
 * ==============
 *
 * The caller-held contexts of the multi-way interface, with the rules of
 * context.jinc (tag, status, length limit, classification, no write on
 * failure). The C layer passes them through without reading a byte.
 *
 * Layout (byte offsets), the representation of sha256_x8.jinc and
 * sha512_x4.jinc stored as it is, the same in every unit:
 *
 *     SHA-256, 8 lanes                       784 bytes
 *         0    tag     u64
 *         8    total   u64      bytes absorbed per lane
 *         16   h       u32[64]  H_j of lane k at 8 j + k
 *         272  buf     u8[512]  lane k's pending block at 64 k
 *
 *     SHA-512, 4 lanes                       784 bytes
 *         0    tag     u64
 *         8    total   u64
 *         16   h       u64[32]  H_j of lane k at 4 j + k
 *         272  buf     u8[512]  lane k's pending block at 128 k
 *
 * Update and final work on the context in place, through sub-arrays at
 * these offsets.
 *
 * init_from starts every lane at the state of a single-way context of the
 * same hash (SHA-256 for 8 lanes, SHA-512 for 4), which is read and not
 * changed: its tag must be that function's, so a context of another
 * function or one already finalised fails with SHA2_STATUS_STATE and
 * nothing is written.
 */

from Hash require "context.jinc"
from Hash require "sha256_x8.jinc"
from Hash require "sha512_x4.jinc"

param int SHA256_X8_CTX_BYTES = 784;
param int SHA512_X4_CTX_BYTES = 784;

param int SHA2_FN_SHA256_X8 = 9;
param int SHA2_FN_SHA512_X4 = 10;

/*
 * SHA-256, 8 lanes
 * ================
 */

/* Init: tag, total 0, every lane at the initial value, buf zero. */
#[safety =
   { res = { ctx_out }
   , ensures = is_arr_init(ctx_out, 0, SHA256_X8_CTX_BYTES)
   }
 ]
inline fn __sha256_x8_ctx_init(reg mut ptr u8[SHA256_X8_CTX_BYTES] ctx) -> reg ptr u8[SHA256_X8_CTX_BYTES]
{
  reg u64 tag z;
  inline int i;

  tag = __sha2_tag(SHA2_FN_SHA256_X8);
  ctx.[:u64 0] = tag;
  z = 0;
  ctx.[:u64 8] = z;
  ctx[:u32 4 : 64] = __sha256_x8_init(ctx[:u32 4 : 64]);
  for i = 0 to 64 {
    ctx.[:u64 272 + 8 * i] = z;
  }

  return ctx;
}

/*
 * Init from a single-way context src of SHA-256: every lane continues the
 * hash in src. Result SHA2_STATUS_OK: ctx holds the multi-way tag, src's
 * total, and src's h and buf in every lane. SHA2_STATUS_STATE (src's tag
 * is not the SHA-256 tag): ctx is not written, and only the first 16 bytes
 * of src are read. src is never written. ctx must not overlap src.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × public × msf"]
#[safety =
   { requires = is_arr_init(src, 0, SHA256_CTX_BYTES)
   , res = { ctx_out, status, ms_out }
   , ensures = is_arr_init(ctx_out, 0, status == SHA2_STATUS_OK ? SHA256_X8_CTX_BYTES : 0)
   }
 ]
fn _sha256_x8_ctx_from(
  reg mut ptr u8[SHA256_X8_CTX_BYTES] ctx,
  reg const ptr u8[SHA256_CTX_BYTES] src,
  reg u64 ms
) -> reg ptr u8[SHA256_X8_CTX_BYTES], reg u64, reg u64
{
  reg u64 tag total expect status;
  reg bool ok;

  tag, total = __sha2_ctx_open(src[0:16], ms);
  expect = __sha2_tag(SHA2_FN_SHA256);
  status = SHA2_STATUS_STATE;

  ok = tag == expect;
  if (ok) {
    ms = #update_msf(ok, ms);
    tag = __sha2_tag(SHA2_FN_SHA256_X8);
    ctx.[:u64 0] = tag;
    ctx.[:u64 8] = total;
    ctx[:u32 4 : 64], ctx[272 : 512] =
      __sha256_x8_from(ctx[:u32 4 : 64], ctx[272 : 512],
                       src[:u32 4 : 8], src[48 : 64]);
    status = SHA2_STATUS_OK;
  } else {
    ms = #update_msf(!ok, ms);
  }

  return ctx, status, ms;
}

/*
 * Update: append inlen bytes to every lane, lane k's at in[k], as
 * _sha256_x8_absorb_lanes on the stored state. SHA2_STATUS_STATE (tag
 * differs) or SHA2_STATUS_LENGTH (total + inlen would reach 2^61): ctx is
 * not written, and only its first 16 bytes are read. No lane may overlap
 * ctx.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: transient } × public × msf →
         { ptr: public, val: secret } × public × msf"]
#[safety =
   { requires = is_arr_init(ctx, 0, SHA256_X8_CTX_BYTES)
       && is_arr_init(in, 0, 64)
       && is_mem_init((64u) in[0], (64u) inlen)
       && is_mem_init((64u) in[1], (64u) inlen)
       && is_mem_init((64u) in[2], (64u) inlen)
       && is_mem_init((64u) in[3], (64u) inlen)
       && is_mem_init((64u) in[4], (64u) inlen)
       && is_mem_init((64u) in[5], (64u) inlen)
       && is_mem_init((64u) in[6], (64u) inlen)
       && is_mem_init((64u) in[7], (64u) inlen)
   , res = { ctx_out, status, ms_out }
   , ensures = is_arr_init(ctx_out, 0, SHA256_X8_CTX_BYTES)
   }
 ]
fn _sha256_x8_ctx_update(
  reg mut ptr u8[SHA256_X8_CTX_BYTES] ctx,
  reg const ptr u64[8] in,
  reg u64 inlen,
  reg u64 ms
) -> reg ptr u8[SHA256_X8_CTX_BYTES], reg u64, reg u64
{
  reg u64 tag total expect room status;
  reg bool ok;

  tag, total = __sha2_ctx_open(ctx[0:16], ms);
  expect = __sha2_tag(SHA2_FN_SHA256_X8);
  status = SHA2_STATUS_STATE;

  ok = tag == expect;
  if (ok) {
    ms = #update_msf(ok, ms);

    room = __sha2_room(total);
    status = SHA2_STATUS_LENGTH;
    ok = inlen < room;
    if (ok) {
      ms = #update_msf(ok, ms);
      ctx[:u32 4 : 64], ctx[272 : 512], total, ms =
        _sha256_x8_absorb_lanes(ctx[:u32 4 : 64], ctx[272 : 512], total,
                                in, inlen, ms);
      ctx.[:u64 8] = total;
      status = SHA2_STATUS_OK;
    } else {
      ms = #update_msf(!ok, ms);
    }
  } else {
    ms = #update_msf(!ok, ms);
  }

  return ctx, status, ms;
}

/*
 * Final: pad and finish every lane, write the 8 digests to out (digest k
 * at 32 k), then zero every byte of ctx. SHA2_STATUS_STATE: neither ctx
 * nor out is written, and only the first 16 bytes of ctx are read. out
 * must not overlap ctx.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × { ptr: public, val: secret } × public × msf"]
#[safety =
   { requires = is_arr_init(ctx, 0, SHA256_X8_CTX_BYTES)
   , res = { ctx_out, out_out, status, ms_out }
   , ensures = is_arr_init(ctx_out, 0, SHA256_X8_CTX_BYTES)
       && is_arr_init(out_out, 0, status == SHA2_STATUS_OK ? 256 : 0)
   }
 ]
fn _sha256_x8_ctx_final(
  reg mut ptr u8[SHA256_X8_CTX_BYTES] ctx,
  reg mut ptr u8[256] out,
  reg u64 ms
) -> reg ptr u8[SHA256_X8_CTX_BYTES], reg ptr u8[256], reg u64, reg u64
{
  reg u64 tag total expect status z;
  reg bool ok;
  inline int i;

  tag, total = __sha2_ctx_open(ctx[0:16], ms);
  expect = __sha2_tag(SHA2_FN_SHA256_X8);
  status = SHA2_STATUS_STATE;

  ok = tag == expect;
  if (ok) {
    ms = #update_msf(ok, ms);
    out, ctx[:u32 4 : 64], ctx[272 : 512], ms =
      _sha256_x8_finalize(out, ctx[:u32 4 : 64], ctx[272 : 512], total, ms);
    z = 0;
    for i = 0 to SHA256_X8_CTX_BYTES / 8 {
      ctx.[:u64 8 * i] = z;
    }
    status = SHA2_STATUS_OK;
  } else {
    ms = #update_msf(!ok, ms);
  }

  return ctx, out, status, ms;
}

/*
 * SHA-512, 4 lanes
 * ================
 */

/* Init: tag, total 0, every lane at the initial value, buf zero. */
#[safety =
   { res = { ctx_out }
   , ensures = is_arr_init(ctx_out, 0, SHA512_X4_CTX_BYTES)
   }
 ]
inline fn __sha512_x4_ctx_init(reg mut ptr u8[SHA512_X4_CTX_BYTES] ctx) -> reg ptr u8[SHA512_X4_CTX_BYTES]
{
  reg u64 tag z;
  inline int i;

  tag = __sha2_tag(SHA2_FN_SHA512_X4);
  ctx.[:u64 0] = tag;
  z = 0;
  ctx.[:u64 8] = z;
  ctx[:u64 2 : 32] = __sha512_x4_init(ctx[:u64 2 : 32]);
  for i = 0 to 64 {
    ctx.[:u64 272 + 8 * i] = z;
  }

  return ctx;
}

/*
 * Init from a single-way context src of SHA-512: every lane continues the
 * hash in src. Result SHA2_STATUS_OK: ctx holds the multi-way tag, src's
 * total, and src's h and buf in every lane. SHA2_STATUS_STATE (src's tag
 * is not the SHA-512 tag): ctx is not written, and only the first 16 bytes
 * of src are read. src is never written. ctx must not overlap src.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × public × msf"]
#[safety =
   { requires = is_arr_init(src, 0, SHA512_CTX_BYTES)
   , res = { ctx_out, status, ms_out }
   , ensures = is_arr_init(ctx_out, 0, status == SHA2_STATUS_OK ? SHA512_X4_CTX_BYTES : 0)
   }
 ]
fn _sha512_x4_ctx_from(
  reg mut ptr u8[SHA512_X4_CTX_BYTES] ctx,
  reg const ptr u8[SHA512_CTX_BYTES] src,
  reg u64 ms
) -> reg ptr u8[SHA512_X4_CTX_BYTES], reg u64, reg u64
{
  reg u64 tag total expect status;
  reg bool ok;

  tag, total = __sha2_ctx_open(src[0:16], ms);
  expect = __sha2_tag(SHA2_FN_SHA512);
  status = SHA2_STATUS_STATE;

  ok = tag == expect;
  if (ok) {
    ms = #update_msf(ok, ms);
    tag = __sha2_tag(SHA2_FN_SHA512_X4);
    ctx.[:u64 0] = tag;
    ctx.[:u64 8] = total;
    ctx[:u64 2 : 32], ctx[272 : 512] =
      __sha512_x4_from(ctx[:u64 2 : 32], ctx[272 : 512],
                       src[:u64 2 : 8], src[80 : 128]);
    status = SHA2_STATUS_OK;
  } else {
    ms = #update_msf(!ok, ms);
  }

  return ctx, status, ms;
}

/*
 * Update: append inlen bytes to every lane, lane k's at in[k], as
 * _sha512_x4_absorb_lanes on the stored state. SHA2_STATUS_STATE (tag
 * differs) or SHA2_STATUS_LENGTH (total + inlen would reach 2^61): ctx is
 * not written, and only its first 16 bytes are read. No lane may overlap
 * ctx.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: transient } × public × msf →
         { ptr: public, val: secret } × public × msf"]
#[safety =
   { requires = is_arr_init(ctx, 0, SHA512_X4_CTX_BYTES)
       && is_arr_init(in, 0, 32)
       && is_mem_init((64u) in[0], (64u) inlen)
       && is_mem_init((64u) in[1], (64u) inlen)
       && is_mem_init((64u) in[2], (64u) inlen)
       && is_mem_init((64u) in[3], (64u) inlen)
   , res = { ctx_out, status, ms_out }
   , ensures = is_arr_init(ctx_out, 0, SHA512_X4_CTX_BYTES)
   }
 ]
fn _sha512_x4_ctx_update(
  reg mut ptr u8[SHA512_X4_CTX_BYTES] ctx,
  reg const ptr u64[4] in,
  reg u64 inlen,
  reg u64 ms
) -> reg ptr u8[SHA512_X4_CTX_BYTES], reg u64, reg u64
{
  reg u64 tag total expect room status;
  reg bool ok;

  tag, total = __sha2_ctx_open(ctx[0:16], ms);
  expect = __sha2_tag(SHA2_FN_SHA512_X4);
  status = SHA2_STATUS_STATE;

  ok = tag == expect;
  if (ok) {
    ms = #update_msf(ok, ms);

    room = __sha2_room(total);
    status = SHA2_STATUS_LENGTH;
    ok = inlen < room;
    if (ok) {
      ms = #update_msf(ok, ms);
      ctx[:u64 2 : 32], ctx[272 : 512], total, ms =
        _sha512_x4_absorb_lanes(ctx[:u64 2 : 32], ctx[272 : 512], total,
                                in, inlen, ms);
      ctx.[:u64 8] = total;
      status = SHA2_STATUS_OK;
    } else {
      ms = #update_msf(!ok, ms);
    }
  } else {
    ms = #update_msf(!ok, ms);
  }

  return ctx, status, ms;
}

/*
 * Final: pad and finish every lane, write the 4 digests to out (digest k
 * at 64 k), then zero every byte of ctx. SHA2_STATUS_STATE: neither ctx
 * nor out is written, and only the first 16 bytes of ctx are read. out
 * must not overlap ctx.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × { ptr: public, val: secret } × public × msf"]
#[safety =
   { requires = is_arr_init(ctx, 0, SHA512_X4_CTX_BYTES)
   , res = { ctx_out, out_out, status, ms_out }
   , ensures = is_arr_init(ctx_out, 0, SHA512_X4_CTX_BYTES)
       && is_arr_init(out_out, 0, status == SHA2_STATUS_OK ? 256 : 0)
   }
 ]
fn _sha512_x4_ctx_final(
  reg mut ptr u8[SHA512_X4_CTX_BYTES] ctx,
  reg mut ptr u8[256] out,
  reg u64 ms
) -> reg ptr u8[SHA512_X4_CTX_BYTES], reg ptr u8[256], reg u64, reg u64
{
  reg u64 tag total expect status z;
  reg bool ok;
  inline int i;

  tag, total = __sha2_ctx_open(ctx[0:16], ms);
  expect = __sha2_tag(SHA2_FN_SHA512_X4);
  status = SHA2_STATUS_STATE;

  ok = tag == expect;
  if (ok) {
    ms = #update_msf(ok, ms);
    out, ctx[:u64 2 : 32], ctx[272 : 512], ms =
      _sha512_x4_finalize(out, ctx[:u64 2 : 32], ctx[272 : 512], total, ms);
    z = 0;
    for i = 0 to SHA512_X4_CTX_BYTES / 8 {
      ctx.[:u64 8 * i] = z;
    }
    status = SHA2_STATUS_OK;
  } else {
    ms = #update_msf(!ok, ms);
  }

  return ctx, out, status, ms;
}
