/*
 * SPDX-FileCopyrightText: nirapod-sha2 contributors
 * SPDX-License-Identifier: Apache-2.0
 *
 * sha256_x8_compress.jinc (x86-64, shani)
 * =======================================
 *
 * Eight independent SHA-256 compressions on the x86 SHA extensions, with
 * the entry points and contracts of the portable 8-way kernel
 * (src/sha256_x8_compress.jinc):
 *
 *     _sha256_x8_compress(h8, blocks, ms)
 *     _sha256_x8_compress_lanes(h8, in, off, n, ms)
 *
 * Rounds. Each lane runs the rounds of the single-way kernel in this
 * directory (sha256_compress.jinc): its eight working variables in two
 * registers, named by their dword lanes from high to low,
 *
 *     abef = A B E F        cdgh = C D G H
 *
 * two rounds per SHA256RNDS2, and the schedule four words at a time with
 * SHA256MSG1 / SHA256MSG2. One lane's rounds are a chain of dependent
 * SHA256RNDS2, each of which waits for the previous one's result, so a
 * core that can start a new one before the previous has finished idles
 * between them. Two lanes are therefore run together: for every group of
 * four rounds, the first SHA256RNDS2 of lane 2i and of lane 2i + 1, then
 * the second of each. The two chains are independent and fill each
 * other's gaps.
 *
 * Registers. A pair of lanes needs its 4 state registers and 8 schedule
 * registers, the two W + K values of the group, the copy of one of them
 * in XMM0 (the implicit operand of SHA256RNDS2) and one temporary: 16
 * registers would not also hold the 4 state values saved for the
 * feed-forward of step 4, so those are stored to the stack at the start
 * of each block and added back from it at the end.
 *
 * State layout. h8 holds H_j of lane k at 8j + k, so the 16 bytes
 * h8[:u128 2j + f] are word j of lanes 4f .. 4f + 3, lane 4f lowest. The
 * pair of lanes 4f + 2r, 4f + 2r + 1 is dwords 2r and 2r + 1 of each of
 * those eight rows. Interleaving the dwords of two rows (VPUNPCK{L,H}_4u32)
 * and then the qwords of two such results (VPUNPCK{L,H}_2u64) gives the
 * abef and cdgh registers of both lanes directly; the inverse shuffles
 * and a blend into the rows put them back.
 *
 * Message words are big-endian in the block (FIPS 180-4 section 3.1);
 * VPSHUFB reverses the bytes of each dword after a 16-byte load.
 *
 * Required CPU features: SHA (SHA256RNDS2, SHA256MSG1, SHA256MSG2) and AVX
 * for the VEX-encoded shuffles, adds and blends, as the single-way kernel.
 * The caller's dispatch must select this variant only where both are
 * present.
 *
 * Security: h8 and the blocks are secret. The rounds are straight-line
 * code; the only branches are the block loops of
 * _sha256_x8_compress_lanes on its public block count, which update ms.
 * Every address is fixed at compile time or is a public lane pointer
 * protected after its load from the table.
 *
 * Residue: the stack keeps, for the pairs of lanes, the chaining values
 * saved for the feed-forward of their last block (the values before that
 * block); the vector registers that held state and schedule are not
 * cleared here.
 */

from Hash require "sha256_k.jinc"

/*
 * PSHUFB mask reversing the bytes of each dword: as little-endian u32
 * words, lane i selects source bytes 4i+3, 4i+2, 4i+1, 4i.
 */
u32[4] SHA256_X8_SHANI_BSWAP = { 0x00010203, 0x04050607, 0x08090a0b, 0x0c0d0e0f };

/*
 * The chaining values of lanes 4f + 2r and 4f + 2r + 1 as
 * [abef; cdgh; abef; cdgh], the first lane's two registers first.
 *
 * q = 0 takes rows A, B, E, F (words 0, 1, 4, 5) to abef, q = 1 rows C, D,
 * G, H (words 2, 3, 6, 7) to cdgh. With dwords written low to high and
 * the two lanes as 0 and 1, for q = 0 and r = 0:
 *
 *     t = UNPCKL_4u32(B, A) = B0 A0 B1 A1
 *     s = UNPCKL_4u32(F, E) = F0 E0 F1 E1
 *     UNPCKL_2u64(s, t)     = F0 E0 B0 A0   abef of lane 0
 *     UNPCKH_2u64(s, t)     = F1 E1 B1 A1   abef of lane 1
 *
 * and r = 1 takes dwords 2 and 3 with UNPCKH_4u32 instead.
 */
#[safety =
   { requires = 0 <= f && f < 2 && 0 <= r && r < 2 && is_arr_init(h8, 0, 256)
   }
 ]
inline fn __shani_x8_load_pair(
  reg const ptr u32[64] h8,
  inline int f r
) -> reg u128[4]
{
  reg u128[4] st;
  reg u128 x y u v s t;
  inline int q;

  for q = 0 to 2 {
    x = h8[:u128 2 * (2 * q) + f];
    y = h8[:u128 2 * (2 * q + 1) + f];
    u = h8[:u128 2 * (2 * q + 4) + f];
    v = h8[:u128 2 * (2 * q + 5) + f];
    #[inline]
    if (r == 0) {
      t = #VPUNPCKL_4u32(y, x);
      s = #VPUNPCKL_4u32(v, u);
    } else {
      t = #VPUNPCKH_4u32(y, x);
      s = #VPUNPCKH_4u32(v, u);
    }
    st[q] = #VPUNPCKL_2u64(s, t);
    st[2 + q] = #VPUNPCKH_2u64(s, t);
  }

  return st;
}

/*
 * The inverse of __shani_x8_load_pair. The qword interleave is its own
 * inverse; then for q = 0
 *
 *     t = B0 A0 B1 A1     PSHUFD 0xdd: A0 A1 A0 A1    PSHUFD 0x88: B0 B1 B0 B1
 *     s = F0 E0 F1 E1     PSHUFD 0xdd: E0 E1 E0 E1    PSHUFD 0x88: F0 F1 F0 F1
 *
 * and each is blended into dwords 2r, 2r + 1 of its row, the other two
 * dwords of the row being the other pair's.
 */
#[safety =
   { requires = 0 <= f && f < 2 && 0 <= r && r < 2 && is_arr_init(h8, 0, 256)
   , res = { h_out }
   , ensures = is_arr_init(h_out, 0, 256)
   }
 ]
inline fn __shani_x8_store_pair(
  reg mut ptr u32[64] h8,
  reg u128[4] st,
  inline int f r
) -> reg ptr u32[64]
{
  reg u128 s t x y;
  inline int q m;

  m = r == 0 ? 0x0f : 0xf0;
  for q = 0 to 2 {
    t = #VPUNPCKH_2u64(st[q], st[2 + q]);
    s = #VPUNPCKL_2u64(st[q], st[2 + q]);

    x = #VPSHUFD_128(t, 0xdd);
    y = h8[:u128 2 * (2 * q) + f];
    y = #VPBLEND_8u16(y, x, m);
    h8[:u128 2 * (2 * q) + f] = y;

    x = #VPSHUFD_128(t, 0x88);
    y = h8[:u128 2 * (2 * q + 1) + f];
    y = #VPBLEND_8u16(y, x, m);
    h8[:u128 2 * (2 * q + 1) + f] = y;

    x = #VPSHUFD_128(s, 0xdd);
    y = h8[:u128 2 * (2 * q + 4) + f];
    y = #VPBLEND_8u16(y, x, m);
    h8[:u128 2 * (2 * q + 4) + f] = y;

    x = #VPSHUFD_128(s, 0x88);
    y = h8[:u128 2 * (2 * q + 5) + f];
    y = #VPBLEND_8u16(y, x, m);
    h8[:u128 2 * (2 * q + 5) + f] = y;
  }

  return h8;
}

/*
 * One block of a pair of lanes: the 64 rounds and the feed-forward on st,
 * [abef; cdgh] of the first lane then of the second, as
 * __shani_x8_load_pair leaves them. w holds the sixteen message words of
 * the first lane in w[0 .. 3] and of the second in w[4 .. 7], already
 * byte-swapped; group g of a lane (W_4g .. W_4g+3) for g >= 4 is computed
 * into the register of group g - 4 as in the single-way kernel. w is
 * returned (holding W_48 .. W_63) only so that the caller's array is
 * updated in place rather than copied.
 */
#[safety =
   { requires = is_arr_init(k, 0, 256)
   }
 ]
inline fn __shani_x8_block2(
  reg u128[4] st,
  reg u128[8] w,
  reg const ptr u32[64] k
) -> reg u128[4], reg u128[8]
{
  stack u128[4] s0;
  reg u128[2] wk;
  reg u128 x0 t;
  inline int g l j;

  for j = 0 to 4 {
    s0[j] = st[j];
  }

  for g = 0 to 16 {
    for l = 0 to 2 {
      #[inline]
      if (g >= 4) {
        w[4 * l + g % 4] = #SHA256MSG1(w[4 * l + g % 4], w[4 * l + (g + 1) % 4]);
        t = #VPALIGNR_128(w[4 * l + (g + 3) % 4], w[4 * l + (g + 2) % 4], 4);
        w[4 * l + g % 4] = #VPADD_4u32(w[4 * l + g % 4], t);
        w[4 * l + g % 4] = #SHA256MSG2(w[4 * l + g % 4], w[4 * l + (g + 3) % 4]);
      }

      /* Rounds 4g, 4g + 1 */

      wk[l] = #VPADD_4u32(w[4 * l + g % 4], k[:u128 g]);
      x0 = wk[l];
      st[2 * l + 1] = #SHA256RNDS2(st[2 * l + 1], st[2 * l], x0);
    }

    /* Rounds 4g + 2, 4g + 3 */

    for l = 0 to 2 {
      x0 = #VPSHUFD_128(wk[l], 0x0e);
      st[2 * l] = #SHA256RNDS2(st[2 * l], st[2 * l + 1], x0);
    }
  }

  for j = 0 to 4 {
    st[j] = #VPADD_4u32(st[j], s0[j]);
  }

  return st, w;
}

#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × msf"]
#[safety =
   { requires = is_arr_init(h8, 0, 256) && is_arr_init(blocks, 0, 512)
   , res = { h_out, ms_out }
   , ensures = is_arr_init(h_out, 0, 256)
   }
 ]
fn _sha256_x8_compress(
  reg mut ptr u32[64] h8,
  reg const ptr u8[512] blocks,
  reg u64 ms
) -> reg ptr u32[64], reg u64
{
  reg u128[4] st;
  reg u128[8] w;
  reg u128 mask;
  reg ptr u32[4] mask_p;
  reg ptr u32[64] k;
  inline int f r i;

  k = SHA256_K;
  mask_p = SHA256_X8_SHANI_BSWAP;
  for f = 0 to 2 {
    for r = 0 to 2 {
      st = __shani_x8_load_pair(h8, f, r);
      mask = mask_p[:u128 0];
      /* lane k's block is blocks[:u128 4k .. 4k + 3] */
      for i = 0 to 4 {
        w[i] = blocks[:u128 4 * (4 * f + 2 * r) + i];
        w[i] = #VPSHUFB_128(w[i], mask);
        w[4 + i] = blocks[:u128 4 * (4 * f + 2 * r + 1) + i];
        w[4 + i] = #VPSHUFB_128(w[4 + i], mask);
      }
      st, w = __shani_x8_block2(st, w, k);
      h8 = __shani_x8_store_pair(h8, st, f, r);
    }
  }

  return h8, ms;
}

/*
 * n whole blocks of every lane, read straight from lane memory: lane k's
 * blocks are the 64 n bytes at in[k] + off. Each pair of lanes runs all
 * its n blocks before the next pair starts, with its state in registers
 * throughout; nothing crosses a function call, so only the lane pointers,
 * loaded from the table, need protecting.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: transient } × public ×
         public × msf → { ptr: public, val: secret } × msf"]
#[safety =
   { requires = is_arr_init(h8, 0, 256) && is_arr_init(in, 0, 64)
       && n < (64u) 288230376151711744 && off < (64u) 2305843009213693952
       && is_mem_init((64u) in[0] + (64u) off, 64 * (64u) n)
       && is_mem_init((64u) in[1] + (64u) off, 64 * (64u) n)
       && is_mem_init((64u) in[2] + (64u) off, 64 * (64u) n)
       && is_mem_init((64u) in[3] + (64u) off, 64 * (64u) n)
       && is_mem_init((64u) in[4] + (64u) off, 64 * (64u) n)
       && is_mem_init((64u) in[5] + (64u) off, 64 * (64u) n)
       && is_mem_init((64u) in[6] + (64u) off, 64 * (64u) n)
       && is_mem_init((64u) in[7] + (64u) off, 64 * (64u) n)
   , res = { h_out, ms_out }
   , ensures = is_arr_init(h_out, 0, 256)
   }
 ]
fn _sha256_x8_compress_lanes(
  reg mut ptr u32[64] h8,
  reg const ptr u64[8] in,
  reg u64 off n,
  reg u64 ms
) -> reg ptr u32[64], reg u64
{
  reg u128[4] st;
  reg u128[8] w;
  reg u128 mask;
  reg ptr u32[4] mask_p;
  reg ptr u32[64] k;
  reg u64 p q c;
  reg bool more;
  inline int f r i;

  k = SHA256_K;
  mask_p = SHA256_X8_SHANI_BSWAP;
  for f = 0 to 2 {
    for r = 0 to 2 {
      st = __shani_x8_load_pair(h8, f, r);
      p = in[4 * f + 2 * r];
      p = #protect(p, ms);
      p += off;
      q = in[4 * f + 2 * r + 1];
      q = #protect(q, ms);
      q += off;
      c = n;
      while { more = c != 0; } (more) {
        ms = #update_msf(more, ms);
        mask = mask_p[:u128 0];
        for i = 0 to 4 {
          w[i] = [:u128 p + 16 * i];
          w[i] = #VPSHUFB_128(w[i], mask);
          w[4 + i] = [:u128 q + 16 * i];
          w[4 + i] = #VPSHUFB_128(w[4 + i], mask);
        }
        st, w = __shani_x8_block2(st, w, k);
        p += 64;
        q += 64;
        c -= 1;
      }
      ms = #update_msf(!more, ms);
      h8 = __shani_x8_store_pair(h8, st, f, r);
    }
  }

  return h8, ms;
}
