/* VPSHUFB mask reversing the bytes of each dword, in both 128-bit halves. */
u32[8] SHA256_X8_BSWAP = {
  0x00010203, 0x04050607, 0x08090a0b, 0x0c0d0e0f,
  0x00010203, 0x04050607, 0x08090a0b, 0x0c0d0e0f
};

/* Σ0(x) = ROTR^2(x) ^ ROTR^13(x) ^ ROTR^22(x), as shifts and a tree of XORs. */
inline fn __Sigma0_8x(reg u256 x) -> reg u256
{
  reg u256 r s t;

  r = x >>8u32 2;
  s = x <<8u32 30;
  r ^= s;
  s = x >>8u32 13;
  t = x <<8u32 19;
  s ^= t;
  r ^= s;
  s = x >>8u32 22;
  t = x <<8u32 10;
  s ^= t;
  r ^= s;
  return r;
}

/* Σ1(x) = ROTR^6(x) ^ ROTR^11(x) ^ ROTR^25(x) */
inline fn __Sigma1_8x(reg u256 x) -> reg u256
{
  reg u256 r s t;

  r = x >>8u32 6;
  s = x <<8u32 26;
  r ^= s;
  s = x >>8u32 11;
  t = x <<8u32 21;
  s ^= t;
  r ^= s;
  s = x >>8u32 25;
  t = x <<8u32 7;
  s ^= t;
  r ^= s;
  return r;
}

/* σ0(x) = ROTR^7(x) ^ ROTR^18(x) ^ SHR^3(x) */
inline fn __sigma0_8x(reg u256 x) -> reg u256
{
  reg u256 r s t;

  r = x >>8u32 7;
  s = x <<8u32 25;
  r ^= s;
  s = x >>8u32 18;
  t = x <<8u32 14;
  s ^= t;
  r ^= s;
  s = x >>8u32 3;
  r ^= s;
  return r;
}

/* σ1(x) = ROTR^17(x) ^ ROTR^19(x) ^ SHR^10(x) */
inline fn __sigma1_8x(reg u256 x) -> reg u256
{
  reg u256 r s t;

  r = x >>8u32 17;
  s = x <<8u32 15;
  r ^= s;
  s = x >>8u32 19;
  t = x <<8u32 13;
  s ^= t;
  r ^= s;
  s = x >>8u32 10;
  r ^= s;
  return r;
}

/*
 * Round t of section 6.2.2 step 3 on every lane. Variable k (a = 0 .. h =
 * 7) of round t is v[(k - t) mod 8]; wk is W_t + K_t; cc is b ^ c, the
 * a ^ b of round t - 1 (b ^ c of the initial state for round 0). Returns
 * the state and this round's a ^ b.
 */
inline fn __sha256_x8_round(reg u256[8] v, reg u256 wk cc, inline int t) -> reg u256[8], reg u256
{
  reg u256 x y;
  inline int a b d e f g h;

  a = (0 + 64 - t) % 8;
  b = (1 + 64 - t) % 8;
  d = (3 + 64 - t) % 8;
  e = (4 + 64 - t) % 8;
  f = (5 + 64 - t) % 8;
  g = (6 + 64 - t) % 8;
  h = (7 + 64 - t) % 8;

  /* T1 = h + Σ1(e) + Ch(e, f, g) + K_t + W_t, in the register of h */

  v[h] = v[h] +8u32 wk;
  x = v[f] ^ v[g];
  x &= v[e];
  x ^= v[g];
  v[h] = v[h] +8u32 x;
  x = __Sigma1_8x(v[e]);
  v[h] = v[h] +8u32 x;

  /* e' = d + T1 */

  v[d] = v[d] +8u32 v[h];

  /* a' = T1 + Σ0(a) + Maj(a, b, c) */

  x = __Sigma0_8x(v[a]);
  v[h] = v[h] +8u32 x;
  y = v[a] ^ v[b];
  cc &= y;
  cc ^= v[b];
  v[h] = v[h] +8u32 cc;

  return v, y;
}

/*
 * W_t for t >= 16 into w[t mod 16] (section 6.2.2 step 1); returns W_t.
 * The window holds W_{t-16} .. W_{t-1} at their indices mod 16.
 */
#[safety =
   { requires = is_arr_init(w, 0, 512)
   , res = { w_out, wt_out }
   , ensures = is_arr_init(w_out, 0, 512)
   }
 ]
inline fn __sha256_x8_schedule(reg mut ptr u256[16] w, inline int t) -> reg ptr u256[16], reg u256
{
  reg u256 s x wt;

  s = w[(t - 15) % 16];
  x = __sigma0_8x(s);
  wt = x +8u32 w[t % 16];
  wt = wt +8u32 w[(t - 7) % 16];
  s = w[(t - 2) % 16];
  x = __sigma1_8x(s);
  wt = wt +8u32 x;
  w[t % 16] = wt;
  return w, wt;
}

/*
 * h8 <- compress(h8, M) on every lane, with the 16 message words of the
 * eight blocks already in w, transposed and big-endian (w[j] holds M_j of
 * every lane). The window is overwritten by the schedule.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × { ptr: public, val: secret } × msf"]
#[safety =
   { requires = is_arr_init(h8, 0, 256) && is_arr_init(w, 0, 512)
   , res = { h_out, w_out, ms_out }
   , ensures = is_arr_init(h_out, 0, 256) && is_arr_init(w_out, 0, 512)
   }
 ]
fn _sha256_x8_block(
  reg mut ptr u32[64] h8,
  reg mut ptr u256[16] w,
  reg u64 ms
) -> reg ptr u32[64], reg ptr u256[16], reg u64
{
  reg ptr u32[512] kp;
  reg u256[8] v;
  reg u256 c0 c1 wk x;
  reg u64 o;
  reg bool more;
  inline int i t;

  for i = 0 to 8 {
    v[i] = h8[:u256 i];
  }
  kp = SHA256_X8_K;

  /* Rounds 0 .. 15 on the message words. c0 carries b ^ c into even rounds. */

  c0 = v[1] ^ v[2];
  for t = 0 to 16 {
    wk = w[t];
    wk = wk +8u32 kp[:u256 t];
    #[inline]
    if (t % 2 == 0) {
      v, c1 = __sha256_x8_round(v, wk, c0, t);
    } else {
      v, c0 = __sha256_x8_round(v, wk, c1, t);
    }
  }

  /*
   * Rounds 16 .. 63: three passes over rounds 16 .. 31; o is the byte
   * offset in SHA256_X8_K of K_t for the pass's first round.
   */

  o = 512;
  while { more = o <= 1536; } (more) {
    ms = #update_msf(more, ms);
    for t = 16 to 32 {
      w, wk = __sha256_x8_schedule(w, t);
      wk = wk +8u32 kp.[:u256 o + 32 * (t - 16)];
      #[inline]
      if (t % 2 == 0) {
        v, c1 = __sha256_x8_round(v, wk, c0, t);
      } else {
        v, c0 = __sha256_x8_round(v, wk, c1, t);
      }
    }
    o += 512;
  }
  ms = #update_msf(!more, ms);

  /* Step 4 */

  for i = 0 to 8 {
    x = h8[:u256 i];
    x = x +8u32 v[i];
    h8[:u256 i] = x;
  }

  return h8, w, ms;
}

/*
 * Rows r[0] .. r[7] (row k: eight words of instance k) into columns, each
 * byte-swapped: column j holds word j of the eight instances.
 */
inline fn __sha256_x8_transpose(reg u256[8] r, reg u256 mask) -> reg u256[8]
{
  reg u256[8] t;
  reg u256[8] c;
  inline int k;

  /*
   * row pairs (2i, 2i + 1): dwords 0,1 | 4,5 in t[2i], dwords 2,3 | 6,7 in
   * t[2i + 1]
   */
  for k = 0 to 4 {
    t[2 * k] = #VPUNPCKL_8u32(r[2 * k], r[2 * k + 1]);
    t[2 * k + 1] = #VPUNPCKH_8u32(r[2 * k], r[2 * k + 1]);
  }

  /*
   * row quadruples: r[m] now holds word m (low half) and m + 4 (high half)
   * of rows 0-3 or 4-7
   */
  r[0] = #VPUNPCKL_4u64(t[0], t[2]);
  r[1] = #VPUNPCKH_4u64(t[0], t[2]);
  r[2] = #VPUNPCKL_4u64(t[1], t[3]);
  r[3] = #VPUNPCKH_4u64(t[1], t[3]);
  r[4] = #VPUNPCKL_4u64(t[4], t[6]);
  r[5] = #VPUNPCKH_4u64(t[4], t[6]);
  r[6] = #VPUNPCKL_4u64(t[5], t[7]);
  r[7] = #VPUNPCKH_4u64(t[5], t[7]);

  /* halves: instances 0-3 from r[m], 4-7 from r[m + 4] */
  for k = 0 to 4 {
    c[k] = #VPERM2I128(r[k], r[k + 4], 0x20);
    c[k] = #VPSHUFB_256(c[k], mask);
    c[k + 4] = #VPERM2I128(r[k], r[k + 4], 0x31);
    c[k + 4] = #VPSHUFB_256(c[k + 4], mask);
  }

  return c;
}

#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × msf"]
#[safety =
   { requires = is_arr_init(h8, 0, 256) && is_arr_init(blocks, 0, 512)
   , res = { h_out, ms_out }
   , ensures = is_arr_init(h_out, 0, 256)
   }
 ]
fn _sha256_x8_compress(
  reg mut ptr u32[64] h8,
  reg const ptr u8[512] blocks,
  reg u64 ms
) -> reg ptr u32[64], reg u64
{
  stack u256[16] w;
  reg ptr u32[8] mask_p;
  reg u256[8] r;
  reg u256 mask;
  inline int k q;

  mask_p = SHA256_X8_BSWAP;
  mask = mask_p[:u256 0];

  /* Half q: instance k's 32 bytes at 64 k + 32 q are row k. */

  for q = 0 to 2 {
    for k = 0 to 8 {
      r[k] = blocks[:u256 2 * k + q];
    }
    r = __sha256_x8_transpose(r, mask);
    for k = 0 to 8 {
      w[8 * q + k] = r[k];
    }
  }

  h8, w, ms = _sha256_x8_block(h8, w, ms);

  return h8, ms;
}

/*
 * n whole blocks of every lane from lane memory (lane k's at in[k] + off),
 * with the interface of the portable kernel's _sha256_x8_compress_lanes.
 * Each step loads one block of every lane straight into the schedule
 * window, transposed, and runs the rounds on it; no block is copied. The
 * lane pointers are protected after every load; the table and the loop
 * state cross the call of the rounds through the stack and are protected
 * on reload.
 *
 * Residue: that of _sha256_x8_block, for the last block.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: transient } × public ×
         public × msf → { ptr: public, val: secret } × msf"]
#[safety =
   { requires = is_arr_init(h8, 0, 256) && is_arr_init(in, 0, 64)
       && n < (64u) 288230376151711744 && off < (64u) 2305843009213693952
       && is_mem_init((64u) in[0] + (64u) off, 64 * (64u) n)
       && is_mem_init((64u) in[1] + (64u) off, 64 * (64u) n)
       && is_mem_init((64u) in[2] + (64u) off, 64 * (64u) n)
       && is_mem_init((64u) in[3] + (64u) off, 64 * (64u) n)
       && is_mem_init((64u) in[4] + (64u) off, 64 * (64u) n)
       && is_mem_init((64u) in[5] + (64u) off, 64 * (64u) n)
       && is_mem_init((64u) in[6] + (64u) off, 64 * (64u) n)
       && is_mem_init((64u) in[7] + (64u) off, 64 * (64u) n)
   , res = { h_out, ms_out }
   , ensures = is_arr_init(h_out, 0, 256)
   }
 ]
fn _sha256_x8_compress_lanes(
  reg mut ptr u32[64] h8,
  reg const ptr u64[8] in,
  reg u64 off n,
  reg u64 ms
) -> reg ptr u32[64], reg u64
{
  stack u256[16] w;
  reg ptr u32[8] mask_p;
  reg u256[8] r;
  reg u256 mask;
  reg u64 p0 p1 p2 p3 p4 p5 p6 p7;
  reg bool more;
  inline int k q;

  while { more = n != 0; } (more) {
    ms = #update_msf(more, ms);
    /*
     * Loads, then protects, then offsets, so that the protects form one
     * run. Named registers rather than an array: the speculative
     * constant-time checker gives a register array one type.
     */
    p0 = in[0];
    p1 = in[1];
    p2 = in[2];
    p3 = in[3];
    p4 = in[4];
    p5 = in[5];
    p6 = in[6];
    p7 = in[7];
    p0 = #protect(p0, ms);
    p1 = #protect(p1, ms);
    p2 = #protect(p2, ms);
    p3 = #protect(p3, ms);
    p4 = #protect(p4, ms);
    p5 = #protect(p5, ms);
    p6 = #protect(p6, ms);
    p7 = #protect(p7, ms);
    p0 += off;
    p1 += off;
    p2 += off;
    p3 += off;
    p4 += off;
    p5 += off;
    p6 += off;
    p7 += off;

    mask_p = SHA256_X8_BSWAP;
    mask = mask_p[:u256 0];
    for q = 0 to 2 {
      r[0] = [:u256 p0 + 32 * q];
      r[1] = [:u256 p1 + 32 * q];
      r[2] = [:u256 p2 + 32 * q];
      r[3] = [:u256 p3 + 32 * q];
      r[4] = [:u256 p4 + 32 * q];
      r[5] = [:u256 p5 + 32 * q];
      r[6] = [:u256 p6 + 32 * q];
      r[7] = [:u256 p7 + 32 * q];
      r = __sha256_x8_transpose(r, mask);
      for k = 0 to 8 {
        w[8 * q + k] = r[k];
      }
    }

    () = #spill(in, off, n);
    h8, w, ms = _sha256_x8_block(h8, w, ms);
    () = #unspill(in, off, n);
    in = #protect_ptr(in, ms);
    off = #protect(off, ms);
    n = #protect(n, ms);

    off += 64;
    n -= 1;
  }
  ms = #update_msf(!more, ms);

  return h8, ms;
}
