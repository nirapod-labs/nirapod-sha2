/* VPSHUFB mask reversing the bytes of each qword, in both 128-bit halves. */
u64[4] SHA512_X4_BSWAP = {
  0x0001020304050607, 0x08090a0b0c0d0e0f,
  0x0001020304050607, 0x08090a0b0c0d0e0f
};

/* VPSHUFB mask rotating each qword right by 8 bits: byte i takes byte i + 1 mod 8. */
u64[4] SHA512_X4_ROR8 = {
  0x0007060504030201, 0x080f0e0d0c0b0a09,
  0x0007060504030201, 0x080f0e0d0c0b0a09
};

/* Σ0(x) = ROTR^28(x) ^ ROTR^34(x) ^ ROTR^39(x), as shifts and a tree of XORs. */
inline fn __Sigma0_4x(reg u256 x) -> reg u256
{
  reg u256 r s t;

  r = x >>4u64 28;
  s = x <<4u64 36;
  r ^= s;
  s = x >>4u64 34;
  t = x <<4u64 30;
  s ^= t;
  r ^= s;
  s = x >>4u64 39;
  t = x <<4u64 25;
  s ^= t;
  r ^= s;
  return r;
}

/* Σ1(x) = ROTR^14(x) ^ ROTR^18(x) ^ ROTR^41(x) */
inline fn __Sigma1_4x(reg u256 x) -> reg u256
{
  reg u256 r s t;

  r = x >>4u64 14;
  s = x <<4u64 50;
  r ^= s;
  s = x >>4u64 18;
  t = x <<4u64 46;
  s ^= t;
  r ^= s;
  s = x >>4u64 41;
  t = x <<4u64 23;
  s ^= t;
  r ^= s;
  return r;
}

/* σ0(x) = ROTR^1(x) ^ ROTR^8(x) ^ SHR^7(x); ror8 is SHA512_X4_ROR8. */
inline fn __sigma0_4x(reg u256 x, reg u256 ror8) -> reg u256
{
  reg u256 r s;

  r = x >>4u64 1;
  s = x <<4u64 63;
  r ^= s;
  s = #VPSHUFB_256(x, ror8);
  r ^= s;
  s = x >>4u64 7;
  r ^= s;
  return r;
}

/* σ1(x) = ROTR^19(x) ^ ROTR^61(x) ^ SHR^6(x) */
inline fn __sigma1_4x(reg u256 x) -> reg u256
{
  reg u256 r s t;

  r = x >>4u64 19;
  s = x <<4u64 45;
  r ^= s;
  s = x >>4u64 61;
  t = x <<4u64 3;
  s ^= t;
  r ^= s;
  s = x >>4u64 6;
  r ^= s;
  return r;
}

/*
 * Round t of section 6.4.2 step 3 on every lane. Variable k (a = 0 .. h =
 * 7) of round t is v[(k - t) mod 8]; wk is W_t + K_t; cc is b ^ c, the
 * a ^ b of round t - 1 (b ^ c of the initial state for round 0). Returns
 * the state and this round's a ^ b.
 */
inline fn __sha512_x4_round(reg u256[8] v, reg u256 wk cc, inline int t) -> reg u256[8], reg u256
{
  reg u256 x y;
  inline int a b d e f g h;

  a = (0 + 80 - t) % 8;
  b = (1 + 80 - t) % 8;
  d = (3 + 80 - t) % 8;
  e = (4 + 80 - t) % 8;
  f = (5 + 80 - t) % 8;
  g = (6 + 80 - t) % 8;
  h = (7 + 80 - t) % 8;

  /* T1 = h + Σ1(e) + Ch(e, f, g) + K_t + W_t, in the register of h */

  v[h] = v[h] +4u64 wk;
  x = v[f] ^ v[g];
  x &= v[e];
  x ^= v[g];
  v[h] = v[h] +4u64 x;
  x = __Sigma1_4x(v[e]);
  v[h] = v[h] +4u64 x;

  /* e' = d + T1 */

  v[d] = v[d] +4u64 v[h];

  /* a' = T1 + Σ0(a) + Maj(a, b, c) */

  x = __Sigma0_4x(v[a]);
  v[h] = v[h] +4u64 x;
  y = v[a] ^ v[b];
  cc &= y;
  cc ^= v[b];
  v[h] = v[h] +4u64 cc;

  return v, y;
}

/*
 * W_t for t >= 16 into w[t mod 16] (section 6.4.2 step 1); returns W_t.
 * The window holds W_{t-16} .. W_{t-1} at their indices mod 16.
 */
#[safety =
   { requires = is_arr_init(w, 0, 512)
   , res = { w_out, wt_out }
   , ensures = is_arr_init(w_out, 0, 512)
   }
 ]
inline fn __sha512_x4_schedule(reg mut ptr u256[16] w, inline int t, reg u256 ror8)
  -> reg ptr u256[16], reg u256
{
  reg u256 s x wt;

  s = w[(t - 15) % 16];
  x = __sigma0_4x(s, ror8);
  wt = x +4u64 w[t % 16];
  wt = wt +4u64 w[(t - 7) % 16];
  s = w[(t - 2) % 16];
  x = __sigma1_4x(s);
  wt = wt +4u64 x;
  w[t % 16] = wt;
  return w, wt;
}

/*
 * h4 <- compress(h4, M) on every lane, with the 16 message words of the
 * four blocks already in w, transposed and big-endian (w[j] holds M_j of
 * every lane). The window is overwritten by the schedule.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × { ptr: public, val: secret } × msf"]
#[safety =
   { requires = is_arr_init(h4, 0, 256) && is_arr_init(w, 0, 512)
   , res = { h_out, w_out, ms_out }
   , ensures = is_arr_init(h_out, 0, 256) && is_arr_init(w_out, 0, 512)
   }
 ]
fn _sha512_x4_block(
  reg mut ptr u64[32] h4,
  reg mut ptr u256[16] w,
  reg u64 ms
) -> reg ptr u64[32], reg ptr u256[16], reg u64
{
  reg ptr u64[320] kp;
  reg ptr u64[4] mp;
  reg u256[8] v;
  reg u256 c0 c1 wk ror8 x;
  reg u64 o;
  reg bool more;
  inline int i t;

  for i = 0 to 8 {
    v[i] = h4[:u256 i];
  }
  kp = SHA512_X4_K;
  mp = SHA512_X4_ROR8;
  ror8 = mp[:u256 0];

  /* Rounds 0 .. 15 on the message words. c0 carries b ^ c into even rounds. */

  c0 = v[1] ^ v[2];
  for t = 0 to 16 {
    wk = w[t];
    wk = wk +4u64 kp[:u256 t];
    #[inline]
    if (t % 2 == 0) {
      v, c1 = __sha512_x4_round(v, wk, c0, t);
    } else {
      v, c0 = __sha512_x4_round(v, wk, c1, t);
    }
  }

  /*
   * Rounds 16 .. 79: four passes over rounds 16 .. 31; o is the byte
   * offset in SHA512_X4_K of K_t for the pass's first round.
   */

  o = 512;
  while { more = o <= 2048; } (more) {
    ms = #update_msf(more, ms);
    for t = 16 to 32 {
      w, wk = __sha512_x4_schedule(w, t, ror8);
      wk = wk +4u64 kp.[:u256 o + 32 * (t - 16)];
      #[inline]
      if (t % 2 == 0) {
        v, c1 = __sha512_x4_round(v, wk, c0, t);
      } else {
        v, c0 = __sha512_x4_round(v, wk, c1, t);
      }
    }
    o += 512;
  }
  ms = #update_msf(!more, ms);

  /* Step 4 */

  for i = 0 to 8 {
    x = h4[:u256 i];
    x = x +4u64 v[i];
    h4[:u256 i] = x;
  }

  return h4, w, ms;
}

/*
 * Rows r0 .. r3 (row k: four words of instance k) into columns, each
 * byte-swapped: column j holds word j of the four instances.
 */
inline fn __sha512_x4_transpose(reg u256 r0 r1 r2 r3 mask)
  -> reg u256, reg u256, reg u256, reg u256
{
  reg u256 t0 t1 t2 t3 c0 c1 c2 c3;

  /* row pairs: qwords 0 | 2 in t0, t2; qwords 1 | 3 in t1, t3 */
  t0 = #VPUNPCKL_4u64(r0, r1);
  t1 = #VPUNPCKH_4u64(r0, r1);
  t2 = #VPUNPCKL_4u64(r2, r3);
  t3 = #VPUNPCKH_4u64(r2, r3);

  /* halves: instances 0-1 from t0, t1; 2-3 from t2, t3 */
  c0 = #VPERM2I128(t0, t2, 0x20);
  c0 = #VPSHUFB_256(c0, mask);
  c1 = #VPERM2I128(t1, t3, 0x20);
  c1 = #VPSHUFB_256(c1, mask);
  c2 = #VPERM2I128(t0, t2, 0x31);
  c2 = #VPSHUFB_256(c2, mask);
  c3 = #VPERM2I128(t1, t3, 0x31);
  c3 = #VPSHUFB_256(c3, mask);
  return c0, c1, c2, c3;
}

#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } × msf →
         { ptr: public, val: secret } × msf"]
#[safety =
   { requires = is_arr_init(h4, 0, 256) && is_arr_init(blocks, 0, 512)
   , res = { h_out, ms_out }
   , ensures = is_arr_init(h_out, 0, 256)
   }
 ]
fn _sha512_x4_compress(
  reg mut ptr u64[32] h4,
  reg const ptr u8[512] blocks,
  reg u64 ms
) -> reg ptr u64[32], reg u64
{
  stack u256[16] w;
  reg ptr u64[4] mask_p;
  reg u256 mask r0 r1 r2 r3;
  inline int q;

  mask_p = SHA512_X4_BSWAP;
  mask = mask_p[:u256 0];

  /* Quarter q: instance k's 32 bytes at 128 k + 32 q are row k. */

  for q = 0 to 4 {
    r0 = blocks[:u256 q];
    r1 = blocks[:u256 4 + q];
    r2 = blocks[:u256 8 + q];
    r3 = blocks[:u256 12 + q];
    r0, r1, r2, r3 = __sha512_x4_transpose(r0, r1, r2, r3, mask);
    w[4 * q] = r0;
    w[4 * q + 1] = r1;
    w[4 * q + 2] = r2;
    w[4 * q + 3] = r3;
  }

  h4, w, ms = _sha512_x4_block(h4, w, ms);

  return h4, ms;
}

/*
 * n whole blocks of every lane from lane memory (lane k's at in[k] + off),
 * with the interface of the portable kernel's _sha512_x4_compress_lanes.
 * Each step loads one block of every lane straight into the schedule
 * window, transposed, and runs the rounds on it; no block is copied. The
 * lane pointers are protected after every load; the table and the loop
 * state cross the call of the rounds through the stack and are protected
 * on reload.
 *
 * Residue: that of _sha512_x4_block, for the last block.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: transient } × public ×
         public × msf → { ptr: public, val: secret } × msf"]
#[safety =
   { requires = is_arr_init(h4, 0, 256) && is_arr_init(in, 0, 32)
       && n < (64u) 144115188075855872 && off < (64u) 2305843009213693952
       && is_mem_init((64u) in[0] + (64u) off, 128 * (64u) n)
       && is_mem_init((64u) in[1] + (64u) off, 128 * (64u) n)
       && is_mem_init((64u) in[2] + (64u) off, 128 * (64u) n)
       && is_mem_init((64u) in[3] + (64u) off, 128 * (64u) n)
   , res = { h_out, ms_out }
   , ensures = is_arr_init(h_out, 0, 256)
   }
 ]
fn _sha512_x4_compress_lanes(
  reg mut ptr u64[32] h4,
  reg const ptr u64[4] in,
  reg u64 off n,
  reg u64 ms
) -> reg ptr u64[32], reg u64
{
  stack u256[16] w;
  reg ptr u64[4] mask_p;
  reg u256 mask r0 r1 r2 r3;
  reg u64 p0 p1 p2 p3;
  reg bool more;
  inline int q;

  while { more = n != 0; } (more) {
    ms = #update_msf(more, ms);
    /*
     * Loads, then protects, then offsets, so that the protects form one
     * run. Named registers rather than an array: the speculative
     * constant-time checker gives a register array one type.
     */
    p0 = in[0];
    p1 = in[1];
    p2 = in[2];
    p3 = in[3];
    p0 = #protect(p0, ms);
    p1 = #protect(p1, ms);
    p2 = #protect(p2, ms);
    p3 = #protect(p3, ms);
    p0 += off;
    p1 += off;
    p2 += off;
    p3 += off;

    mask_p = SHA512_X4_BSWAP;
    mask = mask_p[:u256 0];
    for q = 0 to 4 {
      r0 = [:u256 p0 + 32 * q];
      r1 = [:u256 p1 + 32 * q];
      r2 = [:u256 p2 + 32 * q];
      r3 = [:u256 p3 + 32 * q];
      r0, r1, r2, r3 = __sha512_x4_transpose(r0, r1, r2, r3, mask);
      w[4 * q] = r0;
      w[4 * q + 1] = r1;
      w[4 * q + 2] = r2;
      w[4 * q + 3] = r3;
    }

    () = #spill(in, off, n);
    h4, w, ms = _sha512_x4_block(h4, w, ms);
    () = #unspill(in, off, n);
    in = #protect_ptr(in, ms);
    off = #protect(off, ms);
    n = #protect(n, ms);

    off += 128;
    n -= 1;
  }
  ms = #update_msf(!more, ms);

  return h4, ms;
}
