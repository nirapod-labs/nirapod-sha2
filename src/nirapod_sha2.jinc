  ctx, out, status, ms = _sha256_ctx::_sha2_ctx_final(ctx, out, expect, ms);

  return ctx, out, status;
}

#[ct = "secret -> secret"]
#[sct = "{ ptr: transient, val: secret } → { ptr: transient, val: secret }"]
#[safety =
   { res = { ctx_out }
   , ensures = is_arr_init(ctx_out, 0, SHA512_CTX_BYTES)
   }
 ]
