/*
 * SPDX-FileCopyrightText: nirapod-sha2 contributors
 * SPDX-License-Identifier: Apache-2.0
 *
 * nirapod_sha2.jinc
 * =================
 *
 * Every export of the library: the boundary between the C layer (capi/)
 * and the Jasmin implementation. The build compiles this file once per
 * architecture and kernel variant, wrapped in the namespace
 * nirapod_sha2_jz_<arch>_<variant>, so export `op` becomes the symbol
 * nirapod_sha2_jz_<arch>_<variant>__op (capi/jasmin.h). The kernels of a
 * unit come from its include roots (src/README.md); this file names none.
 *
 *     sha224, sha256, sha384, sha512,     one-shot hash of a message in
 *     sha512_224, sha512_256               memory (FIPS 180-4 section 6)
 *
 *     <hash>_init, <hash>_update,         incremental hash over a context
 *     <hash>_final                         (context.jinc)
 *
 *     hmac_sha256, hmac_sha512            one-shot HMAC (FIPS 198-1)
 *     hmac_<hash>_init, _update, _final   incremental HMAC over a context
 *
 *     sha256_x8, sha512_x4                SHA-256 of 8, SHA-512 of 4
 *                                          equal-length messages, one per
 *                                          lane pointer, one-shot
 *     sha256_x8_<op>, sha512_x4_<op>      incremental multi-way hash over a
 *                                          multi-way context (context_x.jinc)
 *
 * Each export is a short composition of functions in the other files of
 * src/, so that its correctness reduces to theirs.
 *
 * Calling convention (all exports)
 *
 *     An array argument is a pointer to exactly the stated number of
 *     bytes, with no alignment requirement. in, key and msg point to inlen,
 *     keylen and msglen readable bytes; they are not read when the length
 *     is 0, so any pointer will do then. Outputs receive exactly the digest
 *     or tag length: 28, 32, 48, 64, 28 and 32 bytes for the six hash
 *     functions, 32 and 64 for the two HMACs, 8 x 32 and 4 x 64 for the
 *     multi-way forms.
 *
 *     Contexts are 112 bytes (SHA-224, SHA-256), 208 (SHA-384, SHA-512,
 *     SHA-512/224, SHA-512/256), 144 (HMAC-SHA-256) and 272 (HMAC-SHA-512)
 *     of caller memory, laid out as context.jinc describes.
 *
 *     No output or context may overlap any input or another output. The C
 *     layer refuses overlapping buffers before it calls an export.
 *
 * Lengths
 *
 *     A one-shot export needs inlen < 2^61 (multi-way: len < 2^61; HMAC:
 *     keylen < 2^61 and msglen < 2^61 - B, B the block size). These are the
 *     domain of the SHA-2 length field and of the proofs; the C layer
 *     checks them. Update checks its own limit against the total stored in
 *     the context, which the C layer cannot read.
 *
 * Results
 *
 *     update and final return SHA2_STATUS_OK (0), SHA2_STATUS_STATE (1:
 *     the context is not one of this function, or was finalised) or
 *     SHA2_STATUS_LENGTH (2: the total would reach 2^61). On a result other
 *     than 0 nothing is written. The other exports cannot fail and return
 *     nothing.
 *
 * Classification
 *
 *     Message, key, context contents, digest and tag are secret; pointers
 *     and lengths are public. The only releases are the tag and total of a
 *     context (__sha2_ctx_open in context.jinc), which are public by
 *     construction. The status is computed from them and is public.
 *
 * Speculation
 *
 *     An export can be entered under misspeculation with any register
 *     values, so the SCT annotations type its pointer and length
 *     arguments transient, and each export starts with #init_msf before
 *     it uses any of them. #init_msf is a fence (LFENCE on x86-64, DSB SY
 *     and ISB on AArch64): no later instruction runs until every earlier
 *     one, branches included, has resolved, so the arguments it leaves in
 *     registers are their architectural values. The type checker models
 *     this by making every transient value public at the fence, which is
 *     why no argument is protected again after it. Protects come only
 *     where a value is reloaded from memory, after a call.
 *
 * Stack
 *
 *     The functions below leave secret-derived data in their frames
 *     (src/README.md, "Residue"). The build compiles every unit with
 *     -stack-zero, so each export clears the stack it used before it
 *     returns.
 */

from Hash require "sha256.jinc"
from Hash require "sha512.jinc"
from Hash require "hmac.jinc"
from Hash require "context.jinc"
from Hash require "hmac_mem.jinc"
from Hash require "context_x.jinc"

/*
 * One-shot hashes
 * ===============
 *
 * The digest of the inlen bytes at in. Every function finishes straight
 * into out, which receives exactly the digest: a truncated function's
 * finalize writes only the left-most bytes that FIPS 180-4 keeps
 * (sha256_DSIZE.jinc, sha512_DSIZE.jinc).
 */

#[ct = "secret × public × public -> secret"]
#[sct = "{ ptr: transient, val: secret } × transient × transient →
         { ptr: transient, val: secret }"]
#[safety =
   { requires = is_mem_init((64u) in, (64u) inlen)
   , res = { out_out }
   , ensures = is_arr_init(out_out, 0, 28)
   }
 ]
export fn sha224(reg mut ptr u8[28] out, reg u64 in inlen) -> reg ptr u8[28]
{
  reg u64 ms;

  ms = #init_msf();

  out, ms = _sha224_mem(out, in, inlen, ms);

  return out;
}

#[ct = "secret × public × public -> secret"]
#[sct = "{ ptr: transient, val: secret } × transient × transient →
         { ptr: transient, val: secret }"]
#[safety =
   { requires = is_mem_init((64u) in, (64u) inlen)
   , res = { out_out }
   , ensures = is_arr_init(out_out, 0, 32)
   }
 ]
export fn sha256(reg mut ptr u8[32] out, reg u64 in inlen) -> reg ptr u8[32]
{
  reg u64 ms;

  ms = #init_msf();

  out, ms = _sha256_mem(out, in, inlen, ms);

  return out;
}

#[ct = "secret × public × public -> secret"]
#[sct = "{ ptr: transient, val: secret } × transient × transient →
         { ptr: transient, val: secret }"]
#[safety =
   { requires = is_mem_init((64u) in, (64u) inlen)
   , res = { out_out }
   , ensures = is_arr_init(out_out, 0, 48)
   }
 ]
export fn sha384(reg mut ptr u8[48] out, reg u64 in inlen) -> reg ptr u8[48]
{
  reg u64 ms;

  ms = #init_msf();

  out, ms = _sha384_mem(out, in, inlen, ms);

  return out;
}

#[ct = "secret × public × public -> secret"]
#[sct = "{ ptr: transient, val: secret } × transient × transient →
         { ptr: transient, val: secret }"]
#[safety =
   { requires = is_mem_init((64u) in, (64u) inlen)
   , res = { out_out }
   , ensures = is_arr_init(out_out, 0, 64)
   }
 ]
export fn sha512(reg mut ptr u8[64] out, reg u64 in inlen) -> reg ptr u8[64]
{
  reg u64 ms;

  ms = #init_msf();

  out, ms = _sha512_mem(out, in, inlen, ms);

  return out;
}

#[ct = "secret × public × public -> secret"]
#[sct = "{ ptr: transient, val: secret } × transient × transient →
         { ptr: transient, val: secret }"]
#[safety =
   { requires = is_mem_init((64u) in, (64u) inlen)
   , res = { out_out }
   , ensures = is_arr_init(out_out, 0, 28)
   }
 ]
export fn sha512_224(reg mut ptr u8[28] out, reg u64 in inlen) -> reg ptr u8[28]
{
  reg u64 ms;

  ms = #init_msf();

  out, ms = _sha512_224_mem(out, in, inlen, ms);

  return out;
}

#[ct = "secret × public × public -> secret"]
#[sct = "{ ptr: transient, val: secret } × transient × transient →
         { ptr: transient, val: secret }"]
#[safety =
   { requires = is_mem_init((64u) in, (64u) inlen)
   , res = { out_out }
   , ensures = is_arr_init(out_out, 0, 32)
   }
 ]
export fn sha512_256(reg mut ptr u8[32] out, reg u64 in inlen) -> reg ptr u8[32]
{
  reg u64 ms;

  ms = #init_msf();

  out, ms = _sha512_256_mem(out, in, inlen, ms);

  return out;
}

/*
 * Incremental hashes
 * ==================
 *
 * init writes a whole context; update appends inlen bytes at in; final
 * writes the digest and zeroes the context. Contracts in context.jinc
 * (_sha256_ctx_update, _sha512_ctx_update) and context_DSIZE.jinc
 * (_sha2_ctx_final, one instance per function). Final writes out only
 * after the context's checks have passed, so a failing final writes
 * nothing to out.
 */

#[ct = "secret -> secret"]
#[sct = "{ ptr: transient, val: secret } → { ptr: transient, val: secret }"]
#[safety =
   { res = { ctx_out }
   , ensures = is_arr_init(ctx_out, 0, SHA256_CTX_BYTES)
   }
 ]
export fn sha224_init(reg mut ptr u8[SHA256_CTX_BYTES] ctx) -> reg ptr u8[SHA256_CTX_BYTES]
{
  stack u32[8] h;
  reg u64 ms tag total;

  ms = #init_msf();

  h = __sha224_init(h);
  tag = __sha2_tag(SHA2_FN_SHA224);
  total = 0;
  ctx = __sha256_ctx_init(ctx, h, tag, total);

  return ctx;
}

#[ct = "secret × public × public -> secret × public"]
#[sct = "{ ptr: transient, val: secret } × transient × transient →
         { ptr: transient, val: secret } × public"]
#[safety =
   { requires = is_arr_init(ctx, 0, SHA256_CTX_BYTES) && is_mem_init((64u) in, (64u) inlen)
   , res = { ctx_out, status }
   , ensures = is_arr_init(ctx_out, 0, SHA256_CTX_BYTES)
   }
 ]
export fn sha224_update(reg mut ptr u8[SHA256_CTX_BYTES] ctx, reg u64 in inlen) -> reg ptr u8[SHA256_CTX_BYTES], reg u64
{
  reg u64 ms expect status;

  ms = #init_msf();

  expect = __sha2_tag(SHA2_FN_SHA224);
  ctx, status, ms = _sha256_ctx_update(ctx, in, inlen, expect, ms);

  return ctx, status;
}

#[ct = "secret × secret -> secret × secret × public"]
#[sct = "{ ptr: transient, val: secret } × { ptr: transient, val: secret } →
         { ptr: transient, val: secret } × { ptr: transient, val: secret } × public"]
#[safety =
   { requires = is_arr_init(ctx, 0, SHA256_CTX_BYTES)
   , res = { ctx_out, out_out, status }
   , ensures = is_arr_init(ctx_out, 0, SHA256_CTX_BYTES)
       && is_arr_init(out_out, 0, status == SHA2_STATUS_OK ? 28 : 0)
   }
 ]
export fn sha224_final(reg mut ptr u8[SHA256_CTX_BYTES] ctx, reg mut ptr u8[28] out)
  -> reg ptr u8[SHA256_CTX_BYTES], reg ptr u8[28], reg u64
{
  reg u64 ms expect status;

  ms = #init_msf();

  expect = __sha2_tag(SHA2_FN_SHA224);
  ctx, out, status, ms = _sha224_ctx::_sha2_ctx_final(ctx, out, expect, ms);

  return ctx, out, status;
}

#[ct = "secret -> secret"]
#[sct = "{ ptr: transient, val: secret } → { ptr: transient, val: secret }"]
#[safety =
   { res = { ctx_out }
   , ensures = is_arr_init(ctx_out, 0, SHA256_CTX_BYTES)
   }
 ]
export fn sha256_init(reg mut ptr u8[SHA256_CTX_BYTES] ctx) -> reg ptr u8[SHA256_CTX_BYTES]
{
  stack u32[8] h;
  reg u64 ms tag total;

  ms = #init_msf();

  h = __sha256_init(h);
  tag = __sha2_tag(SHA2_FN_SHA256);
  total = 0;
  ctx = __sha256_ctx_init(ctx, h, tag, total);

  return ctx;
}

#[ct = "secret × public × public -> secret × public"]
#[sct = "{ ptr: transient, val: secret } × transient × transient →
         { ptr: transient, val: secret } × public"]
#[safety =
   { requires = is_arr_init(ctx, 0, SHA256_CTX_BYTES) && is_mem_init((64u) in, (64u) inlen)
   , res = { ctx_out, status }
   , ensures = is_arr_init(ctx_out, 0, SHA256_CTX_BYTES)
   }
 ]
export fn sha256_update(reg mut ptr u8[SHA256_CTX_BYTES] ctx, reg u64 in inlen) -> reg ptr u8[SHA256_CTX_BYTES], reg u64
{
  reg u64 ms expect status;

  ms = #init_msf();

  expect = __sha2_tag(SHA2_FN_SHA256);
  ctx, status, ms = _sha256_ctx_update(ctx, in, inlen, expect, ms);

  return ctx, status;
}

#[ct = "secret × secret -> secret × secret × public"]
#[sct = "{ ptr: transient, val: secret } × { ptr: transient, val: secret } →
         { ptr: transient, val: secret } × { ptr: transient, val: secret } × public"]
#[safety =
   { requires = is_arr_init(ctx, 0, SHA256_CTX_BYTES)
   , res = { ctx_out, out_out, status }
   , ensures = is_arr_init(ctx_out, 0, SHA256_CTX_BYTES)
       && is_arr_init(out_out, 0, status == SHA2_STATUS_OK ? 32 : 0)
   }
 ]
export fn sha256_final(reg mut ptr u8[SHA256_CTX_BYTES] ctx, reg mut ptr u8[32] out)
  -> reg ptr u8[SHA256_CTX_BYTES], reg ptr u8[32], reg u64
{
