  key = #protect(key, ms);
  keylen = #protect(keylen, ms);

  ctx, ms = __hmac_sha512_ctx_init(ctx, key, keylen, ms);

  return ctx;
}

#[ct = "secret × public × public -> secret × public"]
#[sct = "{ ptr: transient, val: secret } × transient × transient →
         { ptr: transient, val: secret } × public"]
#[safety =
   { requires = is_arr_init(ctx, 0, HMAC_SHA512_CTX_BYTES) && is_mem_init((64u) in, (64u) inlen)
   }
 ]
export fn hmac_sha512_update(reg mut ptr u8[HMAC_SHA512_CTX_BYTES] ctx, reg u64 in inlen)
  -> reg ptr u8[HMAC_SHA512_CTX_BYTES], reg u64
{
  reg u64 ms expect status;

  ms = #init_msf();
  ctx = #protect_ptr(ctx, ms);
  in = #protect(in, ms);
  inlen = #protect(inlen, ms);

  expect = __sha2_tag(SHA2_FN_HMAC_SHA512);
  ctx[0:SHA512_CTX_BYTES], status, ms =
    _sha512_ctx_update(ctx[0:SHA512_CTX_BYTES], in, inlen, expect, ms);

  return ctx, status;
}

#[ct = "secret × secret -> secret × secret × public"]
#[sct = "{ ptr: transient, val: secret } × { ptr: transient, val: secret } →
         { ptr: transient, val: secret } × { ptr: transient, val: secret } × public"]
#[safety =
   { requires = is_arr_init(ctx, 0, HMAC_SHA512_CTX_BYTES)
   }
 ]
export fn hmac_sha512_final(reg mut ptr u8[HMAC_SHA512_CTX_BYTES] ctx, reg mut ptr u8[64] out)
  -> reg ptr u8[HMAC_SHA512_CTX_BYTES], reg ptr u8[64], reg u64
{
  reg u64 ms status;

  ms = #init_msf();
  ctx = #protect_ptr(ctx, ms);
  out = #protect_ptr(out, ms);

  ctx, out, status, ms = __hmac_sha512_ctx_final(ctx, out, ms);

  return ctx, out, status;
}

/*
 * Multi-way hashes
 * ================
 *
 * Message k is the len bytes at in + k len; digest k goes to out at 32k
 * (SHA-256) or 64k (SHA-512). The kernel is the unit's Sha2KernelX: the
 * AVX2 kernels in the x86-64 avx2 unit, otherwise one single-way
 * compression per message (sha256_x8_mem.jinc, sha512_x4_mem.jinc).
 */

#[ct = "secret × public × public -> secret"]
#[sct = "{ ptr: transient, val: secret } × transient × transient →
         { ptr: transient, val: secret }"]
#[safety =
   { requires = len < (64u) 2305843009213693952 && is_mem_init((64u) in, 8 * (64u) len)
   , res = { out_out }
   , ensures = is_arr_init(out_out, 0, 256)
   }
 ]
export fn sha256_x8(reg mut ptr u8[256] out, reg u64 in len) -> reg ptr u8[256]
{
  reg u64 ms;

  ms = #init_msf();
  out = #protect_ptr(out, ms);
  in = #protect(in, ms);
  len = #protect(len, ms);

  out, ms = _sha256_x8_mem(out, in, len, ms);

  return out;
}

#[ct = "secret × public × public -> secret"]
#[sct = "{ ptr: transient, val: secret } × transient × transient →
         { ptr: transient, val: secret }"]
#[safety =
   { requires = len < (64u) 2305843009213693952 && is_mem_init((64u) in, 4 * (64u) len)
   , res = { out_out }
   , ensures = is_arr_init(out_out, 0, 256)
   }
 ]
export fn sha512_x4(reg mut ptr u8[256] out, reg u64 in len) -> reg ptr u8[256]
{
  reg u64 ms;

  ms = #init_msf();
  out = #protect_ptr(out, ms);
  in = #protect(in, ms);
  len = #protect(len, ms);

  out, ms = _sha512_x4_mem(out, in, len, ms);

  return out;
}
