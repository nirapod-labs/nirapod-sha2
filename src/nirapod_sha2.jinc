}

#[ct = "secret × public × public -> secret × public"]
#[sct = "{ ptr: transient, val: secret } × transient × transient →
         { ptr: transient, val: secret } × public"]
#[safety =
   { requires = is_arr_init(ctx, 0, SHA512_CTX_BYTES) && is_mem_init((64u) in, (64u) inlen)
   , res = { ctx_out, status }
   , ensures = is_arr_init(ctx_out, 0, SHA512_CTX_BYTES)
   }
 ]
export fn sha384_update(reg mut ptr u8[SHA512_CTX_BYTES] ctx, reg u64 in inlen) -> reg ptr u8[SHA512_CTX_BYTES], reg u64
