/*
 * Multi-way hashes
 * ================
 *
 * 8 SHA-256 or 4 SHA-512 hashes of equal-length messages, lane k's
 * message at the pointer in[k] of a table, digest k at 32 k (64 k) of
 * out. The C layer checks the pointers and passes its own copy of the
 * table. One-shot, and incremental over a multi-way context
 * (context_x.jinc): init, init_from (every lane continues one single-way
 * context), update, final. The kernels are the unit's Sha256KernelX and
 * Sha512KernelX, which src/README.md lists per unit: lanes in vector
 * registers, lanes interleaved on the SHA instructions, or one single-way
 * compression per lane.
 *
 * Results of init_from, update and final as for the single-way contexts;
 * on a result other than 0 nothing is written.
 */

#[ct = "secret × public × public -> secret"]
#[sct = "{ ptr: transient, val: secret } × { ptr: transient, val: transient } × transient →
         { ptr: transient, val: secret }"]
#[safety =
   { requires = len < (64u) 2305843009213693952 && is_arr_init(in, 0, 64)
       && is_mem_init((64u) in[0], (64u) len)
       && is_mem_init((64u) in[1], (64u) len)
       && is_mem_init((64u) in[2], (64u) len)
       && is_mem_init((64u) in[3], (64u) len)
       && is_mem_init((64u) in[4], (64u) len)
       && is_mem_init((64u) in[5], (64u) len)
       && is_mem_init((64u) in[6], (64u) len)
       && is_mem_init((64u) in[7], (64u) len)
   , res = { out_out }
   , ensures = is_arr_init(out_out, 0, 256)
   }
 ]
export fn sha256_x8(reg mut ptr u8[256] out, reg const ptr u64[8] in, reg u64 len)
  -> reg ptr u8[256]
{
  reg u64 ms;

  ms = #init_msf();

  out, ms = _sha256_x8_lanes(out, in, len, ms);

  return out;
}

#[ct = "secret -> secret"]
#[sct = "{ ptr: transient, val: secret } → { ptr: transient, val: secret }"]
#[safety =
   { res = { ctx_out }
   , ensures = is_arr_init(ctx_out, 0, SHA256_X8_CTX_BYTES)
   }
 ]
