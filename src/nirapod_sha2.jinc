}

#[ct = "secret × secret -> secret × secret × public"]
#[sct = "{ ptr: transient, val: secret } × { ptr: transient, val: secret } →
         { ptr: transient, val: secret } × { ptr: transient, val: secret } × public"]
#[safety =
   { requires = is_arr_init(ctx, 0, SHA512_CTX_BYTES)
   }
 ]
export fn sha384_final(reg mut ptr u8[SHA512_CTX_BYTES] ctx, reg mut ptr u8[48] out)
  -> reg ptr u8[SHA512_CTX_BYTES], reg ptr u8[48], reg u64
{
  stack u8[64] d;
  reg u64 ms expect status;
  reg bool ok;

  ms = #init_msf();
  ctx = #protect_ptr(ctx, ms);
  out = #protect_ptr(out, ms);

  expect = __sha2_tag(SHA2_FN_SHA384);
  () = #spill(out);
  ctx, d, status, ms = _sha512_ctx_final(ctx, d, expect, ms);
  () = #unspill(out);
  out = #protect_ptr(out, ms);

  ok = status == SHA2_STATUS_OK;
  if (ok) {
    ms = #update_msf(ok, ms);
    out = __digest48_of64(out, d);
  } else {
    ms = #update_msf(!ok, ms);
  }

  return ctx, out, status;
}

#[ct = "secret -> secret"]
#[sct = "{ ptr: transient, val: secret } → { ptr: transient, val: secret }"]
#[safety =
   { res = { ctx_out }
   , ensures = is_arr_init(ctx_out, 0, SHA512_CTX_BYTES)
   }
 ]
export fn sha512_init(reg mut ptr u8[SHA512_CTX_BYTES] ctx) -> reg ptr u8[SHA512_CTX_BYTES]
{
  stack u64[8] h;
  reg u64 ms tag total;

  ms = #init_msf();
  ctx = #protect_ptr(ctx, ms);

  h = __sha512_init(h);
  tag = __sha2_tag(SHA2_FN_SHA512);
  total = 0;
