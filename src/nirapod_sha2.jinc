#[ct = "secret × public × public -> secret × public"]
#[sct = "{ ptr: transient, val: secret } × transient × transient →
         { ptr: transient, val: secret } × public"]
#[safety =
   { requires = is_arr_init(ctx, 0, SHA512_CTX_BYTES) && is_mem_init((64u) in, (64u) inlen)
   , res = { ctx_out, status }
   , ensures = is_arr_init(ctx_out, 0, SHA512_CTX_BYTES)
   }
 ]
export fn sha512_256_update(reg mut ptr u8[SHA512_CTX_BYTES] ctx, reg u64 in inlen) -> reg ptr u8[SHA512_CTX_BYTES], reg u64
{
  reg u64 ms expect status;

  ms = #init_msf();
  ctx = #protect_ptr(ctx, ms);
  in = #protect(in, ms);
  inlen = #protect(inlen, ms);

  expect = __sha2_tag(SHA2_FN_SHA512_256);
  ctx, status, ms = _sha512_ctx_update(ctx, in, inlen, expect, ms);

  return ctx, status;
}

#[ct = "secret × secret -> secret × secret × public"]
#[sct = "{ ptr: transient, val: secret } × { ptr: transient, val: secret } →
         { ptr: transient, val: secret } × { ptr: transient, val: secret } × public"]
#[safety =
   { requires = is_arr_init(ctx, 0, SHA512_CTX_BYTES)
   }
 ]
export fn sha512_256_final(reg mut ptr u8[SHA512_CTX_BYTES] ctx, reg mut ptr u8[32] out)
  -> reg ptr u8[SHA512_CTX_BYTES], reg ptr u8[32], reg u64
{
  stack u8[64] d;
  reg u64 ms expect status;
  reg bool ok;

  ms = #init_msf();
  ctx = #protect_ptr(ctx, ms);
  out = #protect_ptr(out, ms);

  expect = __sha2_tag(SHA2_FN_SHA512_256);
  () = #spill(out);
  ctx, d, status, ms = _sha512_ctx_final(ctx, d, expect, ms);
  () = #unspill(out);
  out = #protect_ptr(out, ms);

  ok = status == SHA2_STATUS_OK;
  if (ok) {
    ms = #update_msf(ok, ms);
    out = __digest32_of64(out, d);
  } else {
    ms = #update_msf(!ok, ms);
  }

  return ctx, out, status;
}

/*
 * HMAC
 * ====
 *
 * One-shot: hmac_mem.jinc. Incremental: init forms the inner and
 * outer states from the key, update appends to the inner hash with the
 * hash's own update (the HMAC context begins with a hash context), and
 * final finishes both hashes (context.jinc).
 */

#[ct = "secret × public × public × public × public -> secret"]
#[sct = "{ ptr: transient, val: secret } × transient × transient × transient × transient →
         { ptr: transient, val: secret }"]
#[safety =
   { requires = is_mem_init((64u) key, (64u) keylen) && is_mem_init((64u) msg, (64u) msglen)
   , res = { out_out }
   , ensures = is_arr_init(out_out, 0, 32)
   }
 ]
export fn hmac_sha256(reg mut ptr u8[32] out, reg u64 key keylen msg msglen) -> reg ptr u8[32]
{
  reg u64 ms;

  ms = #init_msf();
  out = #protect_ptr(out, ms);
  key = #protect(key, ms);
  keylen = #protect(keylen, ms);
  msg = #protect(msg, ms);
  msglen = #protect(msglen, ms);

  out, ms = _hmac_sha256_mem(out, key, keylen, msg, msglen, ms);

  return out;
}

#[ct = "secret × public × public × public × public -> secret"]
#[sct = "{ ptr: transient, val: secret } × transient × transient × transient × transient →
         { ptr: transient, val: secret }"]
#[safety =
   { requires = is_mem_init((64u) key, (64u) keylen) && is_mem_init((64u) msg, (64u) msglen)
   , res = { out_out }
   , ensures = is_arr_init(out_out, 0, 64)
   }
 ]
export fn hmac_sha512(reg mut ptr u8[64] out, reg u64 key keylen msg msglen) -> reg ptr u8[64]
{
  reg u64 ms;

  ms = #init_msf();
  out = #protect_ptr(out, ms);
  key = #protect(key, ms);
  keylen = #protect(keylen, ms);
  msg = #protect(msg, ms);
  msglen = #protect(msglen, ms);

  out, ms = _hmac_sha512_mem(out, key, keylen, msg, msglen, ms);

  return out;
}

#[ct = "secret × public × public -> secret"]
#[sct = "{ ptr: transient, val: secret } × transient × transient →
         { ptr: transient, val: secret }"]
#[safety =
   { requires = is_mem_init((64u) key, (64u) keylen)
   }
 ]
export fn hmac_sha256_init(reg mut ptr u8[HMAC_SHA256_CTX_BYTES] ctx, reg u64 key keylen)
  -> reg ptr u8[HMAC_SHA256_CTX_BYTES]
{
  reg u64 ms;

  ms = #init_msf();
  ctx = #protect_ptr(ctx, ms);
  key = #protect(key, ms);
  keylen = #protect(keylen, ms);

  ctx, ms = __hmac_sha256_ctx_init(ctx, key, keylen, ms);

  return ctx;
}

#[ct = "secret × public × public -> secret × public"]
#[sct = "{ ptr: transient, val: secret } × transient × transient →
         { ptr: transient, val: secret } × public"]
#[safety =
   { requires = is_arr_init(ctx, 0, HMAC_SHA256_CTX_BYTES) && is_mem_init((64u) in, (64u) inlen)
   }
 ]
export fn hmac_sha256_update(reg mut ptr u8[HMAC_SHA256_CTX_BYTES] ctx, reg u64 in inlen)
  -> reg ptr u8[HMAC_SHA256_CTX_BYTES], reg u64
{
  reg u64 ms expect status;

  ms = #init_msf();
  ctx = #protect_ptr(ctx, ms);
  in = #protect(in, ms);
  inlen = #protect(inlen, ms);

  expect = __sha2_tag(SHA2_FN_HMAC_SHA256);
  ctx[0:SHA256_CTX_BYTES], status, ms =
    _sha256_ctx_update(ctx[0:SHA256_CTX_BYTES], in, inlen, expect, ms);

  return ctx, status;
}

#[ct = "secret × secret -> secret × secret × public"]
#[sct = "{ ptr: transient, val: secret } × { ptr: transient, val: secret } →
         { ptr: transient, val: secret } × { ptr: transient, val: secret } × public"]
#[safety =
   { requires = is_arr_init(ctx, 0, HMAC_SHA256_CTX_BYTES)
   }
 ]
export fn hmac_sha256_final(reg mut ptr u8[HMAC_SHA256_CTX_BYTES] ctx, reg mut ptr u8[32] out)
  -> reg ptr u8[HMAC_SHA256_CTX_BYTES], reg ptr u8[32], reg u64
{
  reg u64 ms status;

  ms = #init_msf();
  ctx = #protect_ptr(ctx, ms);
  out = #protect_ptr(out, ms);

  ctx, out, status, ms = __hmac_sha256_ctx_final(ctx, out, ms);

  return ctx, out, status;
}

#[ct = "secret × public × public -> secret"]
#[sct = "{ ptr: transient, val: secret } × transient × transient →
         { ptr: transient, val: secret }"]
#[safety =
   { requires = is_mem_init((64u) key, (64u) keylen)
   }
 ]
export fn hmac_sha512_init(reg mut ptr u8[HMAC_SHA512_CTX_BYTES] ctx, reg u64 key keylen)
  -> reg ptr u8[HMAC_SHA512_CTX_BYTES]
{
