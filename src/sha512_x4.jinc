/*
 * SPDX-FileCopyrightText: nirapod-sha2 contributors
 * SPDX-FileCopyrightText: nirapod-sha2 contributors
 * SPDX-License-Identifier: Apache-2.0
 *
 * sha512_x4.jinc
 * ==============
 *
 * 4 SHA-512 hashes advanced together, one per lane. The lanes share
 * total and follow the single-way logic of sha512.jinc in lockstep; each
 * computes exactly what sha512.jinc computes on its own message.
 *
 *     __sha512_x4_init          every lane at the SHA-512 initial value
 *     __sha512_x4_from          every lane at one single-way state
 *     _sha512_x4_absorb_lanes   append inlen bytes to every lane, lane k's
 *                               from the pointer in[k]
 *     _sha512_x4_finalize       padding, last compressions, 4 digests
 *     _sha512_x4_lanes          one-shot: the digests of 4 messages
 *
 * Representation, the same in every unit (the multi-way contexts store
 * it as it is):
 *
 *     h      u64[32], H_j of lane k at index 4 j + k
 *     buf    u8[512], lane k's pending block at bytes 128 k .. 128 k + 127
 *     total  bytes absorbed per lane so far
 *
 * Lanes: in is a table of 4 pointers, lane k's message at in[k]. Every
 * pointer loaded from it is protected before it is used as an address.
 * Lanes may point at the same or overlapping memory; they are only read.
 *
 * The compression is _sha512_x4_compress (one block per lane from buf)
 * and _sha512_x4_compress_lanes (whole blocks straight from lane
 * memory) from the Sha512KernelX root.
 *
 * Security: as sha512.jinc. total, lengths, offsets and the lane pointers
 * are public and shared by the lanes.
 */

from HashWord require "word.jinc"
from Hash require "fill.jinc"
from Sha512KernelX require "sha512_x4_compress.jinc"
require "sha512.jinc"

#[safety =
   { res = { h_out }, ensures = is_arr_init(h_out, 0, 256)
   }
 ]
inline fn __sha512_x4_init(reg mut ptr u64[32] h) -> reg ptr u64[32]
{
  reg ptr u64[8] iv;
  reg u64 t;
  inline int j k;

  iv = SHA512_IV;
  for j = 0 to 8 {
    t = iv[j];
    for k = 0 to 4 {
      h[4 * j + k] = t;
    }
  }
  return h;
}

/*
 * Every lane at the single-way state hs, bs: the chaining value and the
 * whole block buffer, pending bytes included, so that the lanes continue
 * a hash whose first bytes they share.
 */
#[safety =
   { requires = is_arr_init(hs, 0, 64) && is_arr_init(bs, 0, 128)
   , res = { h_out, buf_out }
   , ensures = is_arr_init(h_out, 0, 256) && is_arr_init(buf_out, 0, 512)
   }
 ]
inline fn __sha512_x4_from(
  reg mut ptr u64[32] h,
  reg mut ptr u8[512] buf,
  reg const ptr u64[8] hs,
  reg const ptr u8[128] bs
) -> reg ptr u64[32], reg ptr u8[512]
{
  reg u64 x;
  reg u64 t;
  inline int i j k;

  for j = 0 to 8 {
    x = hs[j];
    for k = 0 to 4 {
      h[4 * j + k] = x;
    }
  }
  for i = 0 to 16 {
    t = bs[:u64 i];
    for k = 0 to 4 {
      buf.[:u64 128 * k + 8 * i] = t;
    }
  }
  return h, buf;
}

/*
 * Append inlen bytes to every lane; lane k's bytes are at in[k].
 *
 * The plan of _sha512_absorb_mem, applied to every lane at once: complete
 * the pending blocks, compress whole blocks straight from lane memory,
 * keep the remainder. Afterwards total has grown by inlen and every
 * lane's pending block holds total mod 128 bytes. Any inlen, including 0.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } × public ×
         { ptr: public, val: transient } × public × msf →
         { ptr: public, val: secret } × { ptr: public, val: secret } × public × msf"]
#[safety =
   { requires = is_arr_init(h, 0, 256)
       && is_arr_init(buf, 0, (64u) total % 128)
       && is_arr_init(buf, 128, (64u) total % 128)
       && is_arr_init(buf, 256, (64u) total % 128)
       && is_arr_init(buf, 384, (64u) total % 128)
       && inlen < (64u) 2305843009213693952 && is_arr_init(in, 0, 32)
       && is_mem_init((64u) in[0], (64u) inlen)
       && is_mem_init((64u) in[1], (64u) inlen)
       && is_mem_init((64u) in[2], (64u) inlen)
       && is_mem_init((64u) in[3], (64u) inlen)
   , res = { h_out, buf_out, total_out, ms_out }
   , ensures = is_arr_init(h_out, 0, 256)
       && is_arr_init(buf_out, 0, (64u) total_out % 128)
       && is_arr_init(buf_out, 128, (64u) total_out % 128)
       && is_arr_init(buf_out, 256, (64u) total_out % 128)
       && is_arr_init(buf_out, 384, (64u) total_out % 128)
       && total_out == total + inlen
   }
 ]
fn _sha512_x4_absorb_lanes(
  reg mut ptr u64[32] h,
  reg mut ptr u8[512] buf,
  reg u64 total,
  reg const ptr u64[4] in,
  reg u64 inlen,
  reg u64 ms
) -> reg ptr u64[32], reg ptr u8[512], reg u64, reg u64
{
  reg u64 fill n off p;
  reg bool more full;
  inline int k;

  fill = total;
  fill &= 127;
  total += inlen;

  /*
   * Complete the partly filled blocks; skipped when nothing is pending, so
   * that whole blocks compress straight from lane memory below.
   */

  n = 128;
  n -= fill;
  n = inlen < n ? inlen : n;
  n = fill == 0 ? fill : n;
  for k = 0 to 4 {
    p = in[k];
    p = #protect(p, ms);
    buf[128 * k : 128], ms = __fill128_mem(buf[128 * k : 128], fill, p, n, ms);
  }
  fill += n;
  off = n;

  full = fill == 128;
  if (full) {
    ms = #update_msf(full, ms);
    /*
     * The loop state crosses the compression through the stack and is
     * protected on reload.
     */
    () = #spill(total, in, inlen, off, buf);
    h, ms = _sha512_x4_compress(h, buf, ms);
    () = #unspill(total, in, inlen, off, buf);
    total = #protect(total, ms);
    in = #protect_ptr(in, ms);
    inlen = #protect(inlen, ms);
    off = #protect(off, ms);
    buf = #protect_ptr(buf, ms);
    fill = 0;
  } else {
    ms = #update_msf(!full, ms);
  }

  /*
   * Whole blocks of every lane, in one kernel call made only when there is
   * at least one. fill is 0 whenever a block is compressed here.
   */

  n = inlen;
  n -= off;
  n >>= 7;
  more = n != 0;
  if (more) {
    ms = #update_msf(more, ms);
    () = #spill(total, in, inlen, off, buf);
    h, ms = _sha512_x4_compress_lanes(h, in, off, n, ms);
    () = #unspill(total, in, inlen, off, buf);
    total = #protect(total, ms);
    in = #protect_ptr(in, ms);
    inlen = #protect(inlen, ms);
    off = #protect(off, ms);
    buf = #protect_ptr(buf, ms);
    n = inlen;
    n -= off;
    n >>= 7;
    n <<= 7;
    off += n;
    fill = 0;
  } else {
    ms = #update_msf(!more, ms);
  }

  /* The remainder, inlen - off < 128 bytes, behind the fill pending bytes. */

  n = inlen;
  n -= off;
  for k = 0 to 4 {
    p = in[k];
    p = #protect(p, ms);
    p += off;
    buf[128 * k : 128], ms = __fill128_mem(buf[128 * k : 128], fill, p, n, ms);
  }

  return h, buf, total, ms;
}

/*
 * Padding and output, per lane as _sha512_finalize (FIPS 180-4 sections
 * 5.1.2 and 6.4): pending bytes, 0x80, zeros, and the
 * big-endian bit length 8 * total; an extra block when the pending bytes
 * and 0x80 leave no room for the length. The positions depend only on
 * total, so they are the same in every lane.
 *
 * out receives lane k's H_0 .. H_7 big-endian at bytes 64 k .. 64 k + 63.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } ×
         { ptr: public, val: secret } × public × msf →
         { ptr: public, val: secret } × { ptr: public, val: secret } ×
         { ptr: public, val: secret } × msf"]
#[safety =
   { requires = is_arr_init(h, 0, 256)
       && is_arr_init(buf, 0, (64u) total % 128)
       && is_arr_init(buf, 128, (64u) total % 128)
       && is_arr_init(buf, 256, (64u) total % 128)
       && is_arr_init(buf, 384, (64u) total % 128)
   , res = { out_out, h_out, buf_out, ms_out }
   , ensures = is_arr_init(out_out, 0, 256) && is_arr_init(h_out, 0, 256)
       && is_arr_init(buf_out, 0, 512)
   }
 ]
fn _sha512_x4_finalize(
  reg mut ptr u8[256] out,
  reg mut ptr u64[32] h,
  reg mut ptr u8[512] buf,
  reg u64 total,
  reg u64 ms
) -> reg ptr u8[256], reg ptr u64[32], reg ptr u8[512], reg u64
{
  reg u64 fill at hi t u;
  reg u64 x;
  reg bool two_blocks;
  inline int j k;

  fill = total;
  fill &= 127;

  at = fill;
  t = 0x80;
  for k = 0 to 4 {
    buf[at] = (8u)t;
    at += 128;
  }
  fill += 1;

  two_blocks = fill > 112;
  if (two_blocks) {
    ms = #update_msf(two_blocks, ms);
    hi = 128;
    for k = 0 to 4 {
      buf[128 * k : 128], ms = __zero128(buf[128 * k : 128], fill, hi, ms);
    }

    () = #spill(out, buf, total);
    h, ms = _sha512_x4_compress(h, buf, ms);
    () = #unspill(out, buf, total);
    out = #protect_ptr(out, ms);
    buf = #protect_ptr(buf, ms);
    total = #protect(total, ms);
    fill = 0;
  } else {
    ms = #update_msf(!two_blocks, ms);
  }

  hi = 112;
  for k = 0 to 4 {
    buf[128 * k : 128], ms = __zero128(buf[128 * k : 128], fill, hi, ms);
  }

  t = total;
  t >>= 61;
  t = __bswap64(t);
  u = total;
  u <<= 3;
  u = __bswap64(u);
  for k = 0 to 4 {
    buf.[:u64 128 * k + 112] = t;
    buf.[:u64 128 * k + 120] = u;
  }

  () = #spill(out, buf);
  h, ms = _sha512_x4_compress(h, buf, ms);
  () = #unspill(out, buf);
  out = #protect_ptr(out, ms);
  buf = #protect_ptr(buf, ms);

  for k = 0 to 4 {
    for j = 0 to 8 {
      x = h[4 * j + k];
      x = __bswap64(x);
      out[:u64 8 * k + j] = x;
    }
  }

  return out, h, buf, ms;
}

/*
 * One-shot SHA-512 of 4 messages of len bytes each, lane k's at in[k]:
 * out receives digest k at bytes 64 k .. 64 k + 63 (FIPS 180-4 section
 * 6.4 on each message separately). len < 2^61, so that each bit length
 * fits the length field. out must not overlap any lane.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: transient } × public × msf →
         { ptr: public, val: secret } × msf"]
#[safety =
   { requires = len < (64u) 2305843009213693952 && is_arr_init(in, 0, 32)
       && is_mem_init((64u) in[0], (64u) len)
       && is_mem_init((64u) in[1], (64u) len)
       && is_mem_init((64u) in[2], (64u) len)
       && is_mem_init((64u) in[3], (64u) len)
   , res = { out_out, ms_out }
   , ensures = is_arr_init(out_out, 0, 256)
   }
 ]
fn _sha512_x4_lanes(
  reg mut ptr u8[256] out,
  reg const ptr u64[4] in,
  reg u64 len,
  reg u64 ms
) -> reg ptr u8[256], reg u64
{
  stack u64[32] h;
  stack u8[512] buf_s;
  reg ptr u8[512] buf;
  reg u64 total;

  h = __sha512_x4_init(h);
  buf = buf_s;
  total = 0;

  () = #spill(out);
  h, buf, total, ms = _sha512_x4_absorb_lanes(h, buf, total, in, len, ms);
  () = #unspill(out);
  out = #protect_ptr(out, ms);
  out, h, buf, ms = _sha512_x4_finalize(out, h, buf, total, ms);

  return out, ms;
}
