/*
 * SPDX-FileCopyrightText: nirapod-sha2 contributors
 * SPDX-License-Identifier: Apache-2.0
 *
 * context.jinc
 * ============
 *
 * The caller-held contexts of the incremental interface: a hash or HMAC in
 * progress, stored in memory the caller owns between calls. The C layer
 * passes a context through without reading or writing a byte of it; every
 * access is here.
 *
 * Layout (byte offsets; words little-endian, as Jasmin loads and stores
 * them on both targets):
 *
 *     SHA-224, SHA-256                    112 bytes
 *         0    tag     u64
 *         8    total   u64      bytes absorbed, compressed or pending
 *         16   h       u32[8]   H_0 .. H_7 as in sha256.jinc
 *         48   buf     u8[64]   pending bytes at its start
 *
 *     HMAC-SHA-256                        144 bytes
 *         0 .. 111   the SHA-256 layout, holding the inner hash
 *         112  outer   u32[8]   compress(IV, K0 ^ opad)
 *
 *     SHA-384, SHA-512, SHA-512/224, SHA-512/256    208 bytes
 *         0    tag     u64
 *         8    total   u64
 *         16   h       u64[8]
 *         80   buf     u8[128]
 *
 *     HMAC-SHA-512                        272 bytes
 *         0 .. 207   the SHA-512 layout, holding the inner hash
 *         208  outer   u64[8]
 *
 * h, buf and total are the state of sha256.jinc and sha512.jinc, so the
 * operations below load them into local arrays, run the absorb or
 * finalize function on them, and store the result. The HMAC contexts
 * extend the hash layout, which lets HMAC update reuse the hash update.
 *
 * Tag
 *
 *     tag = 0x3268736e | f << 32 | 1 << 40
 *
 * The low word is the bytes "nsh2". f identifies the function (the
 * SHA2_FN_* values), and bit 40 marks a context that has been initialised
 * and not finalised. Init writes the tag; update and final compare it
 * with the tag of their own function and fail with SHA2_STATUS_STATE,
 * writing nothing, when it differs. A context that final has cleared has
 * tag 0, so update or final after final fails the same way, as does a
 * context of another function. An uninitialised context passes only if
 * its first eight bytes happen to equal the tag, which the API leaves to
 * the caller (nirapod_sha2.h).
 *
 * Length limit
 *
 *     total < 2^61 at every point
 *
 * Every SHA-2 length field holds the bit length 8 * total, and the proofs
 * state their results for messages below 2^61 bytes. Update accepts inlen
 * bytes only when total + inlen < 2^61 and otherwise fails with
 * SHA2_STATUS_LENGTH, writing nothing. For HMAC, total counts the key
 * block as well, so the message is limited to 2^61 - 64 bytes
 * (HMAC-SHA-512: 2^61 - 128).
 *
 * Classification
 *
 *     h, buf, outer, the message and the digest     secret
 *     tag, total                                    public, released below
 *     context and message pointers, inlen           public
 *
 * Results are SHA2_STATUS_* values and public. On every result other than
 * SHA2_STATUS_OK nothing is written: not the context, not the output.
 */

from Hash require "sha256.jinc"
from Hash require "sha512.jinc"
from Hash require "hmac.jinc"

param int SHA256_CTX_BYTES = 112;
param int HMAC_SHA256_CTX_BYTES = 144;
param int SHA512_CTX_BYTES = 208;
param int HMAC_SHA512_CTX_BYTES = 272;

param int SHA2_FN_SHA224 = 1;
param int SHA2_FN_SHA256 = 2;
param int SHA2_FN_SHA384 = 3;
param int SHA2_FN_SHA512 = 4;
param int SHA2_FN_SHA512_224 = 5;
param int SHA2_FN_SHA512_256 = 6;
param int SHA2_FN_HMAC_SHA256 = 7;
param int SHA2_FN_HMAC_SHA512 = 8;

param int SHA2_TAG_BASE = 0x000001003268736e;

param int SHA2_STATUS_OK = 0;
param int SHA2_STATUS_STATE = 1;
param int SHA2_STATUS_LENGTH = 2;

param int SHA2_TOTAL_LIMIT = 0x2000000000000000;

/*
 * The tag of function f, as init writes it. Callers pass a SHA2_FN_*
 * constant, so the value is fixed at compile time.
 */
inline fn __sha2_tag(inline int f) -> reg u64
{
  reg u64 tag;

  tag = SHA2_TAG_BASE + (f << 32);
  return tag;
}

/*
 * Read tag and total from the first 16 bytes of a context.
 *
 * Declassification: context tag and total
 * ---------------------------------------
 *
 * The context is caller memory, so the checker types both loads secret.
 * Neither value depends on message, key or state contents:
 *
 *     tag    one of the SHA2_FN_* tags or 0, fixed by which init, final
 *            and update calls the caller made on this context
 *     total  the key block size for HMAC plus the sum of the lengths
 *            passed to update, all public
 *
 * Releasing them lets update and final branch on the tag check, bound
 * their loops by total, and index buf with total mod block size, which is
 * what sha256.jinc and sha512.jinc require of total. Nothing else of the
 * context is released; h, buf and outer stay secret. If a caller has
 * written its own bytes into the first 16 bytes of a context, those bytes
 * are what is released, and they were the caller's to begin with.
 *
 * A released value is transient under the speculative model, so both are
 * protected with the exact flag before use.
 */
#[safety =
   { requires = is_arr_init(head, 0, 16)
   }
 ]
inline fn __sha2_ctx_open(reg const ptr u8[16] head, reg u64 ms) -> reg u64, reg u64
{
  reg u64 tag total;

  tag = head.[:u64 0];
  total = head.[:u64 8];
  #declassify(tag);
  #declassify(total);
  tag = #protect(tag, ms);
  total = #protect(total, ms);

  return tag, total;
}

/*
 * How many more bytes the context may absorb: 2^61 - total, or 0 when
 * total is not below 2^61. The comparison inlen < room then accepts
 * exactly the updates that keep total < 2^61, and it cannot wrap: room is
 * at most 2^61. Only a context whose total was written by someone other
 * than this file can have total >= 2^61, and then it accepts nothing.
 */
inline fn __sha2_room(reg u64 total) -> reg u64
{
  reg u64 room limit zero;

  limit = SHA2_TOTAL_LIMIT;
  zero = 0;
  room = limit;
  room -= total;
  room = total < limit ? room : zero;

  return room;
}

/*
 * Context loads at the offsets of the layout above, for HMAC final, whose
 * finalize takes its inner and outer states as stack arrays. Update and
 * final of the hashes work on the context in place, through sub-arrays at
 * the same offsets.
 */

#[safety =
   { requires = is_arr_init(ctx, 0, SHA256_CTX_BYTES)
   , res = { h_out, buf_out }
   , ensures = is_arr_init(h_out, 0, 32) && is_arr_init(buf_out, 0, 64)
   }
 ]
inline fn __sha256_ctx_load(
  reg mut ptr u32[8] h,
  reg mut ptr u8[64] buf,
  reg const ptr u8[SHA256_CTX_BYTES] ctx
) -> reg ptr u32[8], reg ptr u8[64]
{
  reg u32 x;
  reg u64 t;
  inline int i;

  for i = 0 to 8 {
    x = ctx.[:u32 16 + 4 * i];
    h[i] = x;
  }
  for i = 0 to 8 {
    t = ctx.[:u64 48 + 8 * i];
    buf.[:u64 8 * i] = t;
  }

  return h, buf;
}

#[safety =
   { requires = is_arr_init(ctx, 0, SHA512_CTX_BYTES)
   , res = { h_out, buf_out }
   , ensures = is_arr_init(h_out, 0, 64) && is_arr_init(buf_out, 0, 128)
   }
 ]
inline fn __sha512_ctx_load(
  reg mut ptr u64[8] h,
  reg mut ptr u8[128] buf,
  reg const ptr u8[SHA512_CTX_BYTES] ctx
) -> reg ptr u64[8], reg ptr u8[128]
{
  reg u64 t;
  inline int i;

  for i = 0 to 8 {
    t = ctx.[:u64 16 + 8 * i];
    h[i] = t;
  }
  for i = 0 to 16 {
    t = ctx.[:u64 80 + 8 * i];
    buf.[:u64 8 * i] = t;
  }

  return h, buf;
}

/*
 * A new hash context: the tag, total, the chaining value h and a zeroed
 * buf. The buffer's contents are never read before they are written (the
 * state invariant of sha256.jinc); zeroing it gives every byte of the
 * context a defined value, so that the loads of update and final read
 * only bytes this file wrote.
 */
#[safety =
   { requires = is_arr_init(h, 0, 32)
   , res = { ctx_out }
   , ensures = is_arr_init(ctx_out, 0, SHA256_CTX_BYTES)
   }
 ]
inline fn __sha256_ctx_init(
  reg mut ptr u8[SHA256_CTX_BYTES] ctx,
  reg const ptr u32[8] h,
  reg u64 tag total
) -> reg ptr u8[SHA256_CTX_BYTES]
{
  reg u32 x;
  reg u64 z;
  inline int i;

  ctx.[:u64 0] = tag;
  ctx.[:u64 8] = total;
  for i = 0 to 8 {
    x = h[i];
    ctx.[:u32 16 + 4 * i] = x;
  }
  z = 0;
  for i = 0 to 8 {
    ctx.[:u64 48 + 8 * i] = z;
  }

  return ctx;
}

#[safety =
   { requires = is_arr_init(h, 0, 64)
   , res = { ctx_out }
   , ensures = is_arr_init(ctx_out, 0, SHA512_CTX_BYTES)
   }
 ]
inline fn __sha512_ctx_init(
  reg mut ptr u8[SHA512_CTX_BYTES] ctx,
  reg const ptr u64[8] h,
  reg u64 tag total
) -> reg ptr u8[SHA512_CTX_BYTES]
{
  reg u64 t z;
  inline int i;

  ctx.[:u64 0] = tag;
  ctx.[:u64 8] = total;
  for i = 0 to 8 {
    t = h[i];
    ctx.[:u64 16 + 8 * i] = t;
  }
  z = 0;
  for i = 0 to 16 {
    ctx.[:u64 80 + 8 * i] = z;
  }

  return ctx;
}

/*
 * Update: append inlen bytes of memory at in to the hash in ctx.
 *
 *     ctx     SHA256_CTX_BYTES bytes, a context of the function whose tag
 *             is expect; for HMAC-SHA-256 the first 112 bytes of its
 *             context
 *     in      inlen readable bytes; not read when inlen = 0
 *     expect  the tag of the calling function (__sha2_tag)
 *
 * Result SHA2_STATUS_OK: h, buf and total of ctx are those of
 * _sha256_absorb_mem on the stored state; tag is unchanged.
 * SHA2_STATUS_STATE (tag differs) or SHA2_STATUS_LENGTH (total + inlen
 * would reach 2^61): ctx is not written, and only its first 16 bytes are
 * read.
 *
 * in must not overlap ctx. The C layer refuses overlapping buffers.
 */
#[sct = "{ ptr: public, val: secret } × public × public × public × msf →
         { ptr: public, val: secret } × public × msf"]
#[safety =
   { requires = is_arr_init(ctx, 0, SHA256_CTX_BYTES) && is_mem_init((64u) in, (64u) inlen)
   , res = { ctx_out, status, ms_out }
   , ensures = is_arr_init(ctx_out, 0, SHA256_CTX_BYTES)
   }
 ]
fn _sha256_ctx_update(
  reg mut ptr u8[SHA256_CTX_BYTES] ctx,
  reg u64 in inlen expect,
  reg u64 ms
) -> reg ptr u8[SHA256_CTX_BYTES], reg u64, reg u64
{
  reg u64 tag total room status;
  reg bool ok;

  tag, total = __sha2_ctx_open(ctx[0:16], ms);
  status = SHA2_STATUS_STATE;

  ok = tag == expect;
  if (ok) {
    ms = #update_msf(ok, ms);

    room = __sha2_room(total);
    status = SHA2_STATUS_LENGTH;
    ok = inlen < room;
    if (ok) {
      ms = #update_msf(ok, ms);

      ctx[:u32 4 : 8], ctx[48 : 64], total, ms =
        _sha256_absorb_mem(ctx[:u32 4 : 8], ctx[48 : 64], total, in, inlen, ms);
      ctx.[:u64 8] = total;
      status = SHA2_STATUS_OK;
    } else {
      ms = #update_msf(!ok, ms);
    }
  } else {
    ms = #update_msf(!ok, ms);
  }

  return ctx, status, ms;
}

/* The SHA-512 form of _sha256_ctx_update, on 208-byte contexts. */
#[sct = "{ ptr: public, val: secret } × public × public × public × msf →
         { ptr: public, val: secret } × public × msf"]
#[safety =
   { requires = is_arr_init(ctx, 0, SHA512_CTX_BYTES) && is_mem_init((64u) in, (64u) inlen)
   , res = { ctx_out, status, ms_out }
   , ensures = is_arr_init(ctx_out, 0, SHA512_CTX_BYTES)
   }
 ]
fn _sha512_ctx_update(
  reg mut ptr u8[SHA512_CTX_BYTES] ctx,
  reg u64 in inlen expect,
  reg u64 ms
) -> reg ptr u8[SHA512_CTX_BYTES], reg u64, reg u64
{
  reg u64 tag total room status;
  reg bool ok;

  tag, total = __sha2_ctx_open(ctx[0:16], ms);
  status = SHA2_STATUS_STATE;

  ok = tag == expect;
  if (ok) {
    ms = #update_msf(ok, ms);

    room = __sha2_room(total);
    status = SHA2_STATUS_LENGTH;
    ok = inlen < room;
    if (ok) {
      ms = #update_msf(ok, ms);

      ctx[:u64 2 : 8], ctx[80 : 128], total, ms =
        _sha512_absorb_mem(ctx[:u64 2 : 8], ctx[80 : 128], total, in, inlen, ms);
      ctx.[:u64 8] = total;
      status = SHA2_STATUS_OK;
    } else {
      ms = #update_msf(!ok, ms);
    }
  } else {
    ms = #update_msf(!ok, ms);
  }

  return ctx, status, ms;
}

/*
 * Final, one instance per hash function (context_DSIZE.jinc). Each
 * namespace sets the context size and digest length of its function, and
 * __ctx_finalize runs that function's finalize in place on h and buf at
 * the offsets of the layout above. The final of SHA-224 is then
 * _sha224_ctx::_sha2_ctx_final, and so on.
 */
namespace _sha224_ctx {
  param int _CTX = SHA256_CTX_BYTES;
  param int _DSIZE = 28;

  inline fn __ctx_finalize(
    reg mut ptr u8[_CTX] ctx,
    reg mut ptr u8[_DSIZE] digest,
    reg u64 total ms
  ) -> reg ptr u8[_CTX], reg ptr u8[_DSIZE], reg u64
  {
    digest, ctx[:u32 4 : 8], ctx[48 : 64], ms =
      _sha224::_sha256_finalize(digest, ctx[:u32 4 : 8], ctx[48 : 64], total, ms);
    return ctx, digest, ms;
  }

  from Hash require "context_DSIZE.jinc"
}

namespace _sha256_ctx {
  param int _CTX = SHA256_CTX_BYTES;
  param int _DSIZE = 32;

  inline fn __ctx_finalize(
    reg mut ptr u8[_CTX] ctx,
    reg mut ptr u8[_DSIZE] digest,
    reg u64 total ms
  ) -> reg ptr u8[_CTX], reg ptr u8[_DSIZE], reg u64
  {
    digest, ctx[:u32 4 : 8], ctx[48 : 64], ms =
      _sha256::_sha256_finalize(digest, ctx[:u32 4 : 8], ctx[48 : 64], total, ms);
    return ctx, digest, ms;
  }

  from Hash require "context_DSIZE.jinc"
}

namespace _sha384_ctx {
  param int _CTX = SHA512_CTX_BYTES;
  param int _DSIZE = 48;

  inline fn __ctx_finalize(
    reg mut ptr u8[_CTX] ctx,
    reg mut ptr u8[_DSIZE] digest,
    reg u64 total ms
  ) -> reg ptr u8[_CTX], reg ptr u8[_DSIZE], reg u64
  {
    digest, ctx[:u64 2 : 8], ctx[80 : 128], ms =
      _sha384::_sha512_finalize(digest, ctx[:u64 2 : 8], ctx[80 : 128], total, ms);
    return ctx, digest, ms;
  }

  from Hash require "context_DSIZE.jinc"
}

namespace _sha512_ctx {
  param int _CTX = SHA512_CTX_BYTES;
  param int _DSIZE = 64;

  inline fn __ctx_finalize(
    reg mut ptr u8[_CTX] ctx,
    reg mut ptr u8[_DSIZE] digest,
    reg u64 total ms
  ) -> reg ptr u8[_CTX], reg ptr u8[_DSIZE], reg u64
  {
    digest, ctx[:u64 2 : 8], ctx[80 : 128], ms =
      _sha512::_sha512_finalize(digest, ctx[:u64 2 : 8], ctx[80 : 128], total, ms);
    return ctx, digest, ms;
  }

  from Hash require "context_DSIZE.jinc"
}

namespace _sha512_224_ctx {
  param int _CTX = SHA512_CTX_BYTES;
  param int _DSIZE = 28;

  inline fn __ctx_finalize(
    reg mut ptr u8[_CTX] ctx,
    reg mut ptr u8[_DSIZE] digest,
    reg u64 total ms
  ) -> reg ptr u8[_CTX], reg ptr u8[_DSIZE], reg u64
  {
    digest, ctx[:u64 2 : 8], ctx[80 : 128], ms =
      _sha512_224::_sha512_finalize(digest, ctx[:u64 2 : 8], ctx[80 : 128], total, ms);
    return ctx, digest, ms;
  }

  from Hash require "context_DSIZE.jinc"
}

namespace _sha512_256_ctx {
  param int _CTX = SHA512_CTX_BYTES;
  param int _DSIZE = 32;

  inline fn __ctx_finalize(
    reg mut ptr u8[_CTX] ctx,
    reg mut ptr u8[_DSIZE] digest,
    reg u64 total ms
  ) -> reg ptr u8[_CTX], reg ptr u8[_DSIZE], reg u64
  {
    digest, ctx[:u64 2 : 8], ctx[80 : 128], ms =
      _sha512_256::_sha512_finalize(digest, ctx[:u64 2 : 8], ctx[80 : 128], total, ms);
    return ctx, digest, ms;
  }

  from Hash require "context_DSIZE.jinc"
}

/*
 * HMAC init (FIPS 198-1 section 4, steps 1 to 5 and 7 to 8 of the outer
 * prefix): K0 from the key, inner <- compress(IV, K0 ^ ipad) and
 * outer <- compress(IV, K0 ^ opad), stored with total = 64, the block of
 * K0 ^ ipad that inner already covers.
 *
 *     ctx   HMAC_SHA256_CTX_BYTES bytes; every byte is written
 *     key   keylen readable bytes, any length below 2^61; not read when
 *           keylen = 0
 *
 * key must not overlap ctx. K0, the padded key blocks and, for a long
 * key, H(K) stay in this function's frame (README.md, "Residue") until
 * the export's stack clearing removes them.
 */
#[safety =
   { requires = is_mem_init((64u) key, (64u) keylen)
   , res = { ctx_out, ms_out }
   , ensures = is_arr_init(ctx_out, 0, HMAC_SHA256_CTX_BYTES)
   }
 ]
inline fn __hmac_sha256_ctx_init(
  reg mut ptr u8[HMAC_SHA256_CTX_BYTES] ctx,
  reg u64 key keylen,
  reg u64 ms
) -> reg ptr u8[HMAC_SHA256_CTX_BYTES], reg u64
{
  stack u8[64] k0;
  stack u32[8] inner outer;
  reg u64 tag total;
  reg u32 x;
  inline int i;

  () = #spill(ctx);
  k0, ms = _hmac_sha256_keyblock_mem(k0, key, keylen, ms);
  inner, outer, ms = __hmac_sha256_init(inner, outer, k0, ms);
  () = #unspill(ctx);
  ctx = #protect_ptr(ctx, ms);

  tag = __sha2_tag(SHA2_FN_HMAC_SHA256);
  total = 64;
  ctx[0:SHA256_CTX_BYTES] = __sha256_ctx_init(ctx[0:SHA256_CTX_BYTES], inner, tag, total);
  for i = 0 to 8 {
    x = outer[i];
    ctx.[:u32 SHA256_CTX_BYTES + 4 * i] = x;
  }

  return ctx, ms;
}

/* The SHA-512 form of __hmac_sha256_ctx_init: 128-byte blocks, total = 128. */
#[safety =
   { requires = is_mem_init((64u) key, (64u) keylen)
   , res = { ctx_out, ms_out }
   , ensures = is_arr_init(ctx_out, 0, HMAC_SHA512_CTX_BYTES)
   }
 ]
inline fn __hmac_sha512_ctx_init(
  reg mut ptr u8[HMAC_SHA512_CTX_BYTES] ctx,
  reg u64 key keylen,
  reg u64 ms
) -> reg ptr u8[HMAC_SHA512_CTX_BYTES], reg u64
{
  stack u8[128] k0;
  stack u64[8] inner outer;
  reg u64 tag total t;
  inline int i;

  () = #spill(ctx);
  k0, ms = _hmac_sha512_keyblock_mem(k0, key, keylen, ms);
  inner, outer, ms = __hmac_sha512_init(inner, outer, k0, ms);
  () = #unspill(ctx);
  ctx = #protect_ptr(ctx, ms);

  tag = __sha2_tag(SHA2_FN_HMAC_SHA512);
  total = 128;
  ctx[0:SHA512_CTX_BYTES] = __sha512_ctx_init(ctx[0:SHA512_CTX_BYTES], inner, tag, total);
  for i = 0 to 8 {
    t = outer[i];
    ctx.[:u64 SHA512_CTX_BYTES + 8 * i] = t;
  }

  return ctx, ms;
}

/*
 * HMAC final (FIPS 198-1 section 4, step 9): finish the inner hash, hash
 * K0 ^ opad followed by the inner digest from the stored outer state,
 * write the 32-byte tag to out, then clear ctx.
 *
 * Result SHA2_STATUS_OK: out holds HMAC(K, text) and every byte of ctx is
 * zero. SHA2_STATUS_STATE: neither ctx nor out is written, and only the
 * first 16 bytes of ctx are read.
 *
 * out must not overlap ctx. The tag is finished in a local array, as
 * __hmac_sha256_finalize requires, and copied to out; the local inner
 * digest and the copies of the state remain until the export's stack
 * clearing.
 */
#[safety =
   { requires = is_arr_init(ctx, 0, HMAC_SHA256_CTX_BYTES)
   , res = { ctx_out, out_out, status, ms_out }
   , ensures = is_arr_init(ctx_out, 0, HMAC_SHA256_CTX_BYTES)
       && is_arr_init(out_out, 0, status == SHA2_STATUS_OK ? 32 : 0)
   }
 ]
inline fn __hmac_sha256_ctx_final(
  reg mut ptr u8[HMAC_SHA256_CTX_BYTES] ctx,
  reg mut ptr u8[32] out,
  reg u64 ms
) -> reg ptr u8[HMAC_SHA256_CTX_BYTES], reg ptr u8[32], reg u64, reg u64
{
  stack u32[8] inner outer;
  stack u8[64] buf;
  stack u8[32] mac;
  reg u64 tag total expect status t z;
  reg u32 x;
  reg bool ok;
  inline int i;

  tag, total = __sha2_ctx_open(ctx[0:16], ms);
  expect = __sha2_tag(SHA2_FN_HMAC_SHA256);
  status = SHA2_STATUS_STATE;

  ok = tag == expect;
  if (ok) {
    ms = #update_msf(ok, ms);

    inner, buf = __sha256_ctx_load(inner, buf, ctx[0:SHA256_CTX_BYTES]);
    for i = 0 to 8 {
      x = ctx.[:u32 SHA256_CTX_BYTES + 4 * i];
      outer[i] = x;
    }

    () = #spill(ctx, out);
    mac, inner, buf, ms = __hmac_sha256_finalize(mac, inner, buf, total, outer, ms);
    () = #unspill(ctx, out);
    ctx = #protect_ptr(ctx, ms);
    out = #protect_ptr(out, ms);

    for i = 0 to 4 {
      t = mac[:u64 i];
      out[:u64 i] = t;
    }
    z = 0;
    for i = 0 to HMAC_SHA256_CTX_BYTES / 8 {
      ctx.[:u64 8 * i] = z;
    }
    status = SHA2_STATUS_OK;
  } else {
    ms = #update_msf(!ok, ms);
  }

  return ctx, out, status, ms;
}

/* The SHA-512 form of __hmac_sha256_ctx_final, with a 64-byte tag. */
#[safety =
   { requires = is_arr_init(ctx, 0, HMAC_SHA512_CTX_BYTES)
   , res = { ctx_out, out_out, status, ms_out }
   , ensures = is_arr_init(ctx_out, 0, HMAC_SHA512_CTX_BYTES)
       && is_arr_init(out_out, 0, status == SHA2_STATUS_OK ? 64 : 0)
   }
 ]
inline fn __hmac_sha512_ctx_final(
  reg mut ptr u8[HMAC_SHA512_CTX_BYTES] ctx,
  reg mut ptr u8[64] out,
  reg u64 ms
) -> reg ptr u8[HMAC_SHA512_CTX_BYTES], reg ptr u8[64], reg u64, reg u64
{
  stack u64[8] inner outer;
  stack u8[128] buf;
  stack u8[64] mac;
  reg u64 tag total expect status t z;
  reg bool ok;
  inline int i;

  tag, total = __sha2_ctx_open(ctx[0:16], ms);
  expect = __sha2_tag(SHA2_FN_HMAC_SHA512);
  status = SHA2_STATUS_STATE;

  ok = tag == expect;
  if (ok) {
    ms = #update_msf(ok, ms);

    inner, buf = __sha512_ctx_load(inner, buf, ctx[0:SHA512_CTX_BYTES]);
    for i = 0 to 8 {
      t = ctx.[:u64 SHA512_CTX_BYTES + 8 * i];
      outer[i] = t;
    }

    () = #spill(ctx, out);
    mac, inner, buf, ms = __hmac_sha512_finalize(mac, inner, buf, total, outer, ms);
    () = #unspill(ctx, out);
    ctx = #protect_ptr(ctx, ms);
    out = #protect_ptr(out, ms);

    for i = 0 to 8 {
      t = mac[:u64 i];
      out[:u64 i] = t;
    }
    z = 0;
    for i = 0 to HMAC_SHA512_CTX_BYTES / 8 {
      ctx.[:u64 8 * i] = z;
    }
    status = SHA2_STATUS_OK;
  } else {
    ms = #update_msf(!ok, ms);
  }

  return ctx, out, status, ms;
}
