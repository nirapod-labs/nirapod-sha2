/*
 * SPDX-FileCopyrightText: nirapod-sha2 contributors
 * SPDX-License-Identifier: Apache-2.0
 *
 * sha512.jinc
 * ===========
 *
 * SHA-512, SHA-384, SHA-512/224 and SHA-512/256 (FIPS 180-4 sections 5 and
 * 6.4-6.7): one compression function and buffering, four initial values,
 * and truncation of the 64-byte output.
 *
 * Representation:
 *
 *     h      u64[8], H_0 .. H_7 as native words
 *     buf    u8[128], the first (total mod 128) bytes are pending input
 *     total  bytes absorbed so far, compressed or pending
 *
 * The layout and the absorb and finalize logic are those of sha256.jinc
 * with 128-byte blocks; the differences are the 128-bit length field and
 * the big-endian u64 output words. Padding and output are in
 * sha512_DSIZE.jinc, one instance per digest length. The compression
 * function comes from the Sha512Kernel root (sha512_compress.jinc).
 *
 * Security: message, chaining value and digest are secret. Every branch,
 * loop bound and address depends only on total, lengths, pointers and
 * compile-time indices.
 */

from HashWord require "word.jinc"
from Hash require "fill.jinc"
from Sha512Kernel require "sha512_compress.jinc"

/*
 * Initial hash values (FIPS 180-4 section 5.3).
 *
 *     SHA-512      5.3.5    first 64 bits of the fractional parts of the
 *                           square roots of the first eight primes
 *     SHA-384      5.3.4    the same for the ninth to sixteenth primes
 *     SHA-512/t    5.3.6    SHA-512 of the string "SHA-512/t" under the
 *                           SHA-512 IV XORed with 0xa5a5a5a5a5a5a5a5
 *
 * tests/constants/check.py derives all four and compares them with the
 * tables below.
 */
u64[8] SHA512_IV = {
  0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
  0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179
};

u64[8] SHA384_IV = {
  0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939,
  0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4
};

u64[8] SHA512_224_IV = {
  0x8c3d37c819544da2, 0x73e1996689dcd4d6, 0x1dfab7ae32ff9c82, 0x679dd514582f9fcf,
  0x0f6d2b697bd44da8, 0x77e36f7304c48942, 0x3f9d85a86a1d36c8, 0x1112e6ad91d692a1
};

u64[8] SHA512_256_IV = {
  0x22312194fc2bf72c, 0x9f555fa3c84c64c2, 0x2393b86b6f53b151, 0x963877195940eabd,
  0x96283ee2a88effe3, 0xbe5e1e2553863992, 0x2b0199fc2c85b8aa, 0x0eb72ddc81c52ca2
};

#[safety =
   { requires = is_arr_init(iv, 0, 64)
   , res = { h_out }
   , ensures = is_arr_init(h_out, 0, 64)
   }
 ]
inline fn __sha512_load_iv(reg mut ptr u64[8] h, reg const ptr u64[8] iv) -> reg ptr u64[8]
{
  reg u64 t;
  inline int i;

  for i = 0 to 8 {
    t = iv[i];
    h[i] = t;
  }
  return h;
}

#[safety =
   { res = { h_out }, ensures = is_arr_init(h_out, 0, 64)
   }
 ]
inline fn __sha512_init(reg mut ptr u64[8] h) -> reg ptr u64[8]
{
  h = __sha512_load_iv(h, SHA512_IV);
  return h;
}

#[safety =
   { res = { h_out }, ensures = is_arr_init(h_out, 0, 64)
   }
 ]
inline fn __sha384_init(reg mut ptr u64[8] h) -> reg ptr u64[8]
{
  h = __sha512_load_iv(h, SHA384_IV);
  return h;
}

#[safety =
   { res = { h_out }, ensures = is_arr_init(h_out, 0, 64)
   }
 ]
inline fn __sha512_224_init(reg mut ptr u64[8] h) -> reg ptr u64[8]
{
  h = __sha512_load_iv(h, SHA512_224_IV);
  return h;
}

#[safety =
   { res = { h_out }, ensures = is_arr_init(h_out, 0, 64)
   }
 ]
inline fn __sha512_256_init(reg mut ptr u64[8] h) -> reg ptr u64[8]
{
  h = __sha512_load_iv(h, SHA512_256_IV);
  return h;
}

/*
 * Append inlen bytes from memory at in; the structure is that of
 * _sha256_absorb_mem with 128-byte blocks. Afterwards total has grown by
 * inlen and buf holds total mod 128 bytes.
 */
#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } ×
         public × public × public ×
         msf →
         { ptr: public, val: secret } × { ptr: public, val: secret } × public × msf"]
#[safety =
   { requires = is_arr_init(h, 0, 64) && is_arr_init(buf, 0, (64u) total % 128)
       && is_mem_init((64u) in, (64u) inlen)
   , res = { h_out, buf_out, total_out, ms_out }
   , ensures = is_arr_init(h_out, 0, 64)
       && is_arr_init(buf_out, 0, (64u) total_out % 128)
       && total_out == total + inlen
   }
 ]
fn _sha512_absorb_mem(
  reg mut ptr u64[8] h,
  reg mut ptr u8[128] buf,
  reg u64 total in inlen,
  reg u64 ms
) -> reg ptr u64[8], reg ptr u8[128], reg u64, reg u64
{
  reg u64 fill n off;
  reg bool more full;

  fill = total;
  fill &= 127;
  total += inlen;

  /*
   * Complete a partly filled block. When nothing is pending the step is
   * skipped, so that whole blocks compress straight from memory below.
   */

  n = 128;
  n -= fill;
  n = inlen < n ? inlen : n;
  n = fill == 0 ? fill : n;
  inlen -= n;
  buf, ms = __fill128_mem(buf, fill, in, n, ms);
  fill += n;
  in += n;

  full = fill == 128;
  if (full) {
    ms = #update_msf(full, ms);
    /*
     * Values needed after a compression call cross it through the stack. A
     * reloaded value is only transient under the speculative model, so it
     * is protected before it is used as an address, bound or length again.
     */
    () = #spill(total, in, inlen, buf);
    h, ms = _sha512_compress(h, buf, ms);
    () = #unspill(total, in, inlen, buf);
    total = #protect(total, ms);
    in = #protect(in, ms);
    inlen = #protect(inlen, ms);
    buf = #protect_ptr(buf, ms);
    fill = 0;
  } else {
    ms = #update_msf(!full, ms);
  }

  /*
   * Whole blocks straight from memory, in one kernel call made only when
   * there is at least one. Either nothing was pending on entry, or the
   * block above completed, or inlen is now 0, so fill is 0 whenever a
   * block is compressed here. The values needed after the call cross it
   * through the stack and are protected on reload.
   */

  off = 0;
  n = inlen;
  n >>= 7;
  more = n != 0;
  if (more) {
    ms = #update_msf(more, ms);
    () = #spill(total, in, inlen, buf);
    h, ms = _sha512_compress_blocks(h, in, n, ms);
    () = #unspill(total, in, inlen, buf);
    total = #protect(total, ms);
    in = #protect(in, ms);
    inlen = #protect(inlen, ms);
    buf = #protect_ptr(buf, ms);
    off = inlen;
    off >>= 7;
    off <<= 7;
    fill = 0;
  } else {
    ms = #update_msf(!more, ms);
  }

  /*
   * Keep the remainder, inlen - off = inlen mod 128 bytes after the whole
   * blocks, behind the fill pending bytes. It is empty unless fill is 0.
   */

  inlen -= off;
  in += off;
  buf, ms = __fill128_mem(buf, fill, in, inlen, ms);

  return h, buf, total, ms;
}

/*
 * Padding and output, once per digest length (sha512_DSIZE.jinc). The
 * namespace names the function whose digest it writes; its finalize is
 * _sha512::_sha512_finalize, _sha384::_sha512_finalize and so on.
 */
namespace _sha512 {
  param int _DSIZE = 64;
  from Hash require "sha512_DSIZE.jinc"
}

namespace _sha384 {
  param int _DSIZE = 48;
  from Hash require "sha512_DSIZE.jinc"
}

namespace _sha512_224 {
  param int _DSIZE = 28;
  from Hash require "sha512_DSIZE.jinc"
}

namespace _sha512_256 {
  param int _DSIZE = 32;
  from Hash require "sha512_DSIZE.jinc"
}

#[sct = "{ ptr: public, val: secret } × public × public × msf →
         { ptr: public, val: secret } × msf"]
#[safety =
   { requires = is_mem_init((64u) in, (64u) inlen)
   , res = { out_out, ms_out }
   , ensures = is_arr_init(out_out, 0, 64)
   }
 ]
fn _sha512_mem(reg mut ptr u8[64] out, reg u64 in inlen, reg u64 ms) -> reg ptr u8[64], reg u64
{
  stack u64[8] h;

  h = __sha512_init(h);
  out, ms = _sha512::__sha512_mem_from(out, h, in, inlen, ms);

  return out, ms;
}

#[sct = "{ ptr: public, val: secret } × public × public × msf →
         { ptr: public, val: secret } × msf"]
#[safety =
   { requires = is_mem_init((64u) in, (64u) inlen)
   , res = { out_out, ms_out }
   , ensures = is_arr_init(out_out, 0, 48)
   }
 ]
fn _sha384_mem(reg mut ptr u8[48] out, reg u64 in inlen, reg u64 ms) -> reg ptr u8[48], reg u64
{
  stack u64[8] h;

  h = __sha384_init(h);
  out, ms = _sha384::__sha512_mem_from(out, h, in, inlen, ms);

  return out, ms;
}

#[sct = "{ ptr: public, val: secret } × public × public × msf →
         { ptr: public, val: secret } × msf"]
#[safety =
   { requires = is_mem_init((64u) in, (64u) inlen)
   , res = { out_out, ms_out }
   , ensures = is_arr_init(out_out, 0, 28)
   }
 ]
fn _sha512_224_mem(reg mut ptr u8[28] out, reg u64 in inlen, reg u64 ms) -> reg ptr u8[28], reg u64
{
  stack u64[8] h;

  h = __sha512_224_init(h);
  out, ms = _sha512_224::__sha512_mem_from(out, h, in, inlen, ms);

  return out, ms;
}

#[sct = "{ ptr: public, val: secret } × public × public × msf →
         { ptr: public, val: secret } × msf"]
#[safety =
   { requires = is_mem_init((64u) in, (64u) inlen)
   , res = { out_out, ms_out }
   , ensures = is_arr_init(out_out, 0, 32)
   }
 ]
fn _sha512_256_mem(reg mut ptr u8[32] out, reg u64 in inlen, reg u64 ms) -> reg ptr u8[32], reg u64
{
  stack u64[8] h;

  h = __sha512_256_init(h);
  out, ms = _sha512_256::__sha512_mem_from(out, h, in, inlen, ms);

  return out, ms;
}
