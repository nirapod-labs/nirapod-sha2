/*
 * SPDX-FileCopyrightText: nirapod-sha2 contributors
 * SPDX-License-Identifier: Apache-2.0
 *
 * sha256_x8_ASIZE.jinc
 * ====================
 *
 * 8-way SHA-256 input from a byte array: _sha256_x8_absorb_array, the
 * array form of _sha256_x8_absorb_lanes in sha256_x8.jinc. Instance file,
 * included as sha256_ASIZE.jinc is, with sha256_x8.jinc required at top level.
 *
 * The lanes are slices of one array a of _ASIZE bytes: lane k takes the
 * len bytes at off + k stride. With stride the size of one message the
 * lanes are messages stored one after another; with stride 0 every lane
 * hashes the same bytes; stride may be smaller than len, so lanes may
 * overlap. One array and a stride keep the arguments in registers, where
 * 8 separate arrays besides the state would not fit those of x86-64.
 * Lane k's result is that of _sha256_absorb_array on its slice.
 *
 *     _sha256_x8_absorb_array(h, buf, total, a, off, stride, len, ms)
 *
 * appends them to the state of sha256_x8.jinc, which _sha256_x8_finalize
 * then finishes.
 *
 * Security: as sha256_ASIZE.jinc; stride is public as well.
 */

from Hash require "fill_ASIZE.jinc"

#[sct = "{ ptr: public, val: secret } × { ptr: public, val: secret } × public ×
         { ptr: public, val: secret } × public × public × public × msf →
         { ptr: public, val: secret } × { ptr: public, val: secret } × public × msf"]
#[safety =
   { requires = is_arr_init(h, 0, 256)
       && is_arr_init(buf, 0, (64u) total % 64)
       && is_arr_init(buf, 64, (64u) total % 64)
       && is_arr_init(buf, 128, (64u) total % 64)
       && is_arr_init(buf, 192, (64u) total % 64)
       && is_arr_init(buf, 256, (64u) total % 64)
       && is_arr_init(buf, 320, (64u) total % 64)
       && is_arr_init(buf, 384, (64u) total % 64)
       && is_arr_init(buf, 448, (64u) total % 64)
       && (64u) off <= _ASIZE && (64u) stride <= _ASIZE && (64u) len <= _ASIZE
       && (64u) off + 7 * (64u) stride + (64u) len <= _ASIZE
       && is_arr_init(a, (64u) off + 0 * (64u) stride, (64u) len)
       && is_arr_init(a, (64u) off + 1 * (64u) stride, (64u) len)
       && is_arr_init(a, (64u) off + 2 * (64u) stride, (64u) len)
       && is_arr_init(a, (64u) off + 3 * (64u) stride, (64u) len)
       && is_arr_init(a, (64u) off + 4 * (64u) stride, (64u) len)
       && is_arr_init(a, (64u) off + 5 * (64u) stride, (64u) len)
       && is_arr_init(a, (64u) off + 6 * (64u) stride, (64u) len)
       && is_arr_init(a, (64u) off + 7 * (64u) stride, (64u) len)
   , res = { h_out, buf_out, total_out, ms_out }
   , ensures = is_arr_init(h_out, 0, 256)
       && is_arr_init(buf_out, 0, (64u) total_out % 64)
       && is_arr_init(buf_out, 64, (64u) total_out % 64)
       && is_arr_init(buf_out, 128, (64u) total_out % 64)
       && is_arr_init(buf_out, 192, (64u) total_out % 64)
       && is_arr_init(buf_out, 256, (64u) total_out % 64)
       && is_arr_init(buf_out, 320, (64u) total_out % 64)
       && is_arr_init(buf_out, 384, (64u) total_out % 64)
       && is_arr_init(buf_out, 448, (64u) total_out % 64)
       && total_out == total + len
   }
 ]
fn _sha256_x8_absorb_array(
  reg mut ptr u32[64] h,
  reg mut ptr u8[512] buf,
  reg u64 total,
  reg const ptr u8[_ASIZE] a,
  reg u64 off stride len,
  reg u64 ms
) -> reg ptr u32[64], reg ptr u8[512], reg u64, reg u64
{
  reg u64 fill n src;
  reg bool more full;
  inline int k;

  fill = total;
  fill &= 63;
  total += len;

  /*
   * h and total wait on the stack while the lanes are filled, which keeps
   * the fill within the registers of x86-64. Reloaded values are protected
   * before they are used again.
   */
  () = #spill(h, total);

  /* Invariant: every lane holds fill < 64 pending bytes at each top. */

  while { more = len != 0; } (more) {
    ms = #update_msf(more, ms);

    n = 64;
    n -= fill;
    n = len < n ? len : n;
    src = off;
    for k = 0 to 8 {
      buf[64 * k : 64], ms = __fill64_array(buf[64 * k : 64], fill, a, src, n, ms);
      src += stride;
    }
    fill += n;
    off += n;
    len -= n;

    full = fill == 64;
    if (full) {
      ms = #update_msf(full, ms);
      () = #unspill(h);
      h = #protect_ptr(h, ms);
      () = #spill(a, off, stride, len, buf);
      h, ms = _sha256_x8_compress(h, buf, ms);
      () = #unspill(a, off, stride, len, buf);
      () = #spill(h);
      a = #protect_ptr(a, ms);
      off = #protect(off, ms);
      stride = #protect(stride, ms);
      len = #protect(len, ms);
      buf = #protect_ptr(buf, ms);
      fill = 0;
    } else {
      ms = #update_msf(!full, ms);
    }
  }
  ms = #update_msf(!more, ms);

  () = #unspill(h, total);
  h = #protect_ptr(h, ms);
  total = #protect(total, ms);

  return h, buf, total, ms;
}
