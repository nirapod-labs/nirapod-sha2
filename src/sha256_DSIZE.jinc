/*
 * SPDX-FileCopyrightText: nirapod-sha2 contributors
 * SPDX-FileCopyrightText: nirapod-sha2 contributors
 * SPDX-License-Identifier: Apache-2.0
 *
 * sha256_DSIZE.jinc
 * =================
 *
 * Padding and output of SHA-256 and SHA-224 for a digest of _DSIZE bytes.
 * Instance file: sha256.jinc requires it once per function, inside a
 * namespace that sets param int _DSIZE:
 *
 *     namespace   _DSIZE   digest        FIPS 180-4
 *     _sha256     32       H_0 .. H_7    section 6.2.2
 *     _sha224     28       H_0 .. H_6    section 6.3
 *
 * SHA-224 is SHA-256 with its own initial value whose final hash value is
 * truncated to its left-most 224 bits (section 6.3). Writing exactly
 * _DSIZE bytes here means a truncated digest needs no copy, and the bytes
 * of the chaining value that section 6.3 drops never reach the caller's
 * output.
 *
 *     _sha256_finalize     padding, last compressions, big-endian digest
 *     __sha256_mem_from    one-shot hashing from a loaded initial value
 *
 * Security: as sha256.jinc. _DSIZE is a compile-time constant, so the
 * output loop has a fixed trip count and fixed offsets.
 */

/*
 * Padding and output (FIPS 180-4 sections 5.1.1 and 6.2.2).
 *
 * The padded tail is the pending bytes, 0x80, zeros, and the 64-bit
 * big-endian bit length 8 * total. When the pending bytes and 0x80 leave
 * fewer than 8 bytes in the block (fill > 56), the length goes into an
 * extra block of zeros.
 *
 * out receives the first _DSIZE / 4 words H_0, H_1, .. big-endian. h and
 * buf keep final-state data afterwards and need re-initialisation before
 * reuse.
 *
 * out may be transient on entry. It is not used as an address until it
 * has crossed the last compression through the stack and been protected,
 * together with buf, so a caller that reloaded it need not protect it
 * first.
 */
/* Safety: h is initialised and buf holds total mod 64 pending bytes. */
#[safety =
   { requires = is_arr_init(h, 0, 32) && is_arr_init(buf, 0, (64u) total % 64)
   , res = { out_out, h_out, buf_out, ms_out }
   , ensures = is_arr_init(out_out, 0, _DSIZE) && is_arr_init(h_out, 0, 32)
       && is_arr_init(buf_out, 0, 64)
   }
 ]
#[sct = "{ ptr: transient, val: secret } × { ptr: public, val: secret } ×
         { ptr: public, val: secret } × public × msf →
         { ptr: public, val: secret } × { ptr: public, val: secret } ×
         { ptr: public, val: secret } × msf"]
fn _sha256_finalize(
  reg mut ptr u8[_DSIZE] out,
  reg mut ptr u32[8] h,
  reg mut ptr u8[64] buf,
  reg u64 total,
  reg u64 ms
) -> reg ptr u8[_DSIZE], reg ptr u32[8], reg ptr u8[64], reg u64
{
  reg u64 fill hi t;
  reg u32 x;
  reg bool two_blocks;
  inline int i;

  fill = total;
  fill &= 63;

  t = 0x80;
  buf[fill] = (8u)t;
  fill += 1;

  two_blocks = fill > 56;
  if (two_blocks) {
    ms = #update_msf(two_blocks, ms);
    hi = 64;
    buf, ms = __zero64(buf, fill, hi, ms);

    () = #spill(out, buf, total);
    h, ms = _sha256_compress(h, buf, ms);
    () = #unspill(out, buf, total);
    out = #protect_ptr(out, ms);
    buf = #protect_ptr(buf, ms);
    total = #protect(total, ms);
    fill = 0;
  } else {
    ms = #update_msf(!two_blocks, ms);
  }

  hi = 56;
  buf, ms = __zero64(buf, fill, hi, ms);

  t = total;
  t <<= 3;
  t = __bswap64(t);
  buf.[:u64 56] = t;

  () = #spill(out, buf);
  h, ms = _sha256_compress(h, buf, ms);
  () = #unspill(out, buf);
  out = #protect_ptr(out, ms);
  buf = #protect_ptr(buf, ms);

  for i = 0 to _DSIZE / 4 {
    x = h[i];
    x = __bswap32(x);
    out[:u32 i] = x;
  }

  return out, h, buf, ms;
}

#[safety =
   { requires = is_arr_init(h, 0, 32) && is_mem_init((64u) in, (64u) inlen)
   , res = { out_out, ms_out }
   , ensures = is_arr_init(out_out, 0, _DSIZE)
   }
 ]
inline fn __sha256_mem_from(
  reg mut ptr u8[_DSIZE] out,
  reg mut ptr u32[8] h,
  reg u64 in inlen,
  reg u64 ms
) -> reg ptr u8[_DSIZE], reg u64
{
  stack u8[64] buf_s;
  reg ptr u8[64] buf;
  reg u64 total;

  buf = buf_s;
  total = 0;
  /*
   * out is live across the absorb call and crosses it through the stack.
   * It comes back transient and goes to finalize as it is: finalize
   * moves it through the stack again before its last compression and
   * protects it there, before any use as an address.
   */
  () = #spill(out);
  h, buf, total, ms = _sha256_absorb_mem(h, buf, total, in, inlen, ms);
  () = #unspill(out);
  out, h, buf, ms = _sha256_finalize(out, h, buf, total, ms);

  return out, ms;
}
